## ============================================================
## .gitignore — Proyecto Vittal
## Stack: .NET 8 + Supabase + VS Code
## ============================================================

# ── .NET Build Outputs ───────────────────────────────────────
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.rsuser

# ── Secrets — NUNCA subir al repositorio ─────────────────────
appsettings.Development.json
appsettings.Production.json
appsettings.*.json
!appsettings.json
*.http
!*.http.example
*.pfx
*.p12
secrets.json
.env
.env.*
*.local.json

# ── Supabase Local ────────────────────────────────────────────
supabase/.temp/
supabase/.branches/
**/supabase/functions/.cache/

# ── VS Code ───────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ── NuGet ─────────────────────────────────────────────────────
*.nupkg
*.snupkg
.nuget/packages/
packages/

# ── Test Results ──────────────────────────────────────────────
TestResults/
coverage/
*.coverage
*.coveragexml

# ── OS Generated ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
logs-*.txt

# ── Documentación / Skills / Config IA ────────────────────────
/docs/
/skills/
.opencode/
AGENTS.md
CLAUDE.md
