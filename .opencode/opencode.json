{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "qwen2.5-coder:3b"
        }
      }
    }
  },
  "mcp": {
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@0.3.1",
        "--access-token",
        "{env:SUPABASE_ACCESS_TOKEN}"
      ],
      "enabled": true
    },
    "n8n": {
      "type": "local",
      "command": [
        "n8n-mcp"
      ],
      "environment": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "{env:N8N_API_URL}",
        "N8N_API_KEY": "{env:N8N_API_KEY}"
      },
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PAT}"
      },
      "enabled": true
    }
  },
  "tools": {
    "supabase*": true,
    "n8n*": true,
    "github*": true
  },
  "agent": {
    "pm": {
      "description": "Orquestador principal (@PM) - Director de Proyecto Vittal",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "prompt": "{file:ORCHESTRATOR.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "webfetch": true,
        "supabase*": true,
        "n8n*": true,
        "github*": true
      },
      "permission": {
        "task": {
          "*": "allow",
          "general": "allow",
          "explore": "allow"
        }
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md"
  ]
}