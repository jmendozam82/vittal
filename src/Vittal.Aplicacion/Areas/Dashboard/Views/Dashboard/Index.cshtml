@{
    ViewData["Title"] = "Dashboard";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item active'>Dashboard</li>";

    var fechaHoy = ViewBag.FechaHoy as string ?? DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-MX"));
    var nombreUsuario = ViewBag.NombreUsuario as string ?? "Usuario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/vittal-dashboard.css" asp-append-version="true" />
}

<!-- ── Header ──────────────────────────────────────────────────── -->
<div class="dashboard-header">
    <div>
        <h1><i class="bi bi-grid-fill text-primary me-2"></i>Dashboard</h1>
        <span class="dashboard-date">
            <i class="bi bi-calendar3 me-1"></i>@fechaHoy
        </span>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="input-group input-group-sm" style="max-width:280px;">
            <span class="input-group-text"><i class="bi bi-calendar-week"></i></span>
            <input type="date" id="filtroFecha" class="form-control" title="Filtrar KPIs y gráfico por fecha" />
            <button class="btn btn-outline-secondary" type="button" id="btnHoy" title="Volver al día actual">
                <i class="bi bi-house me-1"></i>Hoy
            </button>
        </div>
        <button class="btn btn-outline-primary btn-sm" id="btnRefrescar" title="Refrescar datos">
            <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
        </button>
        <span class="badge bg-light text-muted" id="contadorPacientes">
            <i class="bi bi-people me-1"></i><span id="kpiPacientesCount">—</span>
        </span>
        <span class="badge bg-secondary d-none" id="fechaFiltroBadge"></span>
    </div>
</div>

<!-- ── KPIs ────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4" id="kpiContainer">
    <div class="col-6 col-md-3">
        <div class="kpi-card skeleton-pulse" style="height:130px;"></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card skeleton-pulse" style="height:130px;"></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card skeleton-pulse" style="height:130px;"></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card skeleton-pulse" style="height:130px;"></div>
    </div>
</div>

<!-- ── Gráficos centrales: Citas por Hora + Citas por Médico ─────── -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="vittal-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-bar-chart-fill text-primary me-2"></i>Citas por Hora del Día
                </h5>
                <span class="badge bg-primary-light text-primary" id="totalCitasDia">0 citas</span>
            </div>
            <div class="chart-container">
                <canvas id="chartCitasPorHora"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="vittal-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-clipboard2-pulse-fill text-primary me-2"></i>Citas por Médico
                </h5>
                <span class="badge bg-primary-light text-primary" id="totalCitasMedico">0 médicos</span>
            </div>
            <div class="chart-container">
                <canvas id="chartCitasPorMedico"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ── Pacientes del día (tabla rápida) ────────────────────────── -->
<div class="vittal-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0 fw-semibold">
            <i class="bi bi-people-fill text-primary me-2"></i>Resumen del Día
            <span class="badge bg-primary-light text-primary ms-2 align-middle">siempre hoy</span>
        </h5>
    </div>
    <div id="resumenContainer">
        <div class="d-flex justify-content-center p-4">
            <div class="vittal-spinner" style="border-top-color:var(--vittal-primary);border:3px solid var(--vittal-border);"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        (function() {
            'use strict';

            let chartInstance = null;
            let chartMedicoInstance = null;
            let pollingInterval = null;
            let fechaFiltro = '';

            const DOM = {
                kpiContainer: document.getElementById('kpiContainer'),
                resumenContainer: document.getElementById('resumenContainer'),
                totalCitasDia: document.getElementById('totalCitasDia'),
                totalCitasMedico: document.getElementById('totalCitasMedico'),
                btnRefrescar: document.getElementById('btnRefrescar'),
                kpiPacientesCount: document.getElementById('kpiPacientesCount'),
                filtroFecha: document.getElementById('filtroFecha'),
                btnHoy: document.getElementById('btnHoy'),
                fechaFiltroBadge: document.getElementById('fechaFiltroBadge')
            };

            document.addEventListener('DOMContentLoaded', function() {
                DOM.filtroFecha.value = hoyStr();
                fechaFiltro = '';

                DOM.filtroFecha.addEventListener('change', function() {
                    fechaFiltro = DOM.filtroFecha.value;
                    cargarDashboard();
                });

                DOM.btnHoy.addEventListener('click', function() {
                    fechaFiltro = '';
                    DOM.filtroFecha.value = hoyStr();
                    cargarDashboard();
                });

                cargarDashboard();
                iniciarPolling();

                DOM.btnRefrescar.addEventListener('click', function() {
                    const icon = this.querySelector('i');
                    icon.classList.add('spinner-border', 'spinner-border-sm');
                    icon.classList.remove('bi-arrow-clockwise');
                    cargarDashboard().finally(function() {
                        icon.classList.remove('spinner-border', 'spinner-border-sm');
                        icon.classList.add('bi-arrow-clockwise');
                    });
                });
            });

            function iniciarPolling() {
                if (pollingInterval) clearInterval(pollingInterval);
                pollingInterval = setInterval(cargarDashboard, 30000);
            }

            async function cargarDashboard() {
                // ── Fase 1: Fetch + validación de respuesta ──
                let data = null;
                try {
                    const query = fechaFiltro ? '?fecha=' + encodeURIComponent(fechaFiltro) : '';
                    const res = await fetch('@Url.Action("JsonDashboardData")' + query, {
                        method: 'GET',
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });

                    // Sesión expirada o error del servidor
                    if (res.redirected || !res.ok) {
                        console.warn('Dashboard: sesión expirada o respuesta no exitosa (' + res.status + '). Redirigiendo a login.');
                        window.location.href = '@Url.Action("Login", "Auth", new { area = "Login" })';
                        return;
                    }

                    const contentType = res.headers.get('content-type') || '';
                    if (!contentType.includes('application/json')) {
                        console.warn('Dashboard: respuesta no es JSON (' + contentType + '). Redirigiendo a login.');
                        window.location.href = '@Url.Action("Login", "Auth", new { area = "Login" })';
                        return;
                    }

                    let json;
                    try {
                        json = await res.json();
                    } catch (parseErr) {
                        console.error('Dashboard: respuesta JSON inválida:', parseErr);
                        mostrarError('Respuesta inválida del servidor.');
                        return;
                    }

                    if (!json.success) {
                        mostrarError(json.message || 'Error al cargar datos del dashboard.');
                        return;
                    }

                    data = json.data || {};

                } catch (fetchErr) {
                    // Solo errores de red / fetch: sí son "Error de conexión"
                    console.error('Dashboard: error de conexión:', fetchErr);
                    mostrarError('Error de conexión al cargar el dashboard.');
                    return;
                }

                // ── Fase 2: Rendering (try-catch separado para NO mezclar con errores de red) ──
                try {
                    renderizarKPIs(data);
                } catch (e) { console.error('Dashboard: error en renderizarKPIs:', e); }

                try {
                    renderizarGrafico(data.citasPorHora || []);
                } catch (e) { console.error('Dashboard: error en renderizarGrafico:', e); }

                try {
                    renderizarGraficoCitasPorMedico(data.citasPorMedico || []);
                } catch (e) { console.error('Dashboard: error en renderizarGraficoCitasPorMedico:', e); }

                // El resumen del día (inferior) SIEMPRE muestra el día actual, sin aplicar el filtro.
                // Si hay filtro con otra fecha, se hace una segunda carga dedicada a HOY.
                try {
                    if (fechaFiltro && fechaFiltro !== hoyStr()) {
                        cargarResumenDiaActual();
                    } else {
                        renderizarResumen(data);
                    }
                } catch (e) { console.error('Dashboard: error en resumen del día:', e); }

                // Indicador visual cuando el filtro no es hoy
                if (fechaFiltro && fechaFiltro !== hoyStr()) {
                    DOM.fechaFiltroBadge.textContent = 'Mostrando: ' + fechaFiltro.split('-').reverse().join('/');
                    DOM.fechaFiltroBadge.classList.remove('d-none');
                } else {
                    DOM.fechaFiltroBadge.classList.add('d-none');
                }
            }

            // ── Helpers de fecha (siempre LOCAL, no UTC) ──
            function hoyStr() {
                const h = new Date();
                return h.getFullYear() + '-' + String(h.getMonth() + 1).padStart(2, '0') + '-' + String(h.getDate()).padStart(2, '0');
            }

            // ── Carga dedicada del resumen del DÍA ACTUAL (sin filtro) ──
            async function cargarResumenDiaActual() {
                try {
                    const res = await fetch('@Url.Action("JsonDashboardData")', {
                        method: 'GET',
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!res.ok) return;
                    const json = await res.json();
                    if (json.success && json.data) {
                        renderizarResumen(json.data);
                    }
                } catch (e) {
                    console.error('Dashboard: error en resumen del día actual:', e);
                }
            }

            function renderizarKPIs(data) {
                const kpis = [
                    {
                        label: 'Pacientes Hoy',
                        value: data.pacientesDelDia ?? 0,
                        icon: 'bi-people',
                        color: 'primary',
                        bg: 'var(--vittal-primary-light)',
                        trend: 'stable',
                        trendText: 'Conteo del día'
                    },
                    {
                        label: 'Citas Pendientes',
                        value: data.citasPendientes ?? 0,
                        icon: 'bi-clock',
                        color: 'warning',
                        bg: '#FFF8E7',
                        trend: data.citasPendientes > 10 ? 'up' : 'stable',
                        trendText: data.citasPendientes > 10 ? 'Alta demanda' : 'Normal'
                    },
                    {
                        label: 'En Espera',
                        value: data.pacientesEnEspera ?? 0,
                        icon: 'bi-hourglass',
                        color: 'info',
                        bg: '#E8F4FD',
                        trend: data.pacientesEnEspera > 5 ? 'up' : 'down',
                        trendText: data.pacientesEnEspera > 5 ? 'Congestión' : 'Fluido'
                    },
                    {
                        label: 'Tiempo Promedio',
                        value: Math.round(data.tiempoPromedioEspera ?? 0) + ' min',
                        icon: 'bi-speedometer2',
                        color: 'success',
                        bg: '#E8F8F0',
                        trend: Math.round(data.tiempoPromedioEspera ?? 0) < 15 ? 'down' : 'up',
                        trendText: Math.round(data.tiempoPromedioEspera ?? 0) < 15 ? 'Óptimo' : 'Elevado'
                    }
                ];

                if (DOM.kpiPacientesCount) {
                    DOM.kpiPacientesCount.textContent = data.pacientesDelDia ?? 0;
                }

                DOM.kpiContainer.innerHTML = kpis.map(function(kpi) {
                    const trendClass = kpi.trend === 'up' ? 'up' : kpi.trend === 'down' ? 'down' : 'stable';
                    const trendIcon = kpi.trend === 'up' ? 'bi-arrow-up' : kpi.trend === 'down' ? 'bi-arrow-down' : 'bi-dash';
                    return `
                        <div class="col-6 col-md-3">
                            <div class="kpi-card">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="kpi-icon" style="background:${kpi.bg};color:var(--vittal-${kpi.color})">
                                        <i class="bi ${kpi.icon}"></i>
                                    </div>
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="kpi-value">${escapeHtml(kpi.value)}</div>
                                        <div class="kpi-label">${escapeHtml(kpi.label)}</div>
                                    </div>
                                </div>
                                <div class="kpi-trend ${trendClass}">
                                    <i class="bi ${trendIcon}"></i>
                                    <span>${escapeHtml(kpi.trendText)}</span>
                                </div>
                            </div>
                        </div>`;
                }).join('');
            }

            function renderizarGrafico(datos) {
                var chartWrapper = document.querySelector('.chart-container');
                if (!chartWrapper) return;

                if (!datos || datos.length === 0) {
                    if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
                    chartWrapper.innerHTML =
                        '<div class="empty-state"><i class="bi bi-bar-chart"></i><p class="small">Sin datos de citas para hoy</p></div>';
                    if (DOM.totalCitasDia) DOM.totalCitasDia.textContent = '0 citas';
                    return;
                }

                // Restaurar canvas si fue reemplazado por empty-state previo
                if (!document.getElementById('chartCitasPorHora')) {
                    chartWrapper.innerHTML = '<canvas id="chartCitasPorHora"></canvas>';
                }

                if (DOM.totalCitasDia) {
                    const total = datos.reduce(function(sum, d) { return sum + (d.valor || 0); }, 0);
                    DOM.totalCitasDia.textContent = total + ' cita' + (total !== 1 ? 's' : '');
                }

                var canvas = document.getElementById('chartCitasPorHora');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');

                if (chartInstance) {
                    chartInstance.destroy();
                }

                chartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: datos.map(function(d) { return d.etiqueta || ''; }),
                        datasets: [{
                            label: 'Citas',
                            data: datos.map(function(d) { return d.valor || 0; }),
                            backgroundColor: datos.map(function(_, i) {
                                var palette = ['#4F46E5','#7C3AED','#2563EB','#0891B2','#059669','#D97706','#DC2626','#DB2777','#7C3AED','#4F46E5','#2563EB','#0891B2'];
                                return palette[i % palette.length];
                            }),
                            borderRadius: 6,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1, font: { size: 11 } },
                                grid: { color: 'rgba(0,0,0,0.05)' }
                            },
                            x: {
                                ticks: { font: { size: 10 } },
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            function renderizarGraficoCitasPorMedico(datos) {
                if (!datos || datos.length === 0) {
                    if (chartMedicoInstance) { chartMedicoInstance.destroy(); chartMedicoInstance = null; }
                    if (DOM.totalCitasMedico) DOM.totalCitasMedico.textContent = '0 médicos';
                    return;
                }

                if (DOM.totalCitasMedico) {
                    DOM.totalCitasMedico.textContent = datos.length + ' médico' + (datos.length !== 1 ? 's' : '');
                }

                var canvas = document.getElementById('chartCitasPorMedico');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');

                if (chartMedicoInstance) {
                    chartMedicoInstance.destroy();
                }

                // Barras apiladas por médico: segmento "Atendidas" + segmento "Pendientes"
                const labels = datos.map(function(d) { return d.doctorNombre || '—'; });

                chartMedicoInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Atendidas',
                                data: datos.map(function(d) { return d.atendidas || 0; }),
                                backgroundColor: '#059669',
                                borderRadius: 4,
                                borderSkipped: false
                            },
                            {
                                label: 'Pendientes',
                                data: datos.map(function(d) { return d.pendientes || 0; }),
                                backgroundColor: '#F59E0B',
                                borderRadius: 4,
                                borderSkipped: false
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { usePointStyle: true, font: { size: 11 } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(ctxItem) {
                                        return ctxItem.dataset.label + ': ' + ctxItem.parsed.y + ' cita(s)';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                stacked: true,
                                ticks: { font: { size: 10 }, maxRotation: 45, minRotation: 0 },
                                grid: { display: false }
                            },
                            y: {
                                stacked: true,
                                beginAtZero: true,
                                ticks: { stepSize: 1, font: { size: 11 } },
                                grid: { color: 'rgba(0,0,0,0.05)' }
                            }
                        }
                    }
                });
            }

            function renderizarResumen(data) {
                const pacientes = data.pacientesDelDia ?? 0;
                const pendientes = data.citasPendientes ?? 0;
                const espera = data.pacientesEnEspera ?? 0;
                const tiempo = Math.round(data.tiempoPromedioEspera ?? 0);

                DOM.resumenContainer.innerHTML = `
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="border-start border-4 border-primary ps-3">
                                <div class="text-muted small text-uppercase">Pacientes Hoy</div>
                                <div class="fs-3 fw-bold">${pacientes}</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border-start border-4 border-warning ps-3">
                                <div class="text-muted small text-uppercase">Pendientes</div>
                                <div class="fs-3 fw-bold">${pendientes}</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border-start border-4 border-info ps-3">
                                <div class="text-muted small text-uppercase">En Espera</div>
                                <div class="fs-3 fw-bold">${espera}</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border-start border-4 border-success ps-3">
                                <div class="text-muted small text-uppercase">Tiempo Prom.</div>
                                <div class="fs-3 fw-bold">${tiempo} <small class="fs-6 text-muted fw-normal">min</small></div>
                            </div>
                        </div>
                    </div>`;
            }

            function mostrarError(mensaje) {
                DOM.kpiContainer.innerHTML = `
                    <div class="col-12">
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>${escapeHtml(mensaje)}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    </div>`;
            }

            function escapeHtml(text) {
                if (!text && text !== 0) return '';
                return String(text).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                    .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
            }
        })();
    </script>
}
