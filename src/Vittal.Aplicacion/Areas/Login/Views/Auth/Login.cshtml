@model Vittal.Aplicacion.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutLogin";
}

<style>
    /* Premium Login Styles */
    body {
        background: radial-gradient(circle at top left, #1a2a6c, #112b3c, #0b1a26) !important;
        background-size: cover;
        background-attachment: fixed;
    }

    .login-logo-img {
        filter: drop-shadow(0 4px 15px rgba(0, 0, 0, 0.4)) !important;
    }

    .login-subtitle {
        color: #8da4d0 !important;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        border-radius: 20px;
        padding: 2.5rem;
        color: white;
        animation: fadeIn 0.8s ease-out;
    }

    .glass-card h4 {
        color: white;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    /* Floating labels */
    .form-floating > .form-control {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        border-radius: 12px;
    }
    .form-floating > .form-control:focus {
        background: rgba(255, 255, 255, 0.12);
        border-color: #4facfe;
        box-shadow: 0 0 0 0.25rem rgba(79, 172, 254, 0.25);
        color: white;
    }
    .form-floating > label {
        color: rgba(255, 255, 255, 0.6);
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #4facfe;
    }

    /* Button */
    .btn-glass {
        background: linear-gradient(to right, #4facfe 0%, #00f2fe 100%);
        border: none;
        border-radius: 12px;
        color: white;
        font-weight: 700;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .btn-glass:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0, 242, 254, 0.3);
        color: white;
    }
    
    /* Animations */
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-check-label, .text-muted {
        color: rgba(255, 255, 255, 0.7) !important;
    }
    .text-primary {
        color: #4facfe !important;
    }
</style>

<div class="glass-card">
    <h4 class="text-center mb-4">Bienvenido</h4>
    
    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3 bg-transparent border-danger text-danger" role="alert"></div>
    }
        
        <div class="form-floating mb-3">
            <input asp-for="Email" name="Email" id="Email" class="form-control" placeholder="correo@ejemplo.com" autocomplete="username" />
            <label asp-for="Email">Correo Electrónico</label>
            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
        </div>
        
        <div class="form-floating mb-4">
            <input asp-for="Password" name="Password" id="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
            <label asp-for="Password">Contraseña</label>
            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
        </div>
        
        <div class="mb-4 d-flex justify-content-between align-items-center">
            <div class="form-check">
                <input type="checkbox" name="RememberMe" id="RememberMe" value="true" class="form-check-input" asp-for="RememberMe" />
                <input type="hidden" name="RememberMe" value="false" />
                <label asp-for="RememberMe" class="form-check-label small text-light">Recordarme</label>
            </div>
            <a href="#" class="small text-decoration-none text-primary fw-bold">¿Olvidó su contraseña?</a>
        </div>
        
        <button type="submit" class="btn btn-glass btn-lg w-100 py-3 mt-2">
            INGRESAR
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
