@model Vittal.Aplicacion.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutLogin";
}

<div class="login-card text-center">
    <img src="~/images/vittal-logo.png"
         alt="Vittal - Gestión Clínica Inteligente"
         class="login-card-logo"
         loading="lazy" />

    <h4 class="mb-1">Bienvenido de nuevo</h4>
    <p class="login-card-subtitle">
        Ingresa tus credenciales para acceder a tu cuenta
    </p>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        @if (Context.Request.Query["expired"].ToString() == "1")
        {
            <div class="alert alert-warning py-2 small mb-3" role="alert">
                <i class="bi bi-hourglass-split me-1"></i> Su sesión expiró por inactividad, ingrese nuevamente.
            </div>
        }
        @if (ViewData["LoginError"] is string errorMsg && !string.IsNullOrEmpty(errorMsg))
        {
            <div class="alert alert-danger py-2 small mb-3" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i> @errorMsg
            </div>
        }
        else if (!ViewData.ModelState.IsValid)
        {
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                if (!string.IsNullOrEmpty(error.ErrorMessage))
                {
                    <div class="alert alert-danger py-2 small mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i> @error.ErrorMessage
                    </div>
                }
            }
        }

        <div class="form-floating mb-3 text-start">
            <input asp-for="Email" name="Email" id="Email" class="form-control" placeholder="correo@ejemplo.com" autocomplete="username" />
            <label asp-for="Email">Correo Electrónico</label>
            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="form-floating mb-3 text-start">
            <input asp-for="Password" name="Password" id="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
            <label asp-for="Password">Contraseña</label>
            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="mb-4 d-flex justify-content-between align-items-center">
            <div class="form-check">
                <input type="checkbox" name="RememberMe" id="RememberMe" value="true" class="form-check-input" asp-for="RememberMe" />
                <input type="hidden" name="RememberMe" value="false" />
                <label asp-for="RememberMe" class="form-check-label small">Recordarme</label>
            </div>
            <a asp-action="ForgotPassword" class="small link-login">¿Olvidó su contraseña?</a>
        </div>

        <button type="submit" class="btn btn-login-primary btn-lg w-100 py-3">
            <i class="bi bi-box-arrow-in-right me-2"></i>INGRESAR
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
