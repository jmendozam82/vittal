@model Vittal.Aplicacion.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_LayoutLogin";
}

<div class="login-card text-center">
    <div class="icon-circle mx-auto">
        <i class="bi bi-key"></i>
    </div>
    <h4>Recuperar Contraseña</h4>
    <p class="login-card-subtitle">
        Ingrese el correo electrónico asociado a su cuenta.
        Se notificará al administrador de su clínica para gestionar
        el restablecimiento de su contraseña.
    </p>

    @if (ViewData["SuccessMessage"] is string successMsg && !string.IsNullOrEmpty(successMsg))
    {
        <div class="alert alert-success py-2 small mb-3" role="alert">
            <i class="bi bi-check-circle me-1"></i> @successMsg
        </div>
    }
    else if (!ViewData.ModelState.IsValid)
    {
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            if (!string.IsNullOrEmpty(error.ErrorMessage))
            {
                <div class="alert alert-danger py-2 small mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-1"></i> @error.ErrorMessage
                </div>
            }
        }
    }

    <form asp-action="ForgotPassword" method="post">
        <div class="form-floating mb-4 text-start">
            <input asp-for="Email" name="Email" id="Email" class="form-control" placeholder="correo@ejemplo.com" autocomplete="email" />
            <label asp-for="Email">Correo Electrónico</label>
            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
        </div>

        <button type="submit" class="btn btn-login-primary btn-lg w-100 py-3 mb-3">
            <i class="bi bi-send me-2"></i>ENVIAR SOLICITUD
        </button>

        <a asp-action="Login" class="btn btn-login-secondary btn-lg w-100 py-3">
            <i class="bi bi-arrow-left me-2"></i>Volver al Login
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
