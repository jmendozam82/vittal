@model Vittal.Aplicacion.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_LayoutLogin";
}

<style>
    body {
        background: radial-gradient(circle at top left, #1a2a6c, #112b3c, #0b1a26) !important;
        background-size: cover;
        background-attachment: fixed;
    }

    .login-logo-img {
        filter: drop-shadow(0 4px 15px rgba(0, 0, 0, 0.4)) !important;
    }

    .login-subtitle {
        color: #8da4d0 !important;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        border-radius: 20px;
        padding: 2.5rem;
        color: white;
        animation: fadeIn 0.8s ease-out;
    }

    .glass-card h4 {
        color: white;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .glass-card p {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    /* Floating labels */
    .form-floating > .form-control {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        border-radius: 12px;
    }
    .form-floating > .form-control:focus {
        background: rgba(255, 255, 255, 0.12);
        border-color: #4facfe;
        box-shadow: 0 0 0 0.25rem rgba(79, 172, 254, 0.25);
        color: white;
    }
    .form-floating > label {
        color: rgba(255, 255, 255, 0.6);
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #4facfe;
    }

    /* Button */
    .btn-glass {
        background: linear-gradient(to right, #4facfe 0%, #00f2fe 100%);
        border: none;
        border-radius: 12px;
        color: white;
        font-weight: 700;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .btn-glass:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0, 242, 254, 0.3);
        color: white;
    }

    .btn-back {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        color: rgba(255, 255, 255, 0.8);
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-back:hover {
        background: rgba(255, 255, 255, 0.15);
        color: white;
    }

    /* Animations */
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .text-primary {
        color: #4facfe !important;
    }

    .icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(79, 172, 254, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.5rem;
    }
</style>

<div class="glass-card">
    <div class="icon-circle">
        <i class="bi bi-key text-primary"></i>
    </div>
    <h4 class="text-center mb-2">Recuperar Contraseña</h4>
    <p class="text-center mb-4">
        Ingrese el correo electrónico asociado a su cuenta. 
        Se notificará al administrador de su clínica para gestionar el restablecimiento de su contraseña.
    </p>

    @if (ViewData["SuccessMessage"] is string successMsg && !string.IsNullOrEmpty(successMsg))
    {
        <div class="alert alert-success py-2 small mb-3" role="alert" style="background: rgba(25, 135, 84, 0.2); border-color: rgba(25, 135, 84, 0.3); color: #75e6a2;">
            <i class="bi bi-check-circle me-1"></i> @successMsg
        </div>
    }
    else if (!ViewData.ModelState.IsValid)
    {
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            if (!string.IsNullOrEmpty(error.ErrorMessage))
            {
                <div class="alert alert-danger py-2 small mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-1"></i> @error.ErrorMessage
                </div>
            }
        }
    }

    <form asp-action="ForgotPassword" method="post">
        <div class="form-floating mb-4">
            <input asp-for="Email" name="Email" id="Email" class="form-control" placeholder="correo@ejemplo.com" autocomplete="email" />
            <label asp-for="Email">Correo Electrónico</label>
            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
        </div>

        <button type="submit" class="btn btn-glass btn-lg w-100 py-3 mb-3">
            <i class="bi bi-send me-2"></i>ENVIAR SOLICITUD
        </button>

        <a asp-action="Login" class="btn btn-back btn-lg w-100 py-3">
            <i class="bi bi-arrow-left me-2"></i>Volver al Login
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
