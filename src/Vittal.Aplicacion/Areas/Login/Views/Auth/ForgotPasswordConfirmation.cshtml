@{
    ViewData["Title"] = "Solicitud Enviada";
    Layout = "_LayoutLogin";
}

<div class="login-card text-center">
    <div class="icon-circle-success mx-auto">
        <i class="bi bi-check-lg"></i>
    </div>

    <h4 class="mb-3">Solicitud Recibida</h4>

    <p class="login-card-subtitle">
        Su solicitud de restablecimiento de contraseña ha sido enviada correctamente.
    </p>

    <div class="login-info-box">
        <p>
            <i class="bi bi-info-circle me-1"></i>
            <strong>El administrador de su clínica ha sido notificado</strong> por correo electrónico.
            Por favor contacte al administrador para gestionar el cambio de su contraseña.
        </p>
    </div>

    <p class="small text-muted">
        Si no recibe respuesta en un tiempo prudencial, verifique que el correo
        ingresado sea el correcto o contacte directamente al administrador de su clínica.
    </p>

    <a asp-action="Login" class="btn btn-login-primary btn-lg w-100 py-3 mt-3">
        <i class="bi bi-arrow-left me-2"></i>Volver al Login
    </a>
</div>
