@{

    ViewData["Title"] = "Editar Clínica";

    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/'>Inicio</a></li>" +

                             "<li class='breadcrumb-item'><a href='/Catalogos/Clinica'>Clínicas</a></li>" +

                             "<li class='breadcrumb-item active'>Editar Clínica</li>";

}



<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-3">

        <h5 class="mb-0">

            <i class="bi bi-pencil-square me-2 text-primary"></i>Editar Clínica

        </h5>

    </div>

    <div class="card-body">

        <form id="formClinica" novalidate>

            <input type="hidden" id="clinicaId" value="" />



            <!-- Datos principales -->

            <h6 class="text-primary border-bottom pb-2 mb-3">

                <i class="bi bi-info-circle me-2"></i>Datos Principales

            </h6>



            <div class="row g-3 mb-3">

                <div class="col-md-8">

                    <label for="nombre" class="form-label fw-semibold">Nombre de la Clínica <span class="text-danger">*</span></label>

                    <input type="text" class="form-control" id="nombre" name="nombre"

                           required maxlength="255" minlength="3"

                           placeholder="Ingrese el nombre de la clínica">

                    <div class="invalid-feedback">El nombre es obligatorio (mínimo 3 caracteres).</div>

                </div>

                <div class="col-md-4">

                    <label for="tiempoEsperaMinutos" class="form-label fw-semibold">Tiempo Espera (min) <span class="text-danger">*</span></label>

                    <input type="number" class="form-control" id="tiempoEsperaMinutos" name="tiempoEsperaMinutos"

                           required min="1" max="480" value="30">

                    <div class="form-text small">Tiempo de espera promedio para alertas</div>

                </div>

            </div>



            <!-- Estado (solo lectura para visualización) -->

            <div class="row g-3 mb-3">

                <div class="col-md-3">

                    <label class="form-label fw-semibold">Estado Actual</label>

                    <div id="estadoBadge"></div>

                </div>

            </div>



            <!-- Contacto -->

            <h6 class="text-primary border-bottom pb-2 mb-3 mt-4">

                <i class="bi bi-telephone me-2"></i>Información de Contacto

            </h6>



            <div class="row g-3 mb-3">

                <div class="col-md-4">

                    <label for="telefono" class="form-label fw-semibold">Teléfono</label>

                    <input type="tel" class="form-control" id="telefono" name="telefono"

                           maxlength="20" placeholder="+505 2222-2222">

                </div>

                <div class="col-md-8">

                    <label for="email" class="form-label fw-semibold">Correo Electrónico</label>

                    <input type="email" class="form-control" id="email" name="email"

                           maxlength="255" placeholder="contacto@clinia.com">

                    <div class="invalid-feedback">Ingrese un correo electrónico válido.</div>

                </div>

            </div>



            <div class="row g-3 mb-3">

                <div class="col-md-12">

                    <label for="direccion" class="form-label fw-semibold">Dirección</label>

                    <textarea class="form-control" id="direccion" name="direccion"

                              rows="2" placeholder="Dirección completa de la clínica (opcional)"></textarea>

                </div>

            </div>



            <!-- Logo -->
            <h6 class="text-primary border-bottom pb-2 mb-3 mt-4">
                <i class="bi bi-image me-2"></i>Logo de la Clínica
            </h6>

            <div class="row g-3 mb-3">
                <div class="col-md-12">
                    <div id="logoUploadArea" style="border:2px dashed #dee2e6; border-radius:12px; padding:24px; text-align:center; cursor:pointer; transition:all 0.3s;" onmouseover="this.style.borderColor='#0d6efd'" onmouseout="this.style.borderColor='#dee2e6'">
                        <div id="logoPreviewEmpty">
                            <i class="bi bi-cloud-arrow-up fs-1 text-muted"></i>
                            <p class="mb-1 mt-2 text-muted fw-semibold">Seleccione o arrastre el logo</p>
                            <small class="text-muted">JPEG, PNG o WebP — Máximo 5 MB</small>
                        </div>
                        <div id="logoPreviewContainer" style="display:none;">
                            <img id="logoPreviewImg" src="" alt="Preview" style="max-width:160px; max-height:160px; border-radius:8px; object-fit:contain; border:1px solid #dee2e6;">
                            <p id="logoFileName" class="mb-1 mt-2 text-muted small"></p>
                            <button type="button" class="btn btn-outline-danger btn-sm mt-2" onclick="limpiarLogo()">
                                <i class="bi bi-x-lg me-1"></i>Quitar
                            </button>
                        </div>
                    </div>
                    <input type="file" id="logoFileInput" accept="image/jpeg,image/png,image/webp" style="display:none;">
                    <input type="hidden" id="logoUrl" name="logoUrl">
                    <div id="logoUploadProgress" style="display:none;" class="mt-2">
                        <div class="progress" style="height:6px;">
                            <div id="logoProgressBar" class="progress-bar bg-success" role="progressbar" style="width:0%"></div>
                        </div>
                        <small id="logoUploadStatus" class="text-muted"></small>
                    </div>
                </div>
            </div>

            <!-- Horario de Atención -->
            <h6 class="text-primary border-bottom pb-2 mb-3 mt-4">
                <i class="bi bi-clock me-2"></i>Horario de Atención <span class="text-muted small fw-normal">(Opcional)</span>
            </h6>

            <div class="row g-3 mb-3">
                <div class="col-md-12">
                    <label class="form-label fw-semibold">Días de Atención</label>
                    <div class="d-flex flex-wrap gap-3" id="diasAtencion">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="L" id="diaL">
                            <label class="form-check-label" for="diaL">Lunes</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="M" id="diaM">
                            <label class="form-check-label" for="diaM">Martes</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="MI" id="diaMI">
                            <label class="form-check-label" for="diaMI">Miércoles</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="J" id="diaJ">
                            <label class="form-check-label" for="diaJ">Jueves</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="V" id="diaV">
                            <label class="form-check-label" for="diaV">Viernes</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="S" id="diaS">
                            <label class="form-check-label" for="diaS">Sábado</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="D" id="diaD">
                            <label class="form-check-label" for="diaD">Domingo</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="horarioApertura" class="form-label fw-semibold">Hora de Apertura</label>
                    <input type="time" class="form-control" id="horarioApertura" name="horarioApertura">
                </div>
                <div class="col-md-6">
                    <label for="horarioCierre" class="form-label fw-semibold">Hora de Cierre</label>
                    <input type="time" class="form-control" id="horarioCierre" name="horarioCierre">
                </div>
            </div>

            <div class="alert alert-info small" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                Si configura horario, las citas solo podrán crearse dentro del horario de atención de la clínica.
            </div>



            <!-- Bases de datos externas (opcional) -->

            <h6 class="text-primary border-bottom pb-2 mb-3 mt-4">

                <i class="bi bi-database me-2"></i>Integración con BD Externas <span class="text-muted small fw-normal">(Opcional)</span>

            </h6>



            <div class="row g-3 mb-3">

                <div class="col-md-6">

                    <label for="bdExterna1" class="form-label fw-semibold">Base de Datos Externa 1</label>

                    <input type="text" class="form-control" id="bdExterna1" name="bdExterna1"

                           placeholder="Connection string o identificador">

                </div>

                <div class="col-md-6">

                    <label for="bdExterna2" class="form-label fw-semibold">Base de Datos Externa 2</label>

                    <input type="text" class="form-control" id="bdExterna2" name="bdExterna2"

                           placeholder="Connection string o identificador">

                </div>

            </div>



            <!-- Auditorín -->

            <div class="row g-3 mb-3">

                <div class="col-md-6">

                    <small class="text-muted">

                        <i class="bi bi-calendar3 me-1"></i>

                        Creada: <span id="fechaCreacion" class="fw-semibold"></span>

                    </small>

                </div>

                <div class="col-md-6 text-md-end">

                    <small class="text-muted" id="fechaModificacionContainer" style="display:none;">

                        <i class="bi bi-pencil me-1"></i>

                        Última modificación: <span id="fechaModificacion" class="fw-semibold"></span>

                    </small>

                </div>

            </div>



            <!-- Botones -->

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

                <a href="/Catalogos/Clinica" class="btn btn-outline-secondary">

                    <i class="bi bi-x-lg me-1"></i> Cancelar

                </a>

                <button type="submit" class="btn btn-primary" id="btnGuardar">

                    <i class="bi bi-floppy me-1"></i> Actualizar Clínica

                </button>

            </div>

        </form>

    </div>

</div>



@section Scripts {

<script>

    // ── Logo Upload ──────────────────────────────────────────────

    const logoUploadArea = document.getElementById('logoUploadArea');

    const logoFileInput = document.getElementById('logoFileInput');

    let logoSeleccionado = null;


    logoUploadArea.addEventListener('click', () => logoFileInput.click());

    logoUploadArea.addEventListener('dragover', (e) => { e.preventDefault(); logoUploadArea.style.borderColor = '#0d6efd'; logoUploadArea.style.backgroundColor = '#f0f7ff'; });

    logoUploadArea.addEventListener('dragleave', () => { logoUploadArea.style.borderColor = '#dee2e6'; logoUploadArea.style.backgroundColor = ''; });

    logoUploadArea.addEventListener('drop', (e) => {

        e.preventDefault();

        logoUploadArea.style.borderColor = '#dee2e6';

        logoUploadArea.style.backgroundColor = '';

        const files = e.dataTransfer.files;

        if (files.length > 0) manejarArchivoLogo(files[0]);

    });

    logoFileInput.addEventListener('change', (e) => {

        if (e.target.files.length > 0) manejarArchivoLogo(e.target.files[0]);

    });


    function manejarArchivoLogo(file) {

        const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

        if (!allowedTypes.includes(file.type)) {

            showToast('danger', 'Tipo de archivo no permitido. Use JPEG, PNG o WebP.');

            return;

        }

        if (file.size > 5 * 1024 * 1024) {

            showToast('danger', 'El archivo supera el tamaño máximo de 5 MB.');

            return;

        }


        logoSeleccionado = file;

        const reader = new FileReader();

        reader.onload = (e) => {

            document.getElementById('logoPreviewEmpty').style.display = 'none';

            document.getElementById('logoPreviewContainer').style.display = 'block';

            document.getElementById('logoPreviewImg').src = e.target.result;

            document.getElementById('logoFileName').textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';

        };

        reader.readAsDataURL(file);

    }


    function limpiarLogo() {

        logoSeleccionado = null;

        logoFileInput.value = '';

        document.getElementById('logoPreviewEmpty').style.display = '';

        document.getElementById('logoPreviewContainer').style.display = 'none';

        document.getElementById('logoUrl').value = '';

    }


    function cargarLogoExistente(url) {

        if (!url) return;

        document.getElementById('logoPreviewEmpty').style.display = 'none';

        document.getElementById('logoPreviewContainer').style.display = 'block';

        document.getElementById('logoPreviewImg').src = url;

        document.getElementById('logoFileName').textContent = 'Logo actual';

        document.getElementById('logoUrl').value = url;

    }


    // ── Horarios ──────────────────────────────────────────────

    function obtenerDiasSeleccionados() {

        const dias = [];

        document.querySelectorAll('#diasAtencion .form-check-input:checked').forEach(cb => dias.push(cb.value));

        return dias.length > 0 ? dias.join(',') : null;

    }


    function cargarDiasAtencion(diasStr) {

        if (!diasStr) return;

        const dias = diasStr.split(',');

        dias.forEach(d => {

            const cb = document.querySelector(`#diasAtencion .form-check-input[value="${d}"]`);

            if (cb) cb.checked = true;

        });

    }


    // ── Cargar datos ──────────────────────────────────────────

    document.addEventListener('DOMContentLoaded', function() {

        cargarDatosClinica();

    });


    function cargarDatosClinica() {

        const c = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Clinica, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));


        if (!c) {

            showToast('danger', 'Error: No se encontraron datos de la clínica.');

            return;

        }


        document.getElementById('clinicaId').value = c.id || '';

        document.getElementById('nombre').value = c.nombre || '';

        document.getElementById('direccion').value = c.direccion || '';

        document.getElementById('telefono').value = c.telefono || '';

        document.getElementById('email').value = c.email || '';

        document.getElementById('tiempoEsperaMinutos').value = c.tiempoEsperaMinutos || 30;

        document.getElementById('bdExterna1').value = c.bdExterna1 || '';

        document.getElementById('bdExterna2').value = c.bdExterna2 || '';


        // Logo existente

        cargarLogoExistente(c.logoUrl);


        // Horarios

        document.getElementById('horarioApertura').value = c.horarioApertura || '';

        document.getElementById('horarioCierre').value = c.horarioCierre || '';

        cargarDiasAtencion(c.diasAtencion);


        // Mostrar estado

        const esActivo = c.activo;

        const estadoBadge = document.getElementById('estadoBadge');

        if (estadoBadge) {

            estadoBadge.innerHTML = esActivo

                ? '<span class="badge bg-success">Activa</span>'

                : '<span class="badge bg-secondary">Inactiva</span>';

        }


        // Fechas

        if (c.fechaCreacion) {

            const fechaCre = new Date(c.fechaCreacion);

            document.getElementById('fechaCreacion').textContent = fechaCre.toLocaleDateString('es-ES', {

                year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'

            });

        }


        if (c.fechaModificacion) {

            const fechaMod = new Date(c.fechaModificacion);

            document.getElementById('fechaModificacion').textContent = fechaMod.toLocaleDateString('es-ES', {

                year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'

            });

            document.getElementById('fechaModificacionContainer').style.display = 'inline';

        }


        // Nombre en el título

        const nombreClinica = c.nombre || 'Sin nombre';

        document.querySelector('h5').innerHTML = `<i class="bi bi-pencil-square me-2 text-primary"></i>Editando: ${escapeHtml(nombreClinica)}`;

    }


    // ── Submit del formulario ──────────────────────────────────

    document.getElementById('formClinica').addEventListener('submit', async function(e) {

        e.preventDefault();


        const form = this;

        if (!form.checkValidity()) {

            form.classList.add('was-validated');

            return;

        }


        // Validar horarios

        const apertura = document.getElementById('horarioApertura').value;

        const cierre = document.getElementById('horarioCierre').value;

        if ((apertura && !cierre) || (!apertura && cierre)) {

            showToast('danger', 'Si configura horario, debe indicar tanto apertura como cierre.');

            return;

        }

        if (apertura && cierre && apertura >= cierre) {

            showToast('danger', 'La hora de cierre debe ser posterior a la de apertura.');

            return;

        }


        const btn = document.getElementById('btnGuardar');

        const textoOriginal = btn.innerHTML;

        btn.disabled = true;

        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';


        const id = document.getElementById('clinicaId').value;

        const tiempoEsperaValue = document.getElementById('tiempoEsperaMinutos').value;

        const tiempoEspera = parseInt(tiempoEsperaValue) || 30;


        const data = {

            nombre: document.getElementById('nombre').value.trim(),

            direccion: document.getElementById('direccion').value.trim() || null,

            telefono: document.getElementById('telefono').value.trim() || null,

            email: document.getElementById('email').value.trim() || null,

            logoUrl: document.getElementById('logoUrl').value.trim() || null,

            tiempoEsperaMinutos: tiempoEspera,

            bdExterna1: document.getElementById('bdExterna1').value.trim() || null,

            bdExterna2: document.getElementById('bdExterna2').value.trim() || null,

            horarioApertura: apertura || null,

            horarioCierre: cierre || null,

            diasAtencion: obtenerDiasSeleccionados()

        };


        try {

            const res = await fetch(`@Url.Action("JsonActualizar")?id=${id}`, {

                method: 'PUT',

                headers: { 'Content-Type': 'application/json' },

                body: JSON.stringify(data)

            });


            const json = await res.json();


            if (res.ok && json.success) {

                // Si hay logo nuevo seleccionado, subirlo

                if (logoSeleccionado) {

                    await subirLogo(id);

                }

                showToast('success', json.message || 'Clínica actualizada exitosamente.');

                setTimeout(() => {

                    window.location.href = '/Catalogos/Clinica';

                }, 1000);

            } else {

                showToast('danger', json.message || 'Error al actualizar la clínica.');

                btn.disabled = false;

                btn.innerHTML = textoOriginal;

            }

        } catch (err) {

            showToast('danger', 'Error de conexión al guardar.');

            btn.disabled = false;

            btn.innerHTML = textoOriginal;

        }

    });


    async function subirLogo(clinicaId) {

        const progressDiv = document.getElementById('logoUploadProgress');

        const progressBar = document.getElementById('logoProgressBar');

        const statusText = document.getElementById('logoUploadStatus');


        progressDiv.style.display = 'block';

        statusText.textContent = 'Subiendo logo...';

        progressBar.style.width = '50%';


        const formData = new FormData();

        formData.append('file', logoSeleccionado);


        try {

            const res = await fetch(`@Url.Action("JsonSubirLogo")?clinicaId=${clinicaId}`, {

                method: 'POST',

                body: formData

            });


            const json = await res.json();

            if (res.ok && json.success) {

                progressBar.style.width = '100%';

                statusText.textContent = 'Logo subido ✓';

                document.getElementById('logoUrl').value = json.data || '';

            } else {

                statusText.textContent = 'Error: ' + (json.message || 'No se pudo subir el logo');

                progressBar.classList.remove('bg-success');

                progressBar.classList.add('bg-danger');

            }

        } catch (err) {

            statusText.textContent = 'Error de conexión al subir logo';

            progressBar.classList.remove('bg-success');

            progressBar.classList.add('bg-danger');

        }

    }


    function escapeHtml(text) {

        if (!text) return '';

        const div = document.createElement('div');

        div.textContent = text;

        return div.innerHTML;

    }


    function showToast(type, message) {

        const container = document.getElementById('toastContainer') || createToastContainer();

        const toast = document.createElement('div');

        toast.className = `alert alert-${type} alert-dismissible fade show shadow-sm`;

        toast.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;min-width:320px;max-width:450px;';

        toast.innerHTML = `${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;

        container.appendChild(toast);

        setTimeout(() => toast.remove(), 5000);

    }


    function createToastContainer() {

        const div = document.createElement('div');

        div.id = 'toastContainer';

        document.body.appendChild(div);

        return div;

    }

</script>

}
