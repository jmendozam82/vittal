@{
    ViewData["Title"] = "Editar Perfil";
    var perfilIndexUrl = Url.Action("Index");
    ViewData["Breadcrumb"] = $"<li class='breadcrumb-item'><a href='/'>Inicio</a></li>" +
                             $"<li class='breadcrumb-item'><a href='{perfilIndexUrl}'>Perfiles</a></li>" +
                             "<li class='breadcrumb-item active'>Editar</li>";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-pencil-square text-primary fs-5"></i>
                    <h5 class="mb-0">Editar perfil</h5>
                </div>

                <div id="alertError" class="alert alert-danger d-none" role="alert"></div>

                <div id="loadingInfo" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="text-muted mt-2 mb-0 small">Cargando informaci&oacute;n del perfil...</p>
                </div>

                <form id="frmPerfil" novalidate class="d-none">
                    <input type="hidden" id="perfilId" />
                    <div class="row g-3">
                        <!-- Nombre -->
                        <div class="col-12">
                            <label for="nombre" class="form-label fw-medium">
                                Nombre <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="nombre" name="nombre"
                                   class="form-control" maxlength="100" required />
                            <div class="invalid-feedback">El nombre del perfil es obligatorio (m&iacute;nimo 3 caracteres).</div>
                        </div>

                        <!-- Descripci&oacute;n -->
                        <div class="col-12">
                            <label for="descripcion" class="form-label fw-medium">
                                Descripci&oacute;n
                            </label>
                            <textarea id="descripcion" name="descripcion"
                                      class="form-control" rows="3" maxlength="500"></textarea>
                            <div class="form-text">Opcional. M&aacute;ximo 500 caracteres.</div>
                        </div>

                        <!-- Es Admin -->
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       id="esAdmin" name="esAdmin" />
                                <label class="form-check-label" for="esAdmin">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Perfil de Administrador
                                </label>
                            </div>
                            <div class="form-text">
                                Los perfiles de administrador tienen acceso total a todos los m&oacute;dulos.
                            </div>
                        </div>

                        <!-- Info adicional (solo lectura) -->
                        <div class="col-12">
                            <hr class="text-muted" />
                            <dl class="row mb-0 small text-muted">
                                <dt class="col-sm-5">Estado actual:</dt>
                                <dd class="col-sm-7" id="infoEstado"></dd>
                                <dt class="col-sm-5">Creado el:</dt>
                                <dd class="col-sm-7" id="infoFechaCreacion"></dd>
                                <dt class="col-sm-5">&Uacute;ltima modificaci&oacute;n:</dt>
                                <dd class="col-sm-7" id="infoFechaModificacion">Sin modificaciones</dd>
                            </dl>
                        </div>

                        <!-- Botones -->
                        <div class="col-12 d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary btn-sm" id="btnGuardar">
                                <span id="btnSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                                <i class="bi bi-check-lg me-1" id="btnIcon"></i>
                                Guardar Cambios
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const perfilId = '@ViewContext.RouteData.Values["id"]';

    document.addEventListener('DOMContentLoaded', () => {
        if (!perfilId) {
            mostrarError('ID de perfil no proporcionado.');
            return;
        }
        cargarPerfil();
    });

    async function cargarPerfil() {
        const res = await fetch(`/api/Perfiles/${perfilId}`, {
            method: 'GET',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' }
        });

        if (!res.ok) {
            mostrarError('Perfil no encontrado o error al cargar.');
            return;
        }

        const json = await res.json();
        const p = json.data;

        if (!p) {
            mostrarError('No se encontr&oacute; informaci&oacute;n del perfil.');
            return;
        }

        document.getElementById('perfilId').value = p.id;
        document.getElementById('nombre').value = p.nombre || '';
        document.getElementById('descripcion').value = p.descripcion || '';
        document.getElementById('esAdmin').checked = p.esAdmin;

        document.getElementById('infoEstado').innerHTML = p.activo
            ? '<span class="badge bg-success">Activo</span>'
            : '<span class="badge bg-secondary">Inactivo</span>';
        document.getElementById('infoFechaCreacion').textContent = formatDate(p.fechaCreacion);
        document.getElementById('infoFechaModificacion').textContent = p.fechaModificacion
            ? formatDate(p.fechaModificacion)
            : 'Sin modificaciones';

        document.getElementById('loadingInfo').classList.add('d-none');
        document.getElementById('frmPerfil').classList.remove('d-none');
    }

    document.getElementById('frmPerfil').addEventListener('submit', async (e) => {
        e.preventDefault();

        const nombre = document.getElementById('nombre').value.trim();
        const descripcion = document.getElementById('descripcion').value.trim();
        const esAdmin = document.getElementById('esAdmin').checked;

        const errores = [];
        if (!nombre) errores.push('El nombre del perfil es obligatorio.');
        else if (nombre.length < 3) errores.push('El nombre debe tener al menos 3 caracteres.');
        if (descripcion.length > 500) errores.push('La descripci&oacute;n no puede exceder 500 caracteres.');

        if (errores.length > 0) {
            mostrarErrores(errores);
            return;
        }

        setLoading(true);
        ocultarError();

        const res = await fetch(`/api/Perfiles/${perfilId}`, {
            method: 'PUT',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nombre, descripcion, esAdmin })
        });

        const json = await res.json();
        setLoading(false);

        if (res.ok && json.success) {
            showToast('Perfil actualizado exitosamente.', 'success');
            setTimeout(() => window.location.href = '@Url.Action("Index")', 1200);
        } else {
            const errs = json.errors || [json.message || 'Error al actualizar el perfil.'];
            mostrarErrores(errs);
        }
    });

    function formatDate(iso) {
        if (!iso) return '';
        const d = new Date(iso);
        return d.toLocaleDateString('es-GT', {
            year: 'numeric', month: 'long', day: 'numeric',
            hour: '2-digit', minute: '2-digit'
        });
    }

    function setLoading(loading) {
        const btn = document.getElementById('btnGuardar');
        const spinner = document.getElementById('btnSpinner');
        const icon = document.getElementById('btnIcon');
        btn.disabled = loading;
        spinner.classList.toggle('d-none', !loading);
        icon.classList.toggle('d-none', loading);
    }

    function mostrarErrores(errores) {
        const alert = document.getElementById('alertError');
        alert.classList.remove('d-none');
        alert.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>' +
            errores.map(e => `<div>${escapeHtml(e)}</div>`).join('');
    }

    function mostrarError(msg) {
        document.getElementById('alertError').textContent = msg;
        document.getElementById('alertError').classList.remove('d-none');
        document.getElementById('loadingInfo').classList.add('d-none');
    }

    function ocultarError() {
        document.getElementById('alertError').classList.add('d-none');
    }

    function showToast(message, type) {
        const container = document.getElementById('toastContainer') || createToastContainer();
        const toast = document.createElement('div');
        toast.className = `alert alert-${type} alert-dismissible fade show shadow-sm`;
        toast.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;min-width:320px;max-width:450px;';
        toast.innerHTML = `${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 5000);
    }

    function createToastContainer() {
        const div = document.createElement('div');
        div.id = 'toastContainer';
        document.body.appendChild(div);
        return div;
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
}
