@{
    ViewData["Title"] = "Gesti&oacute;n de Perfiles";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/'>Inicio</a></li>" +
                             "<li class='breadcrumb-item active'>Perfiles</li>";
}

@section HeaderActions {
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Perfil
    </a>
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <!-- Tabla de datos -->
        <div id="tablaContainer">
            <div class="d-flex justify-content-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmaci&oacute;n de desactivar -->
<div class="modal fade" id="modalDesactivar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                    Confirmar desactivaci&oacute;n
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    &iquest;Est&aacute; seguro que desea desactivar el perfil
                    <strong id="nombrePerfilDesactivar"></strong>?
                    <br><small class="text-muted">
                        El registro no ser&aacute; eliminado, solo quedar&aacute; inactivo.
                        No se puede desactivar si tiene usuarios asignados.
                    </small>
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn btn-warning btn-sm text-white" id="btnConfirmarDesactivar">
                    <i class="bi bi-slash-circle me-1"></i> Desactivar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let perfiles = [];
    let idSeleccionado = null;
    const modal = new bootstrap.Modal(document.getElementById('modalDesactivar'));

    document.addEventListener('DOMContentLoaded', cargarPerfiles);

    async function cargarPerfiles() {
        const res = await fetch('/api/Perfiles', {
            method: 'GET',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' }
        });

        if (!res.ok) {
            document.getElementById('tablaContainer').innerHTML =
                '<div class="alert alert-danger">Error al cargar los perfiles. Intente nuevamente.</div>';
            return;
        }

        const json = await res.json();
        perfiles = json.data || [];
        renderTabla(perfiles);
    }

    function renderTabla(items) {
        if (items.length === 0) {
            document.getElementById('tablaContainer').innerHTML = `
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No se encontraron perfiles registrados.
                    <br><a href="@Url.Action("Create")" class="btn btn-sm btn-primary mt-3">
                        <i class="bi bi-plus-lg me-1"></i>Crear primer perfil
                    </a>
                </div>`;
            return;
        }

        const filas = items.map(p => {
            const adminBadge = p.esAdmin
                ? '<span class="badge bg-info me-1">Admin</span>'
                : '';
            const estadoBadge = p.activo
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Inactivo</span>';

            return `
            <tr>
                <td>
                    ${adminBadge}
                    <strong>${escapeHtml(p.nombre)}</strong>
                </td>
                <td class="text-muted">${escapeHtml(p.descripcion || '&mdash;')}</td>
                <td class="text-center">
                    ${p.cantidadUsuarios > 0
                        ? `<span class="badge bg-light text-dark">${p.cantidadUsuarios} usuario(s)</span>`
                        : '<span class="text-muted small">Sin usuarios</span>'}
                </td>
                <td class="text-center">${estadoBadge}</td>
                <td class="text-end">
                    <a href="/Administracion/Perfil/Edit/${p.id}"
                       class="btn btn-outline-primary btn-sm me-1" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </a>
                    ${p.activo ? `
                    <button class="btn btn-outline-warning btn-sm"
                            onclick="confirmarDesactivar('${p.id}', '${escapeHtml(p.nombre)}')"
                            title="Desactivar">
                        <i class="bi bi-slash-circle"></i>
                    </button>` : ''}
                </td>
            </tr>`;
        }).join('');

        document.getElementById('tablaContainer').innerHTML = `
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Descripci&oacute;n</th>
                            <th class="text-center">Usuarios</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>${filas}</tbody>
                </table>
            </div>`;
    }

    function confirmarDesactivar(id, nombre) {
        idSeleccionado = id;
        document.getElementById('nombrePerfilDesactivar').textContent = nombre;
        modal.show();
    }

    document.getElementById('btnConfirmarDesactivar').addEventListener('click', async () => {
        if (!idSeleccionado) return;

        const btn = document.getElementById('btnConfirmarDesactivar');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Desactivando...';

        const res = await fetch(`/api/Perfiles/${idSeleccionado}/desactivar`, {
            method: 'PATCH',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' }
        });

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-slash-circle me-1"></i> Desactivar';
        modal.hide();

        const json = await res.json();
        if (res.ok && json.success) {
            showToast(json.message || 'Perfil desactivado exitosamente.', 'success');
            await cargarPerfiles();
        } else {
            showToast(json.message || 'Error al desactivar el perfil.', 'danger');
        }
        idSeleccionado = null;
    });

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function showToast(message, type) {
        const container = document.getElementById('toastContainer') || createToastContainer();
        const toast = document.createElement('div');
        toast.className = `alert alert-${type} alert-dismissible fade show shadow-sm`;
        toast.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;min-width:320px;max-width:450px;';
        toast.innerHTML = `${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 5000);
    }

    function createToastContainer() {
        const div = document.createElement('div');
        div.id = 'toastContainer';
        document.body.appendChild(div);
        return div;
    }
</script>
}
