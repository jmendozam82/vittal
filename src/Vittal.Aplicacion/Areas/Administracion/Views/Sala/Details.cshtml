@using System.Text.Json
@model Vittal.Aplicacion.Areas.Administracion.Controllers.SalaDetailsViewModel

@{
    ViewData["Title"] = $"Detalle de Sala: {Model.Nombre}";
    var salaIndexUrl = Url.Action("Index");
    var salaEditUrl = Url.Action("Edit", new { id = Model.Id });
    ViewData["Breadcrumb"] = $"<li class='breadcrumb-item'><a href='/'>Inicio</a></li>" +
                             $"<li class='breadcrumb-item'><a href='{salaIndexUrl}'>Salas</a></li>" +
                             "<li class='breadcrumb-item active'>Detalle</li>";

    // URLs para JS
    var jsonListarPlantillasUrl = Url.Action("JsonListarPlantillas");
    var jsonAplicarPlantillaUrl = Url.Action("JsonAplicarPlantilla");
    var jsonAntecedentesUrl = Url.Action("JsonAntecedentes");
    var jsonCrearAntecedenteUrl = Url.Action("JsonCrearAntecedente");
    var jsonActualizarAntecedenteUrl = Url.Action("JsonActualizarAntecedente");
    var jsonDesactivarAntecedenteUrl = Url.Action("JsonDesactivarAntecedente");
    var jsonSignosVitalesUrl = Url.Action("JsonSignosVitales");
    var jsonCrearSignoVitalUrl = Url.Action("JsonCrearSignoVital");
    var jsonActualizarSignoVitalUrl = Url.Action("JsonActualizarSignoVital");
    var jsonDesactivarSignoVitalUrl = Url.Action("JsonDesactivarSignoVital");
    var jsonDoctoresSalaUrl = Url.Action("JsonDoctoresSala");
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        <!-- ====== HEADER: Sala Info ====== -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-door-open text-primary fs-4"></i>
                            <h4 class="mb-0">@Model.Nombre</h4>
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success ms-2">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-2">Inactivo</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Descripcion))
                        {
                            <p class="text-muted mb-0 small">@Model.Descripcion</p>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@salaEditUrl" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil me-1"></i> Editar
                        </a>
                        <a href="@salaIndexUrl" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Volver
                        </a>
                    </div>
                </div>
                <hr class="my-2" />
                <dl class="row mb-0 small text-muted">
                    <dt class="col-sm-2">Creado el:</dt>
                    <dd class="col-sm-4">@(Model.FechaCreacion ?? "No disponible")</dd>
                    <dt class="col-sm-2">Modificado el:</dt>
                    <dd class="col-sm-4">@(Model.FechaModificacion ?? "Sin modificaciones")</dd>
                </dl>
            </div>
        </div>

        <!-- ====== TABS: Antecedentes | Signos Vitales | Doctores ====== -->
        <ul class="nav nav-tabs nav-fill mb-4" id="salaTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-antecedentes" data-bs-toggle="tab"
                        data-bs-target="#panel-antecedentes" type="button" role="tab">
                    <i class="bi bi-journal-text me-1"></i> Antecedentes
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-signos" data-bs-toggle="tab"
                        data-bs-target="#panel-signos" type="button" role="tab">
                    <i class="bi bi-heart-pulse me-1"></i> Signos Vitales
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-doctores" data-bs-toggle="tab"
                        data-bs-target="#panel-doctores" type="button" role="tab">
                    <i class="bi bi-people me-1"></i> Doctores Asignados
                </button>
            </li>
        </ul>

        <div class="tab-content" id="salaTabsContent">

            <!-- ====== TAB 1: ANTECEDENTES ====== -->
            <div class="tab-pane fade show active" id="panel-antecedentes" role="tabpanel">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0"><i class="bi bi-journal-text text-primary me-2"></i>Tipos de Antecedente</h6>
                            <button class="btn btn-success btn-sm" id="btnMostrarFormAntecedente">
                                <i class="bi bi-plus-lg me-1"></i> Nuevo
                            </button>
                        </div>

                        <div id="formNuevoAntecedente" class="card bg-light border-0 mb-3 d-none">
                            <div class="card-body p-3">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-medium">Nombre <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control form-control-sm" id="antNombre" maxlength="200" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-medium">Categoría</label>
                                        <input type="text" class="form-control form-control-sm" id="antCategoria" maxlength="100" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-medium">Tipo Dato</label>
                                        <select class="form-select form-select-sm" id="antTipoDato">
                                            <option value="boolean">Booleano</option>
                                            <option value="text">Texto</option>
                                            <option value="number">Número</option>
                                            <option value="date">Fecha</option>
                                        </select>
                                    </div>
                                    <div class="col-md-1">
                                        <label class="form-label small fw-medium">Orden</label>
                                        <input type="number" class="form-control form-control-sm" id="antOrden" value="1" min="1" />
                                    </div>
                                    <div class="col-md-2 d-flex gap-1">
                                        <button class="btn btn-primary btn-sm w-50" id="btnGuardarAntecedente">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm w-50" id="btnCancelarAntecedente">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                                <div id="antError" class="text-danger small mt-1 d-none"></div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle" id="tblAntecedentes">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Categoría</th>
                                        <th>Tipo</th>
                                        <th class="text-center" style="width:60px;">Orden</th>
                                        <th class="text-center" style="width:80px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyAntecedentes">
                                    <!-- Renderizado por JS -->
                                </tbody>
                            </table>
                        </div>
                        <div id="antecedentesEmpty" class="text-center text-muted py-4 d-none">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            <span>No hay tipos de antecedente configurados para esta sala.</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ====== TAB 2: SIGNOS VITALES ====== -->
            <div class="tab-pane fade" id="panel-signos" role="tabpanel">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0"><i class="bi bi-heart-pulse text-danger me-2"></i>Tipos de Signo Vital</h6>
                            <button class="btn btn-success btn-sm" id="btnMostrarFormSignoVital">
                                <i class="bi bi-plus-lg me-1"></i> Nuevo
                            </button>
                        </div>

                        <div id="formNuevoSignoVital" class="card bg-light border-0 mb-3 d-none">
                            <div class="card-body p-3">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label small fw-medium">Nombre <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control form-control-sm" id="svNombre" maxlength="200" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-medium">Unidad</label>
                                        <input type="text" class="form-control form-control-sm" id="svUnidad" maxlength="50" placeholder="mmHg, bpm..." />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-medium">Valor Mín</label>
                                        <input type="number" class="form-control form-control-sm" id="svValorMin" step="0.01" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-medium">Valor Máx</label>
                                        <input type="number" class="form-control form-control-sm" id="svValorMax" step="0.01" />
                                    </div>
                                    <div class="col-md-1">
                                        <label class="form-label small fw-medium">Orden</label>
                                        <input type="number" class="form-control form-control-sm" id="svOrden" value="1" min="1" />
                                    </div>
                                    <div class="col-md-2 d-flex gap-1">
                                        <button class="btn btn-primary btn-sm w-50" id="btnGuardarSignoVital">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm w-50" id="btnCancelarSignoVital">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="row g-2 mt-1">
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="svEsObligatorio" />
                                            <label class="form-check-label small" for="svEsObligatorio">Obligatorio</label>
                                        </div>
                                    </div>
                                </div>
                                <div id="svError" class="text-danger small mt-1 d-none"></div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle" id="tblSignosVitales">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Unidad</th>
                                        <th>Valor Ref.</th>
                                        <th class="text-center" style="width:60px;">Orden</th>
                                        <th class="text-center" style="width:60px;">Oblig.</th>
                                        <th class="text-center" style="width:80px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodySignosVitales">
                                    <!-- Renderizado por JS -->
                                </tbody>
                            </table>
                        </div>
                        <div id="signosEmpty" class="text-center text-muted py-4 d-none">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            <span>No hay tipos de signo vital configurados para esta sala.</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ====== TAB 3: DOCTORES ASIGNADOS ====== -->
            <div class="tab-pane fade" id="panel-doctores" role="tabpanel">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h6 class="mb-3"><i class="bi bi-people text-info me-2"></i>Doctores Asignados a esta Sala</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Doctor</th>
                                        <th>Email</th>
                                        <th>Asignado el</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyDoctores">
                                    <!-- Renderizado por JS -->
                                </tbody>
                            </table>
                        </div>
                        <div id="doctoresEmpty" class="text-center text-muted py-4 d-none">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            <span>No hay doctores asignados a esta sala.</span>
                        </div>
                    </div>
                </div>
            </div>

        </div><!-- /.tab-content -->

        <!-- ====== PLANTILLA DE ESPECIALIDAD ====== -->
        @if (Model.Activo)
        {
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-file-earmark-medical text-success fs-5"></i>
                        <h6 class="mb-0">Aplicar Plantilla de Especialidad</h6>
                    </div>
                    <p class="text-muted small mb-3">
                        Seleccione una plantilla para importar antecedentes y signos vitales predefinidos a esta sala.
                        Los items existentes no se duplicarán.
                    </p>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-8">
                            <label for="selectPlantilla" class="form-label fw-medium small">Plantilla</label>
                            <select id="selectPlantilla" class="form-select form-select-sm">
                                <option value="">-- Seleccione una plantilla --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-success btn-sm w-100" id="btnAplicarPlantilla" disabled>
                                <span id="aplSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                                <i class="bi bi-download me-1"></i> Aplicar
                            </button>
                        </div>
                    </div>
                    <div id="plantillaResult" class="mt-2 small d-none"></div>
                </div>
            </div>
        }

    </div>
</div>

@section Scripts {
<script>
    (function() {
        const salaId = '@Model.Id';

        // URLs
        const urlAntecedentes = '@jsonAntecedentesUrl';
        const urlCrearAntecedente = '@jsonCrearAntecedenteUrl';
        const urlActualizarAntecedente = '@jsonActualizarAntecedenteUrl';
        const urlDesactivarAntecedente = '@jsonDesactivarAntecedenteUrl';
        const urlSignos = '@jsonSignosVitalesUrl';
        const urlCrearSigno = '@jsonCrearSignoVitalUrl';
        const urlActualizarSigno = '@jsonActualizarSignoVitalUrl';
        const urlDesactivarSigno = '@jsonDesactivarSignoVitalUrl';
        const urlDoctores = '@jsonDoctoresSalaUrl';
        const urlPlantillas = '@jsonListarPlantillasUrl';
        const urlAplicarPlantilla = '@jsonAplicarPlantillaUrl';

        // ─── Datos pre-cargados desde el servidor ───
        let antecedentes = [];
        let signosVitales = [];
        let doctores = [];
        let plantillas = [];

        try { antecedentes = @Html.Raw(Model.AntecedentesJson); } catch(e) { antecedentes = []; }
        try { plantillas = @Html.Raw(Model.PlantillasJson); } catch(e) { plantillas = []; }
        try { doctores = @Html.Raw(Model.DoctoresJson); } catch(e) { doctores = []; }
        // Signos se cargan via API para mantener frescura (o se pueden pre-cargar)
        try { signosVitales = @Html.Raw(Model.SignosVitalesJson); } catch(e) { signosVitales = []; }

        // ─── Render: Antecedentes ───
        function renderAntecedentes() {
            const tbody = document.getElementById('tbodyAntecedentes');
            const empty = document.getElementById('antecedentesEmpty');
            tbody.innerHTML = '';
            if (antecedentes.length === 0) {
                empty.classList.remove('d-none');
                return;
            }
            empty.classList.add('d-none');
            antecedentes.forEach(a => {
                const tr = document.createElement('tr');
                const tipoLabel = { boolean: 'Bool', text: 'Texto', number: 'Núm', date: 'Fecha' }[a['tipoDato']] || a['tipoDato'] || 'Bool';
                tr.innerHTML = `
                    <td><span class="fw-medium">${escapeHtml(a['nombre'] || '')}</span></td>
                    <td class="text-muted small">${escapeHtml(a['categoria'] || '-')}</td>
                    <td><span class="badge bg-light text-dark">${escapeHtml(tipoLabel)}</span></td>
                    <td class="text-center">${a['orden'] || 0}</td>
                    <td class="text-center">
                        <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Desactivar"
                                onclick="desactivarAntecedente('${a['id']}')">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // ─── Render: Signos Vitales ───
        function renderSignosVitales() {
            const tbody = document.getElementById('tbodySignosVitales');
            const empty = document.getElementById('signosEmpty');
            tbody.innerHTML = '';
            if (signosVitales.length === 0) {
                empty.classList.remove('d-none');
                return;
            }
            empty.classList.add('d-none');
            signosVitales.forEach(s => {
                const tr = document.createElement('tr');
                const valorRef = (s['valorMin'] != null || s['valorMax'] != null)
                    ? `${s['valorMin'] ?? '∞'} - ${s['valorMax'] ?? '∞'} ${s['unidad'] || ''}`
                    : (s['unidad'] ? s['unidad'] : '-');
                tr.innerHTML = `
                    <td><span class="fw-medium">${escapeHtml(s['nombre'] || '')}</span></td>
                    <td class="small">${escapeHtml(s['unidad'] || '-')}</td>
                    <td class="small text-muted">${escapeHtml(valorRef)}</td>
                    <td class="text-center">${s['orden'] || 0}</td>
                    <td class="text-center">${s['esObligatorio'] ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-circle text-muted"></i>'}</td>
                    <td class="text-center">
                        <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Desactivar"
                                onclick="desactivarSignoVital('${s['id']}')">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // ─── Render: Doctores ───
        function renderDoctores() {
            const tbody = document.getElementById('tbodyDoctores');
            const empty = document.getElementById('doctoresEmpty');
            tbody.innerHTML = '';
            if (doctores.length === 0) {
                empty.classList.remove('d-none');
                return;
            }
            empty.classList.add('d-none');
            doctores.forEach(d => {
                const tr = document.createElement('tr');
                const fecha = d['fechaCreacion'] ? new Date(d['fechaCreacion']).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' }) : '-';
                tr.innerHTML = `
                    <td><span class="fw-medium">${escapeHtml(d['usuarioNombre'] || 'Sin nombre')}</span></td>
                    <td class="small text-muted">${escapeHtml(d['usuarioEmail'] || '-')}</td>
                    <td class="small text-muted">${fecha}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // ─── Render: Plantillas dropdown ───
        function renderPlantillas() {
            const select = document.getElementById('selectPlantilla');
            if (!select) return;
            select.innerHTML = '<option value="">-- Seleccione una plantilla --</option>';
            plantillas.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p['id'];
                opt.textContent = p['nombre'] || '(sin nombre)';
                select.appendChild(opt);
            });
            select.disabled = false;
        }

        // ─── CRUD: Antecedentes ───
        window.desactivarAntecedente = async function(id) {
            if (!confirm('¿Desactivar este tipo de antecedente?')) return;
            try {
                const res = await fetch(`${urlDesactivarAntecedente}?id=${id}`, { method: 'PATCH' });
                const json = await res.json();
                if (res.ok && json.success) {
                    showToast('Antecedente desactivado.', 'success');
                    await recargarAntecedentes();
                } else {
                    showToast(json.message || 'Error al desactivar.', 'danger');
                }
            } catch(e) {
                showToast('Error de conexión.', 'danger');
            }
        };

        async function recargarAntecedentes() {
            try {
                const res = await fetch(`${urlAntecedentes}?salaId=${salaId}`);
                const json = await res.json();
                if (json.success && json.data) {
                    antecedentes = json.data;
                    renderAntecedentes();
                }
            } catch(e) { console.warn('Error recargando antecedentes:', e); }
        }

        async function recargarSignos() {
            try {
                const res = await fetch(`${urlSignos}?salaId=${salaId}`);
                const json = await res.json();
                if (json.success && json.data) {
                    signosVitales = json.data;
                    renderSignosVitales();
                }
            } catch(e) { console.warn('Error recargando signos:', e); }
        }

        // ─── Formulario: Nuevo Antecedente ───
        document.getElementById('btnMostrarFormAntecedente').addEventListener('click', function() {
            const form = document.getElementById('formNuevoAntecedente');
            form.classList.toggle('d-none');
            if (!form.classList.contains('d-none')) {
                document.getElementById('antNombre').focus();
            }
        });

        document.getElementById('btnCancelarAntecedente').addEventListener('click', function() {
            document.getElementById('formNuevoAntecedente').classList.add('d-none');
            document.getElementById('antError').classList.add('d-none');
            document.getElementById('antNombre').value = '';
            document.getElementById('antCategoria').value = '';
            document.getElementById('antTipoDato').value = 'boolean';
            document.getElementById('antOrden').value = '1';
        });

        document.getElementById('btnGuardarAntecedente').addEventListener('click', async function() {
            const nombre = document.getElementById('antNombre').value.trim();
            if (!nombre) {
                showError('antError', 'El nombre es obligatorio.');
                return;
            }
            ocultarError('antError');
            this.disabled = true;

            try {
                const res = await fetch(urlCrearAntecedente, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        salaId: salaId,
                        nombre: nombre,
                        categoria: document.getElementById('antCategoria').value.trim() || null,
                        tipoDato: document.getElementById('antTipoDato').value,
                        orden: parseInt(document.getElementById('antOrden').value) || 1
                    })
                });
                const json = await res.json();
                if (res.ok && json.success) {
                    showToast('Antecedente creado.', 'success');
                    document.getElementById('antNombre').value = '';
                    document.getElementById('antCategoria').value = '';
                    document.getElementById('antTipoDato').value = 'boolean';
                    document.getElementById('antOrden').value = '1';
                    document.getElementById('formNuevoAntecedente').classList.add('d-none');
                    await recargarAntecedentes();
                } else {
                    showError('antError', json.message || 'Error al crear.');
                }
            } catch(e) {
                showError('antError', 'Error de conexión.');
            }
            this.disabled = false;
        });

        // ─── Formulario: Nuevo Signo Vital ───
        document.getElementById('btnMostrarFormSignoVital').addEventListener('click', function() {
            const form = document.getElementById('formNuevoSignoVital');
            form.classList.toggle('d-none');
            if (!form.classList.contains('d-none')) {
                document.getElementById('svNombre').focus();
            }
        });

        document.getElementById('btnCancelarSignoVital').addEventListener('click', function() {
            document.getElementById('formNuevoSignoVital').classList.add('d-none');
            document.getElementById('svError').classList.add('d-none');
            document.getElementById('svNombre').value = '';
            document.getElementById('svUnidad').value = '';
            document.getElementById('svValorMin').value = '';
            document.getElementById('svValorMax').value = '';
            document.getElementById('svOrden').value = '1';
            document.getElementById('svEsObligatorio').checked = false;
        });

        document.getElementById('btnGuardarSignoVital').addEventListener('click', async function() {
            const nombre = document.getElementById('svNombre').value.trim();
            if (!nombre) {
                showError('svError', 'El nombre es obligatorio.');
                return;
            }
            ocultarError('svError');
            this.disabled = true;

            try {
                const res = await fetch(urlCrearSigno, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        salaId: salaId,
                        nombre: nombre,
                        unidad: document.getElementById('svUnidad').value.trim() || null,
                        valorMin: parseFloat(document.getElementById('svValorMin').value) || null,
                        valorMax: parseFloat(document.getElementById('svValorMax').value) || null,
                        orden: parseInt(document.getElementById('svOrden').value) || 1,
                        esObligatorio: document.getElementById('svEsObligatorio').checked
                    })
                });
                const json = await res.json();
                if (res.ok && json.success) {
                    showToast('Signo vital creado.', 'success');
                    document.getElementById('svNombre').value = '';
                    document.getElementById('svUnidad').value = '';
                    document.getElementById('svValorMin').value = '';
                    document.getElementById('svValorMax').value = '';
                    document.getElementById('svOrden').value = '1';
                    document.getElementById('svEsObligatorio').checked = false;
                    document.getElementById('formNuevoSignoVital').classList.add('d-none');
                    await recargarSignos();
                } else {
                    showError('svError', json.message || 'Error al crear.');
                }
            } catch(e) {
                showError('svError', 'Error de conexión.');
            }
            this.disabled = false;
        });

        // ─── CRUD: Signos Vitales ───
        window.desactivarSignoVital = async function(id) {
            if (!confirm('¿Desactivar este tipo de signo vital?')) return;
            try {
                const res = await fetch(`${urlDesactivarSigno}?id=${id}`, { method: 'PATCH' });
                const json = await res.json();
                if (res.ok && json.success) {
                    showToast('Signo vital desactivado.', 'success');
                    await recargarSignos();
                } else {
                    showToast(json.message || 'Error al desactivar.', 'danger');
                }
            } catch(e) {
                showToast('Error de conexión.', 'danger');
            }
        };

        // ─── Aplicar Plantilla ───
        if (document.getElementById('selectPlantilla')) {
            document.getElementById('selectPlantilla').addEventListener('change', function() {
                document.getElementById('btnAplicarPlantilla').disabled = !this.value;
            });

            document.getElementById('btnAplicarPlantilla').addEventListener('click', async function() {
                const plantillaId = document.getElementById('selectPlantilla').value;
                if (!plantillaId) return;

                const btn = this;
                const spinner = document.getElementById('aplSpinner');
                const resultDiv = document.getElementById('plantillaResult');

                btn.disabled = true;
                spinner.classList.remove('d-none');
                resultDiv.classList.add('d-none');

                try {
                    const res = await fetch(urlAplicarPlantilla, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ salaId: salaId, plantillaId: plantillaId })
                    });
                    const json = await res.json();

                    if (res.ok && json.success) {
                        const d = json.data;
                        const resumen = d && d.resumen ? d.resumen : (
                            'Antecedentes: ' + (d?.antecedentesCreados || 0) + ' creados, ' +
                            (d?.antecedentesReactivados || 0) + ' reactivados, ' +
                            (d?.antecedentesSaltados || 0) + ' saltados. ' +
                            'Signos Vitales: ' + (d?.signosVitalesCreados || 0) + ' creados, ' +
                            (d?.signosVitalesReactivados || 0) + ' reactivados, ' +
                            (d?.signosVitalesSaltados || 0) + ' saltados.'
                        );
                        resultDiv.className = 'mt-2 small text-success';
                        resultDiv.innerHTML = '<i class="bi bi-check-circle me-1"></i> ' + escapeHtml(json.message || 'Plantilla aplicada.') +
                            '<br><span class="text-muted">' + escapeHtml(resumen) + '</span>';

                        // Recargar datos después de aplicar plantilla
                        await recargarAntecedentes();
                        await recargarSignos();
                    } else {
                        resultDiv.className = 'mt-2 small text-danger';
                        resultDiv.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i> ' +
                            escapeHtml(json.message || 'Error al aplicar plantilla.');
                    }
                } catch(err) {
                    resultDiv.className = 'mt-2 small text-danger';
                    resultDiv.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i> Error de conexión.';
                }

                spinner.classList.add('d-none');
                btn.disabled = false;
                resultDiv.classList.remove('d-none');
            });
        }

        // ─── Render inicial ───
        renderAntecedentes();
        renderSignosVitales();
        renderDoctores();
        renderPlantillas();

        // ─── Funciones auxiliares ───
        function showError(elementId, msg) {
            const el = document.getElementById(elementId);
            if (el) {
                el.textContent = msg;
                el.classList.remove('d-none');
            }
        }

        function ocultarError(elementId) {
            const el = document.getElementById(elementId);
            if (el) el.classList.add('d-none');
        }

        function showToast(message, type) {
            const container = document.getElementById('toastContainer') || createToastContainer();
            const toast = document.createElement('div');
            toast.className = 'alert alert-' + type + ' alert-dismissible fade show shadow-sm';
            toast.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;min-width:320px;max-width:450px;';
            toast.innerHTML = message + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 5000);
        }

        function createToastContainer() {
            const div = document.createElement('div');
            div.id = 'toastContainer';
            document.body.appendChild(div);
            return div;
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

    })();
</script>
}
