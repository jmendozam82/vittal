@{

    ViewData["Title"] = "Gestión de Usuarios";

    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/'>Inicio</a></li>" +

                             "<li class='breadcrumb-item active'>Usuarios</li>";

    var jsonUsuariosUrl = Url.Action("JsonUsuarios");

    var crearUsuarioUrl = Url.Action("Create");

}



@section HeaderActions {

    <a asp-action="Create" class="btn btn-primary btn-sm">

        <i class="bi bi-plus-lg me-1"></i> Nuevo Usuario

    </a>

}



<div class="card shadow-sm border-0">

    <div class="card-body">

        <!-- Buscador y Toggle de Inactivos -->

        <div class="row mb-3">

            <div class="col-md-6">

                <div class="input-group">

                    <span class="input-group-text bg-white">

                        <i class="bi bi-search text-muted"></i>

                    </span>

                    <input type="text"

                           id="buscarUsuario"

                           class="form-control"

                           placeholder="Buscar por nombre, username, email o documento..."

                           autocomplete="off" />

                    <button type="button"

                            class="btn btn-outline-secondary"

                            id="btnLimpiarBusqueda"

                            style="display: none;"

                            title="Limpiar búsqueda">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>

            </div>

            <div class="col-md-6 d-flex align-items-center mt-2 mt-md-0 justify-content-between">

                <div class="form-check form-switch">

                    <input class="form-check-input" type="checkbox" id="toggleInactivos" />

                    <label class="form-check-label" for="toggleInactivos">

                        Mostrar inactivos

                    </label>

                </div>

                <small class="text-muted" id="contadorResultados"></small>

            </div>

        </div>



        <!-- Tabla de datos -->
        <div id="tablaContainer">
            <!-- Skeleton loading — se reemplaza cuando llegan los datos -->
            <div class="skeleton-container">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre completo</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th class="text-center">Perfil</th>
                                <th>Documento</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="7"><div class="skeleton-row" style="height:42px;margin-bottom:10px;"></div></td></tr>
                            <tr><td colspan="7"><div class="skeleton-row" style="height:42px;margin-bottom:10px;"></div></td></tr>
                            <tr><td colspan="7"><div class="skeleton-row" style="height:42px;margin-bottom:10px;"></div></td></tr>
                            <tr><td colspan="7"><div class="skeleton-row" style="height:42px;margin-bottom:10px;"></div></td></tr>
                            <tr><td colspan="7"><div class="skeleton-row" style="height:42px;margin-bottom:10px;"></div></td></tr>
                            <tr><td colspan="7"><div class="skeleton-row" style="height:42px;"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

</div>



<!-- Modal de confirmación de desactivar -->

<div class="modal fade" id="modalDesactivar" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header border-0 pb-0">

                <h5 class="modal-title">

                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>

                    Confirmar desactivación

                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <p class="mb-0">

                    ¿Esta seguro que desea desactivar al usuario

                    <strong id="nombreUsuarioDesactivar"></strong>?

                    <br><small class="text-muted">

                        El registro no sera eliminado, solo quedara inactivo.

                        Se bloqueara el acceso al sistema.

                    </small>

                </p>

            </div>

            <div class="modal-footer border-0">

                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button type="button" class="btn btn-warning btn-sm text-white" id="btnConfirmarDesactivar">

                    <i class="bi bi-slash-circle me-1"></i> Desactivar

                </button>

            </div>

        </div>

    </div>

</div>



<!-- Modal de confirmación de reactivar -->

<div class="modal fade" id="modalReactivar" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header border-0 pb-0">

                <h5 class="modal-title">

                    <i class="bi bi-check-circle text-success me-2"></i>

                    Confirmar reactivación

                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <p class="mb-0">

                    ¿Esta seguro que desea reactivar al usuario

                    <strong id="nombreUsuarioReactivar"></strong>?

                    <br><small class="text-muted">

                        El usuario volvera a tener acceso al sistema.

                    </small>

                </p>

            </div>

            <div class="modal-footer border-0">

                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button type="button" class="btn btn-success btn-sm" id="btnConfirmarReactivar">

                    <i class="bi bi-check-lg me-1"></i> Reactivar

                </button>

            </div>

        </div>

    </div>

</div>



@section Scripts {

<script>

    const URLS = {

        listar: '@jsonUsuariosUrl',

        crear: '@crearUsuarioUrl',

        desactivar: '@Url.Action("JsonDesactivar")',

        reactivar: '@Url.Action("JsonReactivar")'

    };



    let usuarios = [];

    let idSeleccionado = null;

    let terminoBusqueda = '';

    let mostrarInactivos = false;

    let debounceTimer = null;

    const modalDesactivar = new bootstrap.Modal(document.getElementById('modalDesactivar'));

    const modalReactivar = new bootstrap.Modal(document.getElementById('modalReactivar'));



    document.addEventListener('DOMContentLoaded', function() {

        cargarUsuarios();

        inicializarBuscador();

        inicializarToggleInactivos();

    });



    function inicializarToggleInactivos() {

        const toggle = document.getElementById('toggleInactivos');

        if (!toggle) return;



        toggle.addEventListener('change', function() {

            mostrarInactivos = this.checked;

            cargarUsuarios(); // Re-fetch from API with new filter

        });

    }



    function inicializarBuscador() {

        const input = document.getElementById('buscarUsuario');

        const btnLimpiar = document.getElementById('btnLimpiarBusqueda');



        if (!input) return;



        input.addEventListener('input', function() {

            const valor = this.value.trim();

            btnLimpiar.style.display = valor ? 'inline-block' : 'none';



            clearTimeout(debounceTimer);

            debounceTimer = setTimeout(function() {

                terminoBusqueda = valor.toLowerCase();

                aplicarFiltro();

            }, 300);

        });



        btnLimpiar.addEventListener('click', function() {

            input.value = '';

            this.style.display = 'none';

            terminoBusqueda = '';

            aplicarFiltro();

            input.focus();

        });

    }



    function aplicarFiltro() {

        if (usuarios.length === 0) return;



        let filtrados = usuarios;



        // El API ya filtra activos/inactivos via ?inactivos=, solo aplicar búsqueda

        if (terminoBusqueda) {

            filtrados = usuarios.filter(function(u) {

                const nombre = ((u.nombres || '') + ' ' + (u.apellidos || '')).toLowerCase();

                const username = (u.username || '').toLowerCase();

                const email = (u.email || '').toLowerCase();

                const documento = ((u.numeroDocumentoIdentificacion || '')).toLowerCase();

                return nombre.includes(terminoBusqueda) || username.includes(terminoBusqueda) || email.includes(terminoBusqueda) || documento.includes(terminoBusqueda);

            });

        }



        renderTabla(filtrados);

        actualizarContador(filtrados.length, usuarios.length);

    }



    function actualizarContador(mostrados, total) {

        const el = document.getElementById('contadorResultados');

        if (!el) return;



        if (!terminoBusqueda) {

            el.textContent = '';

            return;

        }



        el.textContent = mostrados + ' de ' + total + ' usuarios mostrados';

    }



    async function cargarUsuarios() {

        try {

            const url = `${URLS.listar}?inactivos=${mostrarInactivos}`;

            const res = await fetch(url, {

                method: 'GET',

                headers: { 'Content-Type': 'application/json' }

            });



            if (!res.ok) {

                mostrarError('No se pudo conectar con el servidor.');

                return;

            }



            const json = await res.json();



            if (!json.success) {

                mostrarError(json.message || 'Error al cargar los usuarios.');

                return;

            }



            usuarios = json.data || [];

            renderTabla(usuarios);

        } catch (err) {

            console.error('Error al cargar usuarios:', err);
            mostrarError('No se pudieron cargar los datos. Si el problema persiste, contacte al administrador.');

        }

    }



    function mostrarError(mensaje) {

        document.getElementById('tablaContainer').innerHTML = `

            <div class="alert alert-warning alert-dismissible fade show" role="alert">

                <i class="bi bi-exclamation-triangle me-2"></i>${escapeHtml(mensaje)}

                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>

            </div>

            <div class="text-center mt-3">

                <button class="btn btn-outline-primary btn-sm" onclick="cargarUsuarios()">

                    <i class="bi bi-arrow-clockwise me-1"></i> Reintentar

                </button>

            </div>`;

    }



    function renderTabla(items) {

        if (items.length === 0) {

            const hayDatos = usuarios.length > 0;

            const mensaje = hayDatos

                ? '<i class="bi bi-search fs-1 d-block mb-2"></i>No se encontraron resultados para la búsqueda.'

                : '<i class="bi bi-inbox fs-1 d-block mb-2"></i>No se encontraron usuarios registrados.';

            const accion = hayDatos

                ? ''

                : '<br><a href="' + URLS.crear + '" class="btn btn-sm btn-primary mt-3"><i class="bi bi-plus-lg me-1"></i>Crear primer usuario</a>';



            document.getElementById('tablaContainer').innerHTML = `

                <div class="text-center py-5 text-muted">

                    ${mensaje}

                    ${acción}

                </div>`;

            return;

        }



        const filas = items.map(u => {

            const nombreCompleto = escapeHtml((u.nombres || '') + ' ' + (u.apellidos || ''));

            const perfilBadge = u.perfilNombre

                ? '<span class="badge bg-info">' + escapeHtml(u.perfilNombre) + '</span>'

                : '<span class="badge bg-secondary">Sin perfil</span>';

            const doctorBadge = u.esDoctor

                ? '<span class="badge bg-primary me-1">Doctor</span>'

                : '';

            const estadoBadge = u.activo

                ? '<span class="badge bg-success">Activo</span>'

                : '<span class="badge bg-secondary">Inactivo</span>';



            return `

            <tr class="${!u.activo ? 'table-light opacity-75' : ''}">

                <td>

                    ${doctorBadge}

                    <strong>${nombreCompleto}</strong>

                </td>

                <td><code>${escapeHtml(u.username || '')}</code></td>

                <td class="text-muted">${escapeHtml(u.email || '')}</td>

                <td class="text-center">${perfilBadge}</td>

                <td>${escapeHtml((u.tipoDocumentoIdentificacion || '') + ' ' + (u.numeroDocumentoIdentificacion || ''))}</td>

                <td class="text-center">${estadoBadge}</td>

                <td class="text-end">

                    <a href="/Administracion/Usuario/Edit/${u.usuarioId}"

                       class="btn btn-outline-primary btn-sm me-1" title="Editar">

                        <i class="bi bi-pencil"></i>

                    </a>

                    ${u.activo ? `

                    <button class="btn btn-outline-warning btn-sm"

                            onclick="confirmarDesactivar('${u.usuarioId}', '${escapeHtml((u.nombres || '') + ' ' + (u.apellidos || ''))}')"

                            title="Desactivar">

                        <i class="bi bi-slash-circle"></i>

                    </button>` : `

                    <button class="btn btn-outline-success btn-sm"

                            onclick="confirmarReactivar('${u.usuarioId}', '${escapeHtml((u.nombres || '') + ' ' + (u.apellidos || ''))}')"

                            title="Reactivar">

                        <i class="bi bi-check-circle"></i>

                    </button>`}

                </td>

            </tr>`;

        }).join('');



        document.getElementById('tablaContainer').innerHTML = `

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Nombre completo</th>

                            <th>Username</th>

                            <th>Email</th>

                            <th class="text-center">Perfil</th>

                            <th>Documento</th>

                            <th class="text-center">Estado</th>

                            <th class="text-end">Acciones</th>

                        </tr>

                    </thead>

                    <tbody>${filas}</tbody>

                </table>

            </div>`;

    }



    function confirmarDesactivar(id, nombre) {

        idSeleccionado = id;

        document.getElementById('nombreUsuarioDesactivar').textContent = nombre;

        modalDesactivar.show();

    }



    function confirmarReactivar(id, nombre) {

        idSeleccionado = id;

        document.getElementById('nombreUsuarioReactivar').textContent = nombre;

        modalReactivar.show();

    }



    document.getElementById('btnConfirmarDesactivar').addEventListener('click', async () => {

        if (!idSeleccionado) return;



        const btn = document.getElementById('btnConfirmarDesactivar');

        btn.disabled = true;

        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Desactivando...';



        try {

            const res = await fetch(`${URLS.desactivar}?id=${idSeleccionado}`, {

                method: 'PATCH',

                headers: { 'Content-Type': 'application/json' }

            });



            const json = await res.json();



            if (res.ok && json.success) {

                showToast(json.message || 'Usuario desactivado exitosamente.', 'success');

                await cargarUsuarios();

            } else {

                showToast(json.message || 'Error al desactivar el usuario.', 'danger');

            }

        } catch (err) {

            console.error('Error al desactivar usuario:', err);
            showToast('Error al desactivar el usuario. Intente nuevamente.', 'danger');

        } finally {

            btn.disabled = false;

            btn.innerHTML = '<i class="bi bi-slash-circle me-1"></i> Desactivar';

            modalDesactivar.hide();

            idSeleccionado = null;

        }

    });



    document.getElementById('btnConfirmarReactivar').addEventListener('click', async () => {

        if (!idSeleccionado) return;



        const btn = document.getElementById('btnConfirmarReactivar');

        btn.disabled = true;

        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Reactivando...';



        try {

            const res = await fetch(`${URLS.reactivar}?id=${idSeleccionado}`, {

                method: 'PATCH',

                headers: { 'Content-Type': 'application/json' }

            });



            const json = await res.json();



            if (res.ok && json.success) {

                showToast(json.message || 'Usuario reactivado exitosamente.', 'success');

                await cargarUsuarios();

            } else {

                showToast(json.message || 'Error al reactivar el usuario.', 'danger');

            }

        } catch (err) {

            console.error('Error al reactivar usuario:', err);
            showToast('Error al reactivar el usuario. Intente nuevamente.', 'danger');

        } finally {

            btn.disabled = false;

            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Reactivar';

            modalReactivar.hide();

            idSeleccionado = null;

        }

    });



    function escapeHtml(text) {

        if (!text) return '';

        const div = document.createElement('div');

        div.textContent = text;

        return div.innerHTML;

    }



    function showToast(message, type) {

        const container = document.getElementById('toastContainer') || createToastContainer();

        const toast = document.createElement('div');

        toast.className = `alert alert-${type} alert-dismissible fade show shadow-sm`;

        toast.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;min-width:320px;max-width:450px;';

        toast.innerHTML = `${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;

        container.appendChild(toast);

        setTimeout(() => toast.remove(), 5000);

    }



    function createToastContainer() {

        const div = document.createElement('div');

        div.id = 'toastContainer';

        document.body.appendChild(div);

        return div;

    }

</script>

}

