@{
    ViewData["Title"] = "Vista General de Citas";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/'>Inicio</a></li>" +
                             "<li class='breadcrumb-item'><a href='" + Url.Action("Index", "Agenda") + "'>Agenda</a></li>" +
                             "<li class='breadcrumb-item active'>Vista General</li>";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var jsonCitasUrl = Url.Action("JsonCitas");
    var jsonActualizarUrl = Url.Action("JsonActualizar");
    var jsonCancelarUrl = Url.Action("JsonCancelar");
    var jsonDesactivarUrl = Url.Action("JsonDesactivar");
    var jsonPacientesUrl = Url.Action("JsonPacientes");
    var jsonDoctoresUrl = Url.Action("JsonDoctores");
    var jsonSalasUrl = Url.Action("JsonSalas");
    var volverUrl = Url.Action("Index", "Agenda");
}

@section Styles {
    <link rel="stylesheet" href="~/css/vittal-agenda.css" asp-append-version="true" />
}

<div class="agenda-toolbar mb-3">
    <div class="agenda-toolbar-left">
        <a href="@volverUrl" class="btn btn-outline-secondary btn-sm" title="Volver al calendario">
            <i class="bi bi-arrow-left me-1"></i>Calendario
        </a>
        <h5 class="ms-3 mb-0 fw-semibold">
            <i class="bi bi-table text-primary me-1"></i>Vista General de Citas
        </h5>
    </div>
    <div class="agenda-toolbar-right">
        <select id="filtroPeriodo" class="form-select form-select-sm me-2" style="width:auto;">
            <option value="hoy">Hoy</option>
            <option value="7" selected>Últimos 7 días</option>
            <option value="30">Últimos 30 días</option>
            <option value="todas">Todas</option>
        </select>
        <div class="input-group input-group-sm" style="width:280px;">
            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="buscarCita" class="form-control" placeholder="Buscar por paciente o doctor..."
                   autocomplete="off" />
        </div>
    </div>
</div>

@{/* ── Resumen consolidado por estado (clicable) ─────────────── */}
<div class="row g-2 mb-3" id="resumenEstados">
    <div class="col-6 col-md-4 col-lg-2">
        <button type="button" class="card resumen-card w-100 text-start border-0 shadow-sm h-100" data-estado="todos">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-muted small">Total</span>
                    <i class="bi bi-calendar3 text-primary"></i>
                </div>
                <div class="resumen-numero fs-4 fw-bold text-dark" data-count="todos">—</div>
            </div>
        </button>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <button type="button" class="card resumen-card w-100 text-start border-0 shadow-sm h-100" data-estado="agendada">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-muted small">Agendadas</span>
                    <i class="bi bi-calendar-plus" style="color:var(--agenda-card-agendada-border)"></i>
                </div>
                <div class="resumen-numero fs-4 fw-bold text-dark" data-count="agendada">—</div>
            </div>
        </button>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <button type="button" class="card resumen-card w-100 text-start border-0 shadow-sm h-100" data-estado="en_espera">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-muted small">En Espera</span>
                    <i class="bi bi-clock" style="color:var(--agenda-card-en-espera-border)"></i>
                </div>
                <div class="resumen-numero fs-4 fw-bold text-dark" data-count="en_espera">—</div>
            </div>
        </button>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <button type="button" class="card resumen-card w-100 text-start border-0 shadow-sm h-100" data-estado="en_atencion">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-muted small">En Atención</span>
                    <i class="bi bi-play-circle" style="color:var(--agenda-card-en-atencion-border)"></i>
                </div>
                <div class="resumen-numero fs-4 fw-bold text-dark" data-count="en_atencion">—</div>
            </div>
        </button>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <button type="button" class="card resumen-card w-100 text-start border-0 shadow-sm h-100" data-estado="atendida">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-muted small">Atendidas</span>
                    <i class="bi bi-check-circle" style="color:var(--agenda-card-atendida-border)"></i>
                </div>
                <div class="resumen-numero fs-4 fw-bold text-dark" data-count="atendida">—</div>
            </div>
        </button>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <button type="button" class="card resumen-card w-100 text-start border-0 shadow-sm h-100" data-estado="cancelada">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-muted small">Canceladas</span>
                    <i class="bi bi-x-circle" style="color:var(--agenda-card-cancelada-border)"></i>
                </div>
                <div class="resumen-numero fs-4 fw-bold text-dark" data-count="cancelada">—</div>
            </div>
        </button>
    </div>
</div>

@{/* ── Grid de citas ─────────────────────────────────────────── */}
<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <small class="text-muted" id="contadorResultados"></small>
            <span class="badge bg-primary-subtle text-primary" id="filtroActivoBadge" style="display:none;">Todos los estados</span>
        </div>
        <div id="tablaContainer">
            <div class="d-flex justify-content-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@{/* ── MODAL: Editar Cita desde grilla ─────────────────────────── */}
<div class="modal fade" id="modalEditarCitaGrid" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-pencil-square me-2 text-primary"></i>Editar Cita
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formCitaGrid" novalidate>
                    <input type="hidden" id="gridCitaId" value="" />
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="gridPacienteId" class="form-label">Paciente <span class="text-danger">*</span></label>
                            <select class="form-select" id="gridPacienteId" required>
                                <option value="">-- Buscar o seleccionar paciente --</option>
                            </select>
                            <div class="invalid-feedback">Debe seleccionar un paciente.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="gridDoctorId" class="form-label">Doctor <span class="text-danger">*</span></label>
                            <select class="form-select" id="gridDoctorId" required>
                                <option value="">-- Seleccionar doctor --</option>
                            </select>
                            <div class="invalid-feedback">Debe seleccionar un doctor.</div>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label for="gridFecha" class="form-label">Fecha <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="gridFecha" required />
                            <div class="invalid-feedback">La fecha es obligatoria.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="gridHora" class="form-label">Hora Inicio <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" id="gridHora" required />
                            <div class="invalid-feedback">La hora de inicio es obligatoria.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="gridHoraFin" class="form-label">Hora Fin</label>
                            <input type="time" class="form-control" id="gridHoraFin" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label for="gridSalaId" class="form-label">Sala / Área</label>
                            <select class="form-select" id="gridSalaId">
                                <option value="">-- Sin sala --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="gridLugar" class="form-label">Lugar</label>
                            <input type="text" class="form-control" id="gridLugar" maxlength="200" placeholder="Consultorio, Sala de espera...">
                        </div>
                        <div class="col-md-4">
                            <label for="gridEstado" class="form-label">Estado</label>
                            <select class="form-select" id="gridEstado">
                                <option value="agendada">Agendada</option>
                                <option value="en_espera">En Espera</option>
                                <option value="en_atencion">En Atención</option>
                                <option value="cancelada">Cancelada</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-12">
                            <label for="gridMotivo" class="form-label">Motivo de la Consulta</label>
                            <textarea class="form-control" id="gridMotivo" rows="2" maxlength="500"
                                      placeholder="Motivo de la consulta (opcional)"></textarea>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-12">
                            <label for="gridNotas" class="form-label">Notas Internas</label>
                            <textarea class="form-control" id="gridNotas" rows="2" maxlength="1000"
                                      placeholder="Notas internas sobre la cita (opcional)"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardarCitaGrid">
                    <i class="bi bi-floppy me-1"></i>Actualizar Cita
                </button>
            </div>
        </div>
    </div>
</div>

@{/* ── MODAL: Confirmar cancelación desde grilla ────────────────── */}
<div class="modal fade" id="modalCancelarCitaGrid" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>Cancelar Cita
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    ¿Está seguro que desea cancelar la cita de
                    <strong id="cancelarCitaGridPaciente"></strong>?
                    <br><small class="text-muted">La cita no será eliminada, solo quedará cancelada.</small>
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-danger btn-sm text-white" id="btnConfirmarCancelarGrid">
                    <i class="bi bi-x-circle me-1"></i> Sí, cancelar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const URLS = {
        listar: '@jsonCitasUrl',
        actualizar: '@jsonActualizarUrl',
        cancelar: '@jsonCancelarUrl',
        desactivar: '@jsonDesactivarUrl',
        pacientes: '@jsonPacientesUrl',
        doctores: '@jsonDoctoresUrl',
        salas: '@jsonSalasUrl'
    };

    const ES_DOCTOR = '@(User.FindFirst("app_es_doctor")?.Value == "true" ? "true" : "false")' === 'true';

    const ESTADOS = {
        'agendada':    { label: 'Agendada',    icon: 'bi-calendar-plus' },
        'en_espera':   { label: 'En Espera',   icon: 'bi-clock' },
        'en_atencion': { label: 'En Atención', icon: 'bi-play-circle' },
        'atendida':    { label: 'Atendida',    icon: 'bi-check-circle' },
        'cancelada':   { label: 'Cancelada',   icon: 'bi-x-circle' }
    };

    let citas = [];
    let estadoFiltro = 'todos';
    let terminoBusqueda = '';
    let debounceTimer = null;

    document.addEventListener('DOMContentLoaded', function() {
        cargarCitas();
        inicializarResumen();
        inicializarBuscador();
        document.getElementById('filtroPeriodo').addEventListener('change', cargarCitas);
    });

    function inicializarResumen() {
        document.querySelectorAll('.resumen-card').forEach(card => {
            card.addEventListener('click', function() {
                estadoFiltro = this.dataset.estado;
                document.querySelectorAll('.resumen-card').forEach(c => c.classList.remove('resumen-activo'));
                this.classList.add('resumen-activo');
                actualizarBadge();
                renderGrid();
            });
        });
    }

    function inicializarBuscador() {
        const input = document.getElementById('buscarCita');
        if (!input) return;
        input.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                terminoBusqueda = this.value.trim().toLowerCase();
                renderGrid();
            }, 300);
        });
    }

    function fmtLocalDate(d) {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return y + '-' + m + '-' + day;
    }

    async function cargarCitas() {
        try {
            const periodo = document.getElementById('filtroPeriodo').value;
            let url = URLS.listar;

            if (periodo === 'hoy') {
                const hoy = fmtLocalDate(new Date());
                url += '?desde=' + hoy + '&hasta=' + hoy;
            } else if (periodo !== 'todas') {
                const hasta = new Date();
                const desde = new Date();
                desde.setDate(hasta.getDate() - parseInt(periodo));
                url += '?desde=' + fmtLocalDate(desde) + '&hasta=' + fmtLocalDate(hasta);
            }

            const res = await fetch(url, { headers: { 'Content-Type': 'application/json' } });
            if (!res.ok) {
                mostrarError('No se pudo conectar con el servidor.');
                return;
            }
            const json = await res.json();
            if (!json.success) {
                mostrarError(json.message || 'Error al cargar las citas.');
                return;
            }
            citas = json.data || [];
            renderResumen();
            renderGrid();
        } catch (err) {
            mostrarError('Error de conexión. Verifique su red e intente nuevamente.');
        }
    }

    function renderResumen() {
        const conteos = {
            todos: citas.length,
            agendada: 0, en_espera: 0, en_atencion: 0, atendida: 0, cancelada: 0
        };
        citas.forEach(c => {
            const est = c.estado || 'agendada';
            if (conteos[est] !== undefined) conteos[est]++;
        });
        Object.keys(conteos).forEach(k => {
            const el = document.querySelector(`[data-count="${k}"]`);
            if (el) el.textContent = conteos[k];
        });
    }

    function renderGrid() {
        const filtradas = citas.filter(c => {
            if (estadoFiltro !== 'todos' && (c.estado || 'agendada') !== estadoFiltro) return false;
            if (terminoBusqueda) {
                const paciente = (c.pacienteNombre || '').toLowerCase();
                const doctor = (c.doctorNombre || '').toLowerCase();
                if (!paciente.includes(terminoBusqueda) && !doctor.includes(terminoBusqueda)) return false;
            }
            return true;
        });

        actualizarContador(filtradas.length, citas.length);

        if (filtradas.length === 0) {
            document.getElementById('tablaContainer').innerHTML = `
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No se encontraron citas con los filtros seleccionados.
                </div>`;
            return;
        }

        const filas = filtradas.map(c => {
            const est = c.estado || 'agendada';
            const estInfo = ESTADOS[est] || { label: est, icon: 'bi-question-circle' };
            const fecha = c.fechaCita ? c.fechaCita.substring(0,10) : '';
            const fechaDisplay = fecha ? new Date(fecha + 'T12:00:00').toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) : '';
            const hora = c.horaCita ? String(c.horaCita).substring(0,5) : '';
            const horaFin = c.horaFin ? String(c.horaFin).substring(0,5) : '';
            const paciente = c.pacienteNombre || 'Sin nombre';
            const doctor = c.doctorNombre || 'Sin asignar';
            const sala = c.salaNombre || '—';

            // Columna de acciones: Editar y Cancelar según el estado de la cita.
            // No se permite editar/cancelar citas atendidas (consulta finalizada)
            // ni volver a cancelar una ya cancelada.
            const accionable = est !== 'atendida' && est !== 'cancelada';
            const botonCancelar = est === 'en_atencion'
                ? '' // en atención se gestiona desde la Cola de Espera (transiciones)
                : `<button type="button" class="btn btn-outline-danger btn-sm" onclick="mostrarModalCancelar('${c.id}')" title="Cancelar cita">
                       <i class="bi bi-x-circle"></i>
                   </button>`;
            const accionesHtml = accionable
                ? `<div class="d-flex gap-1 justify-content-end">
                       <button type="button" class="btn btn-outline-primary btn-sm" onclick="abrirEditarCita('${c.id}')" title="Editar cita">
                           <i class="bi bi-pencil"></i>
                       </button>
                       ${botonCancelar}
                   </div>`
                : '<span class="text-muted">—</span>';

            return `
            <tr>
                <td><strong>${escapeHtml(paciente)}</strong></td>
                <td class="text-muted">${escapeHtml(doctor)}</td>
                <td class="text-muted">${fechaDisplay}</td>
                <td class="text-muted">${hora}${horaFin ? ' — ' + horaFin : ''}</td>
                <td class="text-muted">${escapeHtml(sala)}</td>
                <td>
                    <span class="badge estado-badge estado-${est}">
                        <i class="bi ${estInfo.icon} me-1"></i>${estInfo.label}
                    </span>
                </td>
                <td class="text-end">${accionesHtml}</td>
            </tr>`;
        }).join('');

        document.getElementById('tablaContainer').innerHTML = `
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Paciente</th>
                            <th>Doctor</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Sala</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>${filas}</tbody>
                </table>
            </div>`;
    }

    function actualizarBadge() {
        const badge = document.getElementById('filtroActivoBadge');
        if (!badge) return;
        if (estadoFiltro === 'todos') {
            badge.style.display = 'none';
        } else {
            badge.textContent = 'Filtro: ' + (ESTADOS[estadoFiltro]?.label || estadoFiltro);
            badge.style.display = 'inline-block';
        }
    }

    function actualizarContador(mostrados, total) {
        const el = document.getElementById('contadorResultados');
        if (!el) return;
        if (estadoFiltro !== 'todos' || terminoBusqueda) {
            el.textContent = mostrados + ' de ' + total + ' citas';
        } else {
            el.textContent = total > 0 ? total + ' citas en el período' : '';
        }
    }

    function mostrarError(mensaje) {
        document.getElementById('tablaContainer').innerHTML = `
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>${escapeHtml(mensaje)}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <div class="text-center mt-3">
                <button class="btn btn-outline-primary btn-sm" onclick="cargarCitas()">
                    <i class="bi bi-arrow-clockwise me-1"></i> Reintentar
                </button>
            </div>`;
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // ── Columna de acciones: Editar / Cancelar ───────────────────
    let catalogosCargados = false;
    let idCancelandoGrid = null;

    async function cargarCatalogosGrid() {
        if (catalogosCargados) return;
        try {
            const [pacRes, docRes, salaRes] = await Promise.all([
                fetch(URLS.pacientes),
                fetch(URLS.doctores),
                fetch(URLS.salas)
            ]);
            const pacientesJson = await pacRes.json();
            const doctoresJson = await docRes.json();
            const salasJson = await salaRes.json();

            const selPaciente = document.getElementById('gridPacienteId');
            selPaciente.innerHTML = '<option value="">-- Buscar o seleccionar paciente --</option>';
            (pacientesJson.data || []).forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.id || '';
                opt.textContent = p.nombreCompleto || p.primerNombre + ' ' + p.primerApellido || 'Paciente';
                selPaciente.appendChild(opt);
            });

            const selDoctor = document.getElementById('gridDoctorId');
            selDoctor.innerHTML = '<option value="">-- Seleccionar doctor --</option>';
            (doctoresJson.data || []).forEach(d => {
                const opt = document.createElement('option');
                opt.value = d.id || d.usuarioId || '';
                opt.textContent = d.nombreCompleto || d.nombres + ' ' + d.apellidos || 'Doctor';
                selDoctor.appendChild(opt);
            });

            const selSala = document.getElementById('gridSalaId');
            selSala.innerHTML = '<option value="">-- Sin sala --</option>';
            (salasJson.data || []).forEach(s => {
                const opt = document.createElement('option');
                opt.value = s.id || '';
                opt.textContent = s.nombre || 'Sala';
                selSala.appendChild(opt);
            });

            catalogosCargados = true;
        } catch (err) {
            console.error('Error cargando catálogos para editar cita:', err);
        }
    }

    function toTimeInputValue(val) {
        if (!val) return '';
        const s = String(val);
        return s.length >= 5 ? s.substring(0, 5) : s;
    }

    async function abrirEditarCita(id) {
        const cita = citas.find(c => c.id === id);
        if (!cita) return;

        // Bloquear edición de citas atendidas (consulta finalizada)
        if (cita.estado === 'atendida') {
            mostrarToast('La cita ya fue atendida y no se puede modificar.', 'warning');
            return;
        }

        await cargarCatalogosGrid();

        document.getElementById('gridCitaId').value = cita.id;
        document.getElementById('gridPacienteId').value = cita.pacienteId || '';
        document.getElementById('gridDoctorId').value = ES_DOCTOR ? '@User.FindFirstValue(ClaimTypes.NameIdentifier)' : (cita.doctorId || '');
        document.getElementById('gridFecha').value = cita.fechaCita ? cita.fechaCita.substring(0, 10) : '';
        document.getElementById('gridHora').value = toTimeInputValue(cita.horaCita);
        document.getElementById('gridHoraFin').value = toTimeInputValue(cita.horaFin);
        document.getElementById('gridSalaId').value = cita.salaId || '';
        document.getElementById('gridLugar').value = cita.lugar || '';
        document.getElementById('gridEstado').value = cita.estado || 'agendada';
        document.getElementById('gridMotivo').value = cita.motivo || '';
        document.getElementById('gridNotas').value = cita.notas || '';

        const modal = new bootstrap.Modal(document.getElementById('modalEditarCitaGrid'));
        modal.show();
    }

    async function guardarCitaGrid() {
        const form = document.getElementById('formCitaGrid');
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return;
        }

        const id = document.getElementById('gridCitaId').value;
        if (!id) { mostrarToast('Error: no se pudo identificar la cita.', 'danger'); return; }

        const payload = {
            pacienteId: document.getElementById('gridPacienteId').value || '00000000-0000-0000-0000-000000000000',
            doctorId: document.getElementById('gridDoctorId').value || '00000000-0000-0000-0000-000000000000',
            salaId: document.getElementById('gridSalaId').value || null,
            fechaCita: document.getElementById('gridFecha').value,
            horaCita: document.getElementById('gridHora').value,
            horaFin: document.getElementById('gridHoraFin').value || null,
            lugar: document.getElementById('gridLugar').value || null,
            motivo: document.getElementById('gridMotivo').value || null,
            estado: document.getElementById('gridEstado').value,
            notas: document.getElementById('gridNotas').value || null
        };

        const btn = document.getElementById('btnGuardarCitaGrid');
        const textoOriginal = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

        try {
            const res = await fetch(URLS.actualizar + '?id=' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const json = await res.json();

            if (res.ok && json.success) {
                bootstrap.Modal.getInstance(document.getElementById('modalEditarCitaGrid')).hide();
                mostrarToast(json.message || 'Cita actualizada exitosamente', 'success');
                await cargarCitas();
            } else {
                mostrarToast(json.message || 'Error al actualizar la cita', 'danger');
            }
        } catch (err) {
            mostrarToast('Error de conexión al actualizar.', 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = textoOriginal;
        }
    }

    function mostrarModalCancelar(id) {
        const cita = citas.find(c => c.id === id);
        if (!cita) return;
        idCancelandoGrid = id;
        document.getElementById('cancelarCitaGridPaciente').textContent = cita.pacienteNombre || 'Sin nombre';
        const modal = new bootstrap.Modal(document.getElementById('modalCancelarCitaGrid'));
        modal.show();
    }

    async function cancelarCitaGrid() {
        if (!idCancelandoGrid) return;

        const btn = document.getElementById('btnConfirmarCancelarGrid');
        const textoOriginal = btn.innerHTML;
        btn.disabled = true;

        try {
            // Cancelación de negocio: marca la cita como 'cancelada' (PUT estado).
            // La cita NO se desactiva: permanece visible en el historial y puede reprogramarse.
            const res = await fetch(`${URLS.cancelar}?id=${idCancelandoGrid}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const json = await res.json();

            if (res.ok && json.success) {
                bootstrap.Modal.getInstance(document.getElementById('modalCancelarCitaGrid')).hide();
                mostrarToast(json.message || 'Cita cancelada exitosamente', 'warning');
                idCancelandoGrid = null;
                await cargarCitas();
            } else {
                mostrarToast(json.message || 'Error al cancelar la cita', 'danger');
            }
        } catch (err) {
            mostrarToast('Error de conexión al cancelar.', 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = textoOriginal;
        }
    }

    function mostrarToast(mensaje, tipo) {
        let container = document.getElementById('gridToastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'gridToastContainer';
            container.className = 'position-fixed top-0 end-0 p-3';
            container.style.zIndex = '1080';
            document.body.appendChild(container);
        }
        const toast = document.createElement('div');
        toast.className = `alert alert-${tipo} alert-dismissible fade show shadow-sm`;
        toast.innerHTML = `${mensaje}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 5000);
    }

    // ── Inicialización de acciones ─────────────────────────────
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('btnGuardarCitaGrid').addEventListener('click', guardarCitaGrid);
        document.getElementById('btnConfirmarCancelarGrid').addEventListener('click', cancelarCitaGrid);
    });
</script>
}

