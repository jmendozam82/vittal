@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = "Beneficios - Software Vittal";
}

<!-- ════════════════════════════════════════════════════════════════
     PAGE HEADER
     ════════════════════════════════════════════════════════════════ -->
<section class="landing-hero" style="min-height: 40vh; padding: 6rem 0 3rem;">
    <div class="container text-center">
        <div class="hero-badge">Beneficios</div>
        <h1 class="hero-title" style="font-size: 2.5rem;">
            Beneficios para <span class="highlight">cada rol</span>
        </h1>
        <p class="hero-subtitle mx-auto">
            Vittal está diseñado para potenciar el trabajo de cada miembro
            de tu clínica, desde la dirección hasta la recepción.
        </p>
    </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     BENEFICIOS POR ROL
     ════════════════════════════════════════════════════════════════ -->
<section class="landing-benefits">
    <div class="container">
        <div class="row g-4">
            <!-- Director -->
            <div class="col-lg-6">
                <div class="benefit-card">
                    <div class="benefit-img-container">
                        <img src="~/images/landing/benefits/director.png" alt="Beneficios para Directores" loading="lazy" />
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="benefit-role-icon director me-3 mb-0" style="width: 48px; height: 48px; font-size: 1.2rem;">
                            <i class="bi bi-briefcase"></i>
                        </div>
                        <h5 class="mb-0">Directores</h5>
                    </div>
                    <p class="text-muted small mb-3">
                        Control total de la operación con datos en tiempo real
                        para la toma de decisiones estratégicas.
                    </p>
                    <ul>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Dashboard ejecutivo con métricas clave de la clínica
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Reportes de ingresos, productividad y ocupación
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Cumplimiento normativo y auditoría de operaciones
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Visibilidad completa de todas las áreas
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Toma de decisiones basada en datos reales
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Gerente -->
            <div class="col-lg-6">
                <div class="benefit-card">
                    <div class="benefit-img-container">
                        <img src="~/images/landing/benefits/gerente.png" alt="Beneficios para Gerentes" loading="lazy" />
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="benefit-role-icon gerente me-3 mb-0" style="width: 48px; height: 48px; font-size: 1.2rem;">
                            <i class="bi bi-people"></i>
                        </div>
                        <h5 class="mb-0">Gerentes</h5>
                    </div>
                    <p class="text-muted small mb-3">
                        Gestión eficiente del personal, inventario y operación
                        diaria de la clínica.
                    </p>
                    <ul>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Gestión de usuarios, perfiles y permisos
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Control de salas y asignación de doctores
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Reportes de productividad por doctor
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Configuración de alertas y tiempos de espera
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Administración de catálogos médicos
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Doctor -->
            <div class="col-lg-6">
                <div class="benefit-card">
                    <div class="benefit-img-container">
                        <img src="~/images/landing/benefits/doctor.png" alt="Beneficios para Doctores" loading="lazy" />
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="benefit-role-icon doctor me-3 mb-0" style="width: 48px; height: 48px; font-size: 1.2rem;">
                            <i class="bi bi-heart-pulse"></i>
                        </div>
                        <h5 class="mb-0">Doctores</h5>
                    </div>
                    <p class="text-muted small mb-3">
                        Acceso rápido y eficiente a todo lo necesario para
                        la atención médica diaria.
                    </p>
                    <ul>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Expediente clínico completo del paciente
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Agenda personal con citas del día
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Cola de espera en tiempo real
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Recetario electrónico con impresión de recetas
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Registro de diagnósticos, tratamientos y exámenes
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Línea de tiempo del paciente por consulta
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Recepcionista -->
            <div class="col-lg-6">
                <div class="benefit-card">
                    <div class="benefit-img-container">
                        <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80" alt="Software de gestión y citas para recepción" loading="lazy" />
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="benefit-role-icon recepcion me-3 mb-0" style="width: 48px; height: 48px; font-size: 1.2rem;">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <h5 class="mb-0">Recepcionistas</h5>
                    </div>
                    <p class="text-muted small mb-3">
                        Herramientas ágiles para la gestión de citas y
                        el flujo de pacientes.
                    </p>
                    <ul>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Registro rápido de pacientes
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Gestión de citas y asignación a doctores
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Control de cola de espera
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Búsqueda de pacientes por nombre o expediente
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Visualización del flujo de atención
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     ADDITIONAL BENEFITS
     ════════════════════════════════════════════════════════════════ -->
<section class="landing-features">
    <div class="container">
        <div class="section-header">
            <div class="section-badge">Ventajas</div>
            <h2>¿Por qué elegir Vittal?</h2>
            <p>
                Nuestra plataforma está construida con tecnología moderna
                para ofrecer la mejor experiencia.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-center">
                    <div class="feature-icon blue mx-auto mb-3">
                        <i class="bi bi-cloud-check"></i>
                    </div>
                    <h5 class="fw-bold mb-2">100% en la Nube</h5>
                    <p class="text-muted small">
                        Accede desde cualquier dispositivo con internet.
                        Sin instalaciones ni mantenimiento de servidores.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <div class="feature-icon green mx-auto mb-3">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Datos Seguros</h5>
                    <p class="text-muted small">
                        Cifrado de extremo a extremo, RLS multi-tenant y
                        cumplimiento con normativas de protección de datos.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <div class="feature-icon orange mx-auto mb-3">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Actualizaciones Continuas</h5>
                    <p class="text-muted small">
                        Nuevas funcionalidades y mejoras cada mes sin
                        interrupciones en tu operación.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     CTA
     ════════════════════════════════════════════════════════════════ -->
<section class="landing-benefits">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="fw-bold mb-3" style="color: var(--landing-dark);">
                    Comienza a transformar tu clínica hoy
                </h2>
                <p class="text-muted mb-4" style="font-size: 1.1rem;">
                    Solicita una demo sin compromiso y descubre todo lo que
                    Vittal puede hacer por tu equipo.
                </p>
                <a href="/Landing/Landing/Contacto" class="hero-cta-primary">
                    <i class="bi bi-rocket-takeoff"></i> Solicitar demo
                </a>
            </div>
        </div>
    </div>
</section>
