@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = "Mensaje Enviado - Software Vittal";
}

<!-- ════════════════════════════════════════════════════════════════
     SUCCESS PAGE
     ════════════════════════════════════════════════════════════════ -->
<section class="landing-success">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="success-card contact-card text-center">
                    <div class="success-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-2" style="color: var(--landing-dark);">
                        ¡Mensaje enviado con éxito!
                    </h3>
                    <p class="text-muted mb-4" style="font-size: 1.05rem;">
                        Gracias por contactarnos. Hemos recibido tu mensaje y
                        nuestro equipo te responderá a la brevedad posible.
                    </p>
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                        <a href="/Landing/Landing" class="hero-cta-primary justify-content-center">
                            <i class="bi bi-house"></i> Volver al inicio
                        </a>
                        <a href="/Landing/Landing/Funcionalidades" class="hero-cta-secondary justify-content-center">
                            <i class="bi bi-info-circle"></i> Ver funcionalidades
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
