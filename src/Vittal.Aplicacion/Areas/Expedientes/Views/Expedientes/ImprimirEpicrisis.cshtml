@model Vittal.Aplicacion.Areas.Expedientes.Controllers.EpicrisisViewModel
@{
    Layout = null;
    var fechaFormateada = DateTime.TryParse(Model.FechaConsulta, out var dt)
        ? dt.ToString("dd/MM/yyyy")
        : Model.FechaConsulta;
    var dxPrincipal = Model.Diagnosticos.FirstOrDefault(d => d.EsPrincipal);
    var dxSecundarios = Model.Diagnosticos.Where(d => !d.EsPrincipal).ToList();
    var nombrePdf = "Epicrisis_" + System.Text.RegularExpressions.Regex.Replace(Model.PacienteNombre ?? "paciente", "[^A-Za-z0-9 ]", "").Replace(" ", "_");
    var hayContacto = !string.IsNullOrWhiteSpace(Model.ClinicaDireccion)
        || !string.IsNullOrWhiteSpace(Model.ClinicaTelefono)
        || !string.IsNullOrWhiteSpace(Model.ClinicaEmail);
    var hayAntecedentes = Model.Antecedentes.Count > 0;
    var haySignosVitales = Model.SignosVitales.Count > 0;
    var hayProcedimientos = Model.Cirugias.Count > 0 || Model.Examenes.Count > 0;
    var tipoDocLabel = Model.PacienteTipoDocumento switch
    {
        "CC" => "Cédula de Ciudadanía",
        "CR" => "Cédula de Residencia",
        "PA" => "Pasaporte",
        var t when !string.IsNullOrWhiteSpace(t) => t,
        _ => ""
    };
    var docPaciente = string.IsNullOrWhiteSpace(tipoDocLabel)
        ? (Model.PacienteDocumento ?? "")
        : $"{tipoDocLabel} {Model.PacienteDocumento}".Trim();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Epicrisis - @Model.PacienteNombre</title>
    <style>
        /* ── Reset y configuración general ─────────────────────────── */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 13px;
            color: #222;
            padding: 75px 30px 30px;
            line-height: 1.6;
            background: #f4f6f8;
        }
        .documento {
            max-width: 850px;
            margin: 0 auto;
            border: 1.5px solid #1a365d;
            border-radius: 4px;
            background: #fff;
            padding: 28px 34px;
            min-height: 1000px;
            position: relative;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        }

        /* ── Encabezado homogéneo (logo + clínica + título + meta) ─── */
        .header {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 18px;
            border-bottom: 3px double #1a365d;
            padding-bottom: 12px;
            margin-bottom: 8px;
        }
        .header .logo {
            max-height: 72px;
            max-width: 130px;
            object-fit: contain;
        }
        .header .titulo-area { text-align: center; }
        .header .titulo-area .clinica {
            font-size: 17px;
            font-weight: bold;
            color: #1a365d;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .header .titulo-area h1 {
            font-size: 21px;
            font-weight: bold;
            color: #1a365d;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 2px;
        }
        .header .titulo-area .subtitle { font-size: 11px; color: #666; margin-top: 2px; }
        .header .meta-area {
            text-align: right;
            font-size: 10.5px;
            color: #555;
            line-height: 1.7;
        }
        .header .meta-area .numero {
            font-weight: bold;
            color: #1a365d;
            font-size: 11.5px;
        }
        .header-contacto {
            font-size: 10px;
            color: #666;
            text-align: center;
            padding: 5px 0 10px;
            border-bottom: 1px solid #dee2e6;
            margin-bottom: 20px;
        }

        /* ── Datos del paciente ────────────────────────────────────── */
        .datos {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px 24px;
            margin-bottom: 18px;
            padding: 12px 14px;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 6px;
        }
        .campo { display: flex; gap: 6px; }
        .campo label {
            font-weight: bold;
            font-size: 10.5px;
            text-transform: uppercase;
            color: #6c757d;
            white-space: nowrap;
            padding-top: 1px;
        }
        .campo .valor { font-size: 13px; }

        /* ── Secciones ─────────────────────────────────────────────── */
        .seccion { margin-bottom: 18px; }
        .seccion h2 {
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            color: #1a365d;
            border-bottom: 2px solid #1a365d;
            padding-bottom: 4px;
            margin-bottom: 10px;
            letter-spacing: 1px;
        }
        .seccion .texto { font-size: 13px; text-align: justify; line-height: 1.7; }
        .seccion ul { list-style: none; padding-left: 0; }
        .seccion ul li { padding: 3px 0 3px 18px; position: relative; }
        .seccion ul li::before {
            content: "•";
            position: absolute;
            left: 4px;
            color: #1a365d;
            font-weight: bold;
        }

        /* ── Diagnósticos ──────────────────────────────────────────── */
        .dx-principal {
            padding: 10px 12px;
            background: #ebf5ff;
            border-left: 4px solid #1a365d;
            margin-bottom: 8px;
            border-radius: 0 4px 4px 0;
        }
        .dx-principal strong { color: #1a365d; }
        .dx-secundario {
            padding: 6px 10px;
            background: #f8f9fa;
            border-left: 3px solid #6c757d;
            margin-bottom: 6px;
            border-radius: 0 4px 4px 0;
            font-size: 12.5px;
        }

        /* ── Signos vitales ────────────────────────────────────────── */
        .grid-signos {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px 16px;
            margin-bottom: 4px;
        }
        .signo {
            display: flex;
            gap: 6px;
            padding: 7px 10px;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            font-size: 12.5px;
        }
        .signo label {
            font-weight: bold;
            font-size: 10px;
            text-transform: uppercase;
            color: #6c757d;
            white-space: nowrap;
            padding-top: 1px;
        }
        .signo .valor strong { color: #1a365d; }
        .signo.fuera { background: #fff3cd; border-color: #ffc107; }
        .signo.fuera .alerta { color: #856404; font-size: 10.5px; }

        /* ── Antecedentes ──────────────────────────────────────────── */
        .antecedentes { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 24px; }
        .antecedentes .campo { display: flex; gap: 6px; }
        .antecedentes .campo label {
            font-weight: bold;
            font-size: 10.5px;
            text-transform: uppercase;
            color: #6c757d;
            white-space: nowrap;
            padding-top: 1px;
        }
        .antecedentes .campo .valor { font-size: 12.5px; }

        .sin-items {
            text-align: center;
            padding: 12px;
            color: #999;
            font-style: italic;
            font-size: 12px;
        }

        /* ── Firma ─────────────────────────────────────────────────── */
        .firma {
            margin-top: 55px;
            padding-top: 18px;
            border-top: 1px solid #ccc;
            display: flex;
            justify-content: space-between;
            align-items: end;
        }
        .firma .doctor-info { text-align: center; }
        .firma .linea-firma {
            width: 250px;
            border-top: 1px solid #000;
            margin: 5px auto;
            padding-top: 3px;
        }
        .firma .sello { font-size: 11px; color: #666; text-align: right; }

        /* ── Pie de página ─────────────────────────────────────────── */
        .footer {
            position: absolute;
            bottom: 18px;
            left: 34px;
            right: 34px;
            text-align: center;
            font-size: 10px;
            color: #6c757d;
            border-top: 1px solid #dee2e6;
            padding-top: 8px;
            line-height: 1.6;
        }
        .footer .importante { font-size: 9px; color: #adb5bd; }

        /* ── Barra de acciones (solo pantalla, se oculta al imprimir) ── */
        .toolbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 10px 20px;
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
        }
        .toolbar .toolbar-title { font-size: 14px; font-weight: bold; color: #1a365d; }
        .toolbar button {
            padding: 8px 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            border-radius: 6px;
            margin-left: 8px;
        }
        .toolbar .btn-pdf { background: #198754; color: #fff; }
        .toolbar .btn-pdf:hover { background: #157347; }
        .toolbar .btn-imprimir { background: #1a365d; color: #fff; }
        .toolbar .btn-imprimir:hover { background: #0f2440; }

        /* ── Estilos de impresión ──────────────────────────────────── */
        @@media print {
            body { padding: 0; font-size: 12px; background: #fff; }
            .documento {
                border: none;
                border-radius: 0;
                box-shadow: none;
                padding: 18px 22px;
                max-width: 100%;
                min-height: auto;
            }
            .no-print { display: none; }
            .datos { background: #f8f9fa !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .dx-principal { background: #ebf5ff !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .signo { background: #f8f9fa !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .signo.fuera { background: #fff3cd !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .footer { position: fixed; bottom: 10px; left: 22px; right: 22px; }
            @@page { margin: 15mm 10mm; }
        }
    </style>
</head>
<body>

    <!-- Barra de acciones (solo en pantalla) -->
    <div class="toolbar no-print">
        <span class="toolbar-title">Epicrisis — @Model.PacienteNombre</span>
        <div>
            <button class="btn-pdf" id="btnPdf" onclick="descargarPdf()">⬇️ Descargar PDF</button>
            <button class="btn-imprimir" onclick="window.print()">🖨️ Imprimir</button>
        </div>
    </div>

    <div class="documento">

        <!-- ═══ ENCABEZADO ═══ -->
        <div class="header">
            <div class="logo-area">
                @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                {
                    <img class="logo" src="@Model.LogoUrl" alt="Logo de @Model.ClinicaNombre" onerror="this.style.display='none'" />
                }
            </div>
            <div class="titulo-area">
                <div class="clinica">@Model.ClinicaNombre</div>
                <h1>Epicrisis</h1>
                <div class="subtitle">Resumen Clínico de Atención Médica</div>
            </div>
            <div class="meta-area">
                <div class="numero">No. @Model.NumeroDocumento</div>
                <div>Fecha de consulta: @fechaFormateada</div>
            </div>
        </div>
        @if (hayContacto)
        {
            <div class="header-contacto">
                @Model.ClinicaDireccion
                @if (!string.IsNullOrWhiteSpace(Model.ClinicaTelefono)) { <span> · Tel: @Model.ClinicaTelefono</span> }
                @if (!string.IsNullOrWhiteSpace(Model.ClinicaEmail)) { <span> · @Model.ClinicaEmail</span> }
            </div>
        }

        <!-- ═══ DATOS DEL PACIENTE ═══ -->
        <div class="datos">
            <div class="campo"><label>Paciente:</label><div class="valor">@Model.PacienteNombre</div></div>
            <div class="campo"><label>Médico:</label><div class="valor">@Model.DoctorNombre</div></div>
            @if (!string.IsNullOrWhiteSpace(docPaciente))
            {
                <div class="campo"><label>Documento:</label><div class="valor">@docPaciente</div></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.PacienteEdad) || !string.IsNullOrWhiteSpace(Model.PacienteSexo))
            {
                <div class="campo">
                    <label>Edad / Sexo:</label>
                    <div class="valor">
                        @Model.PacienteEdad@(!string.IsNullOrWhiteSpace(Model.PacienteEdad) && !string.IsNullOrWhiteSpace(Model.PacienteSexo) ? " · " : "")@Model.PacienteSexo
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.PacienteEmail) || !string.IsNullOrWhiteSpace(Model.PacienteCelular))
            {
                <div class="campo">
                    <label>Contacto:</label>
                    <div class="valor">
                        @Model.PacienteEmail@(!string.IsNullOrWhiteSpace(Model.PacienteEmail) && !string.IsNullOrWhiteSpace(Model.PacienteCelular) ? " · " : "")@Model.PacienteCelular
                    </div>
                </div>
            }
        </div>

        <!-- ═══ MOTIVO DE CONSULTA ═══ -->
        @if (!string.IsNullOrWhiteSpace(Model.MotivoConsulta))
        {
            <div class="seccion">
                <h2>Motivo de Consulta</h2>
                <div class="texto">@Model.MotivoConsulta</div>
            </div>
        }

        <!-- ═══ SIGNOS VITALES ═══ -->
        @if (haySignosVitales)
        {
            <div class="seccion">
                <h2>Signos Vitales</h2>
                <div class="grid-signos">
                    @foreach (var sv in Model.SignosVitales)
                    {
                        <div class="signo @(sv.FueraDeRango ? "fuera" : "")">
                            <label>@sv.Nombre:</label>
                            <div class="valor">
                                <strong>@sv.Valor</strong> @sv.Unidad
                                @if (sv.FueraDeRango)
                                {
                                    <div class="alerta">⚠ Fuera de rango</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ═══ ANTECEDENTES DEL PACIENTE ═══ -->
        @if (hayAntecedentes)
        {
            <div class="seccion">
                <h2>Antecedentes del Paciente</h2>
                <div class="antecedentes">
                    @foreach (var a in Model.Antecedentes)
                    {
                        <div class="campo">
                            <label>@a.Nombre:</label>
                            <div class="valor">@a.Valor</div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ═══ DIAGNÓSTICOS ═══ -->
        <div class="seccion">
            <h2>Diagnósticos</h2>
            @if (dxPrincipal != null)
            {
                <div class="dx-principal">
                    <strong>Diagnóstico principal:</strong> @dxPrincipal.TipoNombre
                    @if (!string.IsNullOrWhiteSpace(dxPrincipal.DiagnosticoNombre)) { <span> — @dxPrincipal.DiagnosticoNombre</span> }
                    @if (!string.IsNullOrWhiteSpace(dxPrincipal.Observaciones)) { <div style="font-size:12px;color:#555;margin-top:4px;">@dxPrincipal.Observaciones</div> }
                </div>
            }
            @if (dxSecundarios.Count > 0)
            {
                foreach (var dx in dxSecundarios)
                {
                    <div class="dx-secundario">
                        <strong>Secundario:</strong> @dx.TipoNombre
                        @if (!string.IsNullOrWhiteSpace(dx.DiagnosticoNombre)) { <span> — @dx.DiagnosticoNombre</span> }
                        @if (!string.IsNullOrWhiteSpace(dx.Observaciones)) { <div style="font-size:11.5px;color:#666;">@dx.Observaciones</div> }
                    </div>
                }
            }
            @if (Model.Diagnosticos.Count == 0)
            {
                <div class="sin-items">No se registraron diagnósticos en la consulta.</div>
            }
        </div>

        <!-- ═══ TRATAMIENTOS ═══ -->
        <div class="seccion">
            <h2>Tratamiento Indicado</h2>
            @if (Model.Tratamientos.Count > 0)
            {
                <ul>
                    @foreach (var t in Model.Tratamientos)
                    {
                        <li>@t</li>
                    }
                </ul>
            }
            else
            {
                <div class="sin-items">No se registraron tratamientos.</div>
            }
        </div>

        <!-- ═══ PROCEDIMIENTOS (CIRUGÍAS / EXÁMENES) ═══ -->
        @if (hayProcedimientos)
        {
            <div class="seccion">
                <h2>Procedimientos y Exámenes Realizados</h2>
                @if (Model.Cirugias.Count > 0)
                {
                    <h3 style="font-size:12px;text-transform:uppercase;color:#6c757d;margin:6px 0 4px;">Cirugías / Procedimientos</h3>
                    <ul>
                        @foreach (var c in Model.Cirugias)
                        {
                            <li>@c</li>
                        }
                    </ul>
                }
                @if (Model.Examenes.Count > 0)
                {
                    <h3 style="font-size:12px;text-transform:uppercase;color:#6c757d;margin:8px 0 4px;">Exámenes</h3>
                    <ul>
                        @foreach (var e in Model.Examenes)
                        {
                            <li>@e</li>
                        }
                    </ul>
                }
            </div>
        }

        <!-- ═══ RECOMENDACIONES ═══ -->
        @if (Model.Recomendaciones.Count > 0)
        {
            <div class="seccion">
                <h2>Recomendaciones de Egreso</h2>
                <ul>
                    @foreach (var r in Model.Recomendaciones)
                    {
                        <li>@r</li>
                    }
                </ul>
            </div>
        }

        <!-- ═══ NOTAS DE CONSULTA ═══ -->
        @if (!string.IsNullOrWhiteSpace(Model.NotasConsulta))
        {
            <div class="seccion">
                <h2>Notas de Consulta</h2>
                <div class="texto">@Model.NotasConsulta</div>
            </div>
        }

        <div class="seccion texto" style="font-size:11.5px;color:#6c757d;">
            El presente documento resume la atención médica brindada al paciente en la fecha indicada.
            Los datos clínicos aquí consignados son responsabilidad del profesional tratante y forman
            parte del expediente clínico institucional. Se recomienda al paciente conservar este
            resumen y presentarlo en futuras consultas.
        </div>

        <!-- ═══ FIRMA ═══ -->
        <div class="firma">
            <div class="sello">
                Documento válido como<br/>epicrisis médica oficial
            </div>
            <div class="doctor-info">
                <div style="margin-bottom:5px;font-size:12px;">Firma y sello del médico tratante</div>
                <div class="linea-firma"></div>
                <div style="font-size:13px;font-weight:bold;">@Model.DoctorNombre</div>
            </div>
        </div>

        <!-- ═══ PIE ═══ -->
        <div class="footer">
            <div>
                @Model.ClinicaNombre
                @if (!string.IsNullOrWhiteSpace(Model.ClinicaDireccion)) { <span> — @Model.ClinicaDireccion</span> }
                @if (!string.IsNullOrWhiteSpace(Model.ClinicaTelefono)) { <span> · Tel: @Model.ClinicaTelefono</span> }
                @if (!string.IsNullOrWhiteSpace(Model.ClinicaEmail)) { <span> · @Model.ClinicaEmail</span> }
            </div>
            <div class="importante">Documento generado por Sistema Médico Vittal · Válido únicamente con firma y sello del médico tratante.</div>
        </div>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        // Descarga el documento como PDF (A4, multipágina) usando html2canvas + jsPDF.
        // Si las librerías CDN no cargan (sin internet), cae al diálogo "Guardar como PDF" del navegador.
        function descargarPdf() {
            const btn = document.getElementById('btnPdf');
            if (typeof html2canvas === 'undefined' || typeof window.jspdf === 'undefined') {
                window.print();
                return;
            }
            btn.disabled = true;
            const textoOriginal = btn.textContent;
            btn.textContent = '⏳ Generando PDF...';
            const elemento = document.querySelector('.documento');
            html2canvas(elemento, { scale: 2, useCORS: true, backgroundColor: '#ffffff' })
                .then(canvas => {
                    const { jsPDF } = window.jspdf;
                    const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
                    const pageW = pdf.internal.pageSize.getWidth();
                    const pageH = pdf.internal.pageSize.getHeight();
                    const imgH = (canvas.height * pageW) / canvas.width;
                    let heightLeft = imgH;
                    let position = 0;
                    pdf.addImage(canvas.toDataURL('image/png'), 'PNG', 0, position, pageW, imgH);
                    heightLeft -= pageH;
                    while (heightLeft > 0) {
                        position = heightLeft - imgH;
                        pdf.addPage();
                        pdf.addImage(canvas.toDataURL('image/png'), 'PNG', 0, position, pageW, imgH);
                        heightLeft -= pageH;
                    }
                    pdf.save('@nombrePdf' + '.pdf');
                    btn.disabled = false;
                    btn.textContent = textoOriginal;
                })
                .catch(() => {
                    btn.disabled = false;
                    btn.textContent = textoOriginal;
                    window.print();
                });
        }
    </script>

</body>
</html>
