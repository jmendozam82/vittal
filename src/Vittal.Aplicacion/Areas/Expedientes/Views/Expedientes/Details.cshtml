    // ─── SIGNOS VITALES (HU-E06) ───
    let svTipos = [];
    window.abrirModalSignosVitales = async function(hojaCitaId) {
        if (bloquearSiFinalizada(hojaCitaId)) return;
        document.getElementById('svHojaCitaId').value = hojaCitaId;
        document.getElementById('svSalaInfo').classList.add('d-none');
        const container = document.getElementById('svFormContainer');
        container.innerHTML = '<div class="d-flex justify-content-center p-4"><div class="spinner-border text-danger"></div></div>';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalSignosVitales')).show();

        try {
            // 1) Resolver la sala de la hoja (la cita asociada define la especialidad)
            const salaRes = await fetch(`${URLS.salaDeHoja}?hojaCitaId=${hojaCitaId}`);
            const salaJson = await salaRes.json();
            if (!salaJson.success || !salaJson.salaId) {
                container.innerHTML = '<div class="alert alert-warning w-100">' + (salaJson.message || 'No se pudo determinar la sala de la hoja.') + '</div>';
                return;
            }
            document.getElementById('svSalaInfo').innerHTML = '<i class="bi bi-building me-1"></i>Especialidad: <strong>' + escapeHtml(salaJson.salaNombre || 'Sala') + '</strong>';
            document.getElementById('svSalaInfo').classList.remove('d-none');

            // 2) Tipos de signos vitales configurados para esa sala
            const tipoRes = await fetch(`${URLS.tiposSignoVital}?salaId=${salaJson.salaId}`);
            const tipoJson = await tipoRes.json();
            svTipos = (tipoJson.success ? (tipoJson.data || []) : []);
            if (svTipos.length === 0) {
                container.innerHTML = '<div class="alert alert-warning w-100">Esta especialidad no tiene tipos de signos vitales configurados.</div>';
                return;
            }

            container.innerHTML = '';
            svTipos.forEach((t, i) => {
                const col = document.createElement('div');
                col.className = 'col-md-6';
                const rango = (t.valorMin != null && t.valorMax != null)
                    ? `<small class="text-muted d-block">Normal: ${t.valorMin} – ${t.valorMax} ${t.unidad || ''}</small>`
                    : (t.unidad ? `<small class="text-muted d-block">Unidad: ${escapeHtml(t.unidad)}</small>` : '');
                col.innerHTML = `
                    <label class="form-label fw-semibold" for="sv_${i}">
                        ${escapeHtml(t.nombre)}${t.esObligatorio ? ' <span class="text-danger">*</span>' : ''}
                    </label>
                    <div class="input-group mb-1">
                        <input type="number" step="any" min="0" class="form-control" id="sv_${i}" data-tipo="${t.id}" ${t.esObligatorio ? 'required' : ''} placeholder="${escapeHtml(t.unidad || 'Valor')}">
                        ${t.unidad ? `<span class="input-group-text">${escapeHtml(t.unidad)}</span>` : ''}
                    </div>
                    ${rango}`;
                container.appendChild(col);
            });
        } catch (err) {
            container.innerHTML = '<div class="alert alert-danger w-100">Error de conexión al cargar tipos de signos vitales.</div>';
        }
    };

    document.getElementById('btnGuardarSignosVitales').addEventListener('click', async function() {
        const hojaCitaId = document.getElementById('svHojaCitaId').value;
        const items = [];
        let completo = true;
        svTipos.forEach((t, i) => {
            const input = document.getElementById('sv_' + i);
            if (!input) return;
            const val = input.value.trim();
            if (t.esObligatorio && val === '') { completo = false; }
            if (val === '') return;
            items.push({ tipoSignoVitalId: t.id, valor: parseFloat(val), unidad: t.unidad || null });
        });
        if (!completo) { showToast('danger', 'Complete los signos vitales obligatorios (*).'); return; }
        if (items.length === 0) { showToast('danger', 'Ingrese al menos un signo vital.'); return; }

        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';
        try {
            const res = await fetch(URLS.guardarSignosVitales, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ hojaCitaId: hojaCitaId, items: items })
