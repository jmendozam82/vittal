    // --- AGREGAR RECOMENDACIÓN ---
    window.abrirModalRecomendacion = function(hojaCitaId) {
        document.getElementById('recHojaCitaId').value = hojaCitaId;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAgregarRecomendacion')).show();
    };

    document.getElementById('btnGuardarRecomendacion').addEventListener('click', async function() {
        const hojaCitaId = document.getElementById('recHojaCitaId').value;
        const recomendacionId = document.getElementById('recRecomendacionId').value;
        if (!recomendacionId) { showToast('danger', 'Seleccione una recomendación.'); return; }

        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';

        try {
            const res = await fetch(URLS.crearRecomendacion, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    hojaCitaId: hojaCitaId,
                    recomendacionId: recomendacionId,
                    observaciones: document.getElementById('recObservaciones').value.trim() || null
                })
            });
            const json = await res.json();
            if (res.ok && json.success) {
                showToast('success', 'Recomendación agregada.');
                bootstrap.Modal.getInstance(document.getElementById('modalAgregarRecomendacion')).hide();
                await cargarRecomendaciones(hojaCitaId);
                document.getElementById('formRecomendacion').reset();
            } else {
                showToast('danger', json.message || 'Error al agregar.');
            }
        } catch (err) {
            showToast('danger', 'Error de conexión.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Guardar';
        }
    });

    // --- SUBIR ARCHIVO (Enfoque A: FormData → API → Supabase Storage) ---
    let selectedFile = null;
    let currentUploadHojaCitaId = null;

    // Abrir modal con hojaCitaId preseleccionado
    window.abrirModalArchivo = function(hojaCitaId) {
        currentUploadHojaCitaId = hojaCitaId;
        document.getElementById('archHojaCitaIdHidden').value = hojaCitaId;
        resetFileUpload();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalSubirArchivo')).show();
    };

    function resetFileUpload() {
        selectedFile = null;
        document.getElementById('archFileInput').value = '';
        document.getElementById('filePreview').classList.add('d-none');
        document.getElementById('uploadProgress').classList.add('d-none');
        document.getElementById('btnSubirArchivo').disabled = true;
        const dropZone = document.getElementById('dropZone');
        dropZone.style.borderColor = '';
        dropZone.style.background = '';
    }

    // Drop zone events
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('archFileInput');

    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = '#0d6efd';
        dropZone.style.background = '#e7f1ff';
    });

    dropZone.addEventListener('dragleave', () => {
        dropZone.style.borderColor = '';
        dropZone.style.background = '';
    });

    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = '';
        dropZone.style.background = '';
        if (e.dataTransfer.files.length > 0) {
            handleFileSelect(e.dataTransfer.files[0]);
        }
    });

    fileInput.addEventListener('change', (e) => {
        if (e.target.files.length > 0) {
            handleFileSelect(e.target.files[0]);
        }
    });

    function handleFileSelect(file) {
        const allowedTypes = [
            'application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'image/gif',
            'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
            'text/plain'
        ];
        if (!allowedTypes.includes(file.type)) {
            showToast('danger', 'Tipo de archivo no permitido. Solo: PDF, imágenes, Word, Excel, TXT.');
            return;
        }
        if (file.size > 50 * 1024 * 1024) {
            showToast('danger', 'El archivo supera el tamaño máximo de 50 MB.');
            return;
        }

        selectedFile = file;

        // Mostrar preview
        const iconEl = document.getElementById('filePreviewIcon');
        iconEl.className = 'bi fs-4 ' + (
            file.type.includes('pdf') ? 'bi-filetype-pdf text-danger' :
            file.type.includes('image') ? 'bi-filetype-jpg text-info' :
            'bi-file-earmark text-muted'
        );
        document.getElementById('filePreviewName').textContent = file.name;
        document.getElementById('filePreviewSize').textContent = formatBytes(file.size);
        document.getElementById('filePreview').classList.remove('d-none');
        document.getElementById('btnSubirArchivo').disabled = false;
    }

    // Botón quitar archivo
    document.getElementById('btnRemoveFile').addEventListener('click', resetFileUpload);

    // Botón subir archivo
    document.getElementById('btnSubirArchivo').addEventListener('click', async function() {
        if (!selectedFile) { showToast('danger', 'Seleccione un archivo.'); return; }

        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Subiendo...';

        const progress = document.getElementById('uploadProgress');
        const progressBar = document.getElementById('uploadProgressBar');
        const progressText = document.getElementById('uploadProgressText');
        progress.classList.remove('d-none');
        progressBar.style.width = '30%';
        progressText.textContent = 'Subiendo archivo al servidor...';

        const formData = new FormData();
        formData.append('file', selectedFile);
        formData.append('expedienteId', EXPEDIENTE_ID);
        formData.append('hojaCitaId', currentUploadHojaCitaId || '');

        try {
            const xhr = new XMLHttpRequest();
            xhr.open('POST', URLS.subirArchivo, true);

            xhr.upload.addEventListener('progress', (e) => {
                if (e.lengthComputable) {
                    const pct = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = pct + '%';
                    progressText.textContent = `Subiendo... ${pct}%`;
                }
            });

            const result = await new Promise((resolve, reject) => {
                xhr.onload = function() {
                    try {
                        resolve(JSON.parse(xhr.responseText));
                    } catch {
                        reject(new Error('Respuesta inválida del servidor.'));
                    }
                };
                xhr.onerror = () => reject(new Error('Error de conexión.'));
                xhr.send(formData);
            });

            if (xhr.status >= 200 && xhr.status < 300 && result.success) {
                progressBar.style.width = '100%';
                progressText.textContent = 'Archivo subido exitosamente.';
                showToast('success', result.message || '<i class="bi bi-file-earmark-check me-1"></i>Archivo subido exitosamente.');

                // Recargar archivos de la hoja
                if (currentUploadHojaCitaId) {
                    await cargarArchivosHoja(currentUploadHojaCitaId);
                }

                setTimeout(() => {
                    bootstrap.Modal.getInstance(document.getElementById('modalSubirArchivo')).hide();
                    resetFileUpload();
                }, 800);
            } else {
                showToast('danger', result.message || 'Error al subir archivo.');
                progress.classList.add('d-none');
            }
        } catch (err) {
            showToast('danger', 'Error de conexión: ' + err.message);
            progress.classList.add('d-none');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-upload me-1"></i> Subir Archivo';
        }
    });

    // ========== UTILIDADES ==========
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function formatBytes(bytes) {
        if (!bytes) return '';
        const units = ['bytes', 'KB', 'MB', 'GB'];
        let i = 0;
        let size = bytes;
        while (size >= 1024 && i < units.length - 1) {
            size /= 1024;
            i++;
        }
        return size.toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
    }

    function showToast(type, message) {
        const container = document.getElementById('toastContainer') || createToastContainer();
        const icons = { success: 'bi-check-circle-fill', danger: 'bi-exclamation-triangle-fill', warning: 'bi-exclamation-circle-fill', info: 'bi-info-circle-fill' };
        const icon = icons[type] || 'bi-info-circle-fill';
        const toast = document.createElement('div');
        toast.className = `toast-vittal toast-${type} shadow`;
        toast.innerHTML = `
            <div class="toast-vittal-icon"><i class="bi ${icon}"></i></div>
            <div class="toast-vittal-body">${message}</div>
            <button type="button" class="toast-vittal-close" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>`;
        container.appendChild(toast);
        // Trigger entrance animation
        requestAnimationFrame(() => toast.classList.add('show'));
        setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 4000);
    }

    function createToastContainer() {
        const div = document.createElement('div');
        div.id = 'toastContainer';
        document.body.appendChild(div);
        return div;
    }
</script>

<style>
    #toastContainer {
        position: fixed; top: 1rem; right: 1rem; z-index: 9999;
        display: flex; flex-direction: column; gap: 0.5rem;
    }
