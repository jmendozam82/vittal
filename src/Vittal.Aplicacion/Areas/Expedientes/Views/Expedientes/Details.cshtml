        try {
            // 1) Resolver la sala de la hoja
            const salaRes = await fetch(`${URLS.salaDeHoja}?hojaCitaId=${hojaCitaId}`);
            const salaJson = await salaRes.json();
            if (!salaJson.success || !salaJson.salaId) {
                container.innerHTML = '<div class="alert alert-warning w-100">' + (salaJson.message || 'No se pudo determinar la sala de la hoja.') + '</div>';
                return;
            }
            document.getElementById('antSalaId').value = salaJson.salaId;
            document.getElementById('antSalaInfo').innerHTML = '<i class="bi bi-building me-1"></i>Especialidad: <strong>' + escapeHtml(salaJson.salaNombre || 'Sala') + '</strong>';

            // 2) Tipos de antecedentes de esa especialidad
            const tipoRes = await fetch(`${URLS.tiposAntecedente}?salaId=${salaJson.salaId}`);
            const tipoJson = await tipoRes.json();
            antTipos = (tipoJson.success ? (tipoJson.data || []) : []);
            if (antTipos.length === 0) {
                container.innerHTML = '<div class="alert alert-warning w-100">Esta especialidad no tiene tipos de antecedentes configurados.</div>';
                return;
            }

            // 3) Valores ya registrados del paciente en esa especialidad (pre-carga)
            let existentes = {};
            try {
                const antRes = await fetch(`${URLS.antecedentes}?expedienteId=${EXPEDIENTE_ID}&salaId=${salaJson.salaId}`);
                const antJson = await antRes.json();
                (antJson.success ? (antJson.data || []) : []).forEach(a => { existentes[a.tipoAntecedenteId] = a.valor; });
            } catch (e) { /* la pre-carga es opcional */ }

            container.innerHTML = '';
            antTipos.forEach((t, i) => {
                const col = document.createElement('div');
                col.className = 'col-md-6';
                const idInput = 'ant_' + i;
                const valorPrev = existentes[t.id];
                if (t.tipoDato === 'boolean') {
                    const selVal = (valorPrev === 'true' || valorPrev === 'True') ? 'true'
                        : ((valorPrev === 'false' || valorPrev === 'False') ? 'false' : '');
                    col.innerHTML = `
                        <label class="form-label fw-semibold d-block">${escapeHtml(t.nombre)}</label>
                        <select class="form-select" id="${idInput}" data-tipo="${t.id}">
                            <option value="">-- Sin definir --</option>
                            <option value="true" ${selVal === 'true' ? 'selected' : ''}>Sí</option>
                            <option value="false" ${selVal === 'false' ? 'selected' : ''}>No</option>
                        </select>`;
                } else {
                    const inputType = t.tipoDato === 'numero' ? 'number' : 'text';
                    col.innerHTML = `
                        <label class="form-label fw-semibold" for="${idInput}">${escapeHtml(t.nombre)}</label>
                        <input type="${inputType}" step="any" class="form-control" id="${idInput}" data-tipo="${t.id}" value="${escapeHtml(valorPrev || '')}" placeholder="${t.tipoDato === 'numero' ? 'Valor numérico' : 'Texto'}">`;
                }
                container.appendChild(col);
            });
        } catch (err) {
            container.innerHTML = '<div class="alert alert-danger w-100">Error de conexión al cargar antecedentes.</div>';
        }
    };

    document.getElementById('btnGuardarAntecedentes').addEventListener('click', async function() {
        const hojaCitaId = document.getElementById('antHojaCitaId').value;
        const expedienteId = EXPEDIENTE_ID;
        const salaId = document.getElementById('antSalaId').value;
        if (!salaId) { showToast('danger', 'Sala no definida.'); return; }

        const items = [];
        antTipos.forEach((t, i) => {
            const input = document.getElementById('ant_' + i);
            if (!input) return;
            const val = input.value.trim();
            if (val === '') return;
            items.push({ tipoAntecedenteId: t.id, valor: val });
        });
        if (items.length === 0) { showToast('danger', 'Ingrese al menos un antecedente.'); return; }

        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';
        try {
            const res = await fetch(URLS.guardarAntecedentes, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ expedienteId: expedienteId, salaId: salaId, items: items })
            });
            const json = await res.json();
            if (res.ok && json.success) {
                showToast('success', json.message || 'Antecedentes guardados.');
                bootstrap.Modal.getInstance(document.getElementById('modalAntecedentes')).hide();
                await cargarAntecedentes(hojaCitaId);
            } else {
                showToast('danger', json.message || 'Error al guardar antecedentes.');
            }
        } catch (err) {
            showToast('danger', 'Error de conexión al guardar.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Guardar Antecedentes';
        }
    });

    // --- SUBIR ARCHIVO (Enfoque A: FormData → API → Supabase Storage) ---
    let selectedFile = null;
    let currentUploadHojaCitaId = null;

    // Abrir modal con hojaCitaId preseleccionado
    window.abrirModalArchivo = function(hojaCitaId) {
        if (bloquearSiFinalizada(hojaCitaId)) return;
        currentUploadHojaCitaId = hojaCitaId;
        document.getElementById('archHojaCitaIdHidden').value = hojaCitaId;
        resetFileUpload();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalSubirArchivo')).show();
    };

    function resetFileUpload() {
        selectedFile = null;
        document.getElementById('archFileInput').value = '';
        document.getElementById('filePreview').classList.add('d-none');
        document.getElementById('uploadProgress').classList.add('d-none');
        document.getElementById('btnSubirArchivo').disabled = true;
        const dropZone = document.getElementById('dropZone');
        dropZone.style.borderColor = '';
        dropZone.style.background = '';
    }

    // Drop zone events
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('archFileInput');

    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = '#0d6efd';
        dropZone.style.background = '#e7f1ff';
    });

    dropZone.addEventListener('dragleave', () => {
        dropZone.style.borderColor = '';
        dropZone.style.background = '';
    });

    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = '';
        dropZone.style.background = '';
        if (e.dataTransfer.files.length > 0) {
            handleFileSelect(e.dataTransfer.files[0]);
        }
    });

    fileInput.addEventListener('change', (e) => {
        if (e.target.files.length > 0) {
            handleFileSelect(e.target.files[0]);
        }
    });

    function handleFileSelect(file) {
        const allowedTypes = [
            'application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'image/gif',
            'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
            'text/plain'
        ];
        if (!allowedTypes.includes(file.type)) {
            showToast('danger', 'Tipo de archivo no permitido. Solo: PDF, imágenes, Word, Excel, TXT.');
            return;
        }
        if (file.size > 50 * 1024 * 1024) {
            showToast('danger', 'El archivo supera el tamaño máximo de 50 MB.');
            return;
        }

        selectedFile = file;

        // Mostrar preview
        const iconEl = document.getElementById('filePreviewIcon');
        iconEl.className = 'bi fs-4 ' + (
            file.type.includes('pdf') ? 'bi-filetype-pdf text-danger' :
            file.type.includes('image') ? 'bi-filetype-jpg text-info' :
            'bi-file-earmark text-muted'
        );
        document.getElementById('filePreviewName').textContent = file.name;
        document.getElementById('filePreviewSize').textContent = formatBytes(file.size);
        document.getElementById('filePreview').classList.remove('d-none');
        document.getElementById('btnSubirArchivo').disabled = false;
    }

    // Botón quitar archivo
    document.getElementById('btnRemoveFile').addEventListener('click', resetFileUpload);

    // Botón subir archivo
    document.getElementById('btnSubirArchivo').addEventListener('click', async function() {
        if (!selectedFile) { showToast('danger', 'Seleccione un archivo.'); return; }

        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Subiendo...';

        const progress = document.getElementById('uploadProgress');
        const progressBar = document.getElementById('uploadProgressBar');
        const progressText = document.getElementById('uploadProgressText');
        progress.classList.remove('d-none');
        progressBar.style.width = '30%';
        progressText.textContent = 'Subiendo archivo al servidor...';

        const formData = new FormData();
        formData.append('file', selectedFile);
        formData.append('expedienteId', EXPEDIENTE_ID);
        formData.append('hojaCitaId', currentUploadHojaCitaId || '');

        try {
            const xhr = new XMLHttpRequest();
            xhr.open('POST', URLS.subirArchivo, true);

            xhr.upload.addEventListener('progress', (e) => {
                if (e.lengthComputable) {
                    const pct = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = pct + '%';
                    progressText.textContent = `Subiendo... ${pct}%`;
                }
            });

            const result = await new Promise((resolve, reject) => {
                xhr.onload = function() {
                    try {
                        resolve(JSON.parse(xhr.responseText));
                    } catch {
                        reject(new Error('Respuesta inválida del servidor.'));
                    }
                };
                xhr.onerror = () => reject(new Error('Error de conexión.'));
                xhr.send(formData);
            });

            if (xhr.status >= 200 && xhr.status < 300 && result.success) {
                progressBar.style.width = '100%';
                progressText.textContent = 'Archivo subido exitosamente.';
                showToast('success', result.message || '<i class="bi bi-file-earmark-check me-1"></i>Archivo subido exitosamente.');

                // Recargar archivos de la hoja
                if (currentUploadHojaCitaId) {
                    await cargarArchivosHoja(currentUploadHojaCitaId);
                }

                setTimeout(() => {
                    bootstrap.Modal.getInstance(document.getElementById('modalSubirArchivo')).hide();
                    resetFileUpload();
                }, 800);
            } else {
                showToast('danger', result.message || 'Error al subir archivo.');
                progress.classList.add('d-none');
            }
        } catch (err) {
            showToast('danger', 'Error de conexión: ' + err.message);
            progress.classList.add('d-none');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-upload me-1"></i> Subir Archivo';
        }
    });

    // ========== MODAL CONSTANCIA: EMITIR + IMPRIMIR ==========

    // Almacena el doctorId de la hoja de cita actual
    let constanciaHojaCitaId = '';
    let constanciaDoctorId = '';

    window.abrirModalConstancia = function(hojaCitaId, doctorId, doctorNombre) {
        constanciaHojaCitaId = hojaCitaId;
        constanciaDoctorId = doctorId;

        // Auto-poblar campos ocultos
        document.getElementById('constExpedienteId').value = EXPEDIENTE_ID;
        document.getElementById('constHojaCitaId').value = hojaCitaId;
        document.getElementById('constDoctorId').value = doctorId;

        // Auto-poblar campos de solo lectura
        const pacienteEl = document.getElementById('headerPacienteNombre');
        document.getElementById('constPaciente').value = pacienteEl ? pacienteEl.textContent : '';
        document.getElementById('constDoctor').value = doctorNombre || '';

        // Reset form
        document.getElementById('constTipo').value = '';
        document.getElementById('constContenido').value = '';
        document.getElementById('constDiasReposo').value = '';
        document.getElementById('constEspecialista').value = '';
        document.getElementById('constCampoDiasReposo').classList.add('d-none');
        document.getElementById('constCampoEspecialista').classList.add('d-none');
        document.getElementById('constTipo').classList.remove('is-invalid');
        document.getElementById('constContenido').classList.remove('is-invalid');

        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalEmitirConstancia')).show();
    };

    // Tipo constancia: mostrar/ocultar campos condicionales
    document.getElementById('constTipo').addEventListener('change', function() {
        const tipo = this.value;
        document.getElementById('constCampoDiasReposo').classList.toggle('d-none', tipo !== 'INCAPACIDAD');
        document.getElementById('constCampoEspecialista').classList.toggle('d-none', tipo !== 'REFERENCIA');
        if (tipo !== 'INCAPACIDAD') document.getElementById('constDiasReposo').value = '';
        if (tipo !== 'REFERENCIA') document.getElementById('constEspecialista').value = '';
    });

    // Botón Emitir e Imprimir
    document.getElementById('btnEmitirConstancia').addEventListener('click', async function() {
        const tipo = document.getElementById('constTipo').value;
        const contenido = document.getElementById('constContenido').value.trim();

        // Validación
        let hasError = false;
        if (!tipo) { document.getElementById('constTipo').classList.add('is-invalid'); hasError = true; }
        else { document.getElementById('constTipo').classList.remove('is-invalid'); }
        if (!contenido) { document.getElementById('constContenido').classList.add('is-invalid'); hasError = true; }
        else { document.getElementById('constContenido').classList.remove('is-invalid'); }
        if (hasError) return;

        const btn = this;
        const spinner = document.getElementById('constSpinner');
        const icon = document.getElementById('constIcon');
        btn.disabled = true;
        spinner.classList.remove('d-none');
        icon.classList.add('d-none');

        const payload = {
            expedienteId: EXPEDIENTE_ID,
            hojaCitaId: constanciaHojaCitaId || null,
            doctorId: constanciaDoctorId,
            tipoConstancia: tipo,
            contenido: contenido,
            diasReposo: tipo === 'INCAPACIDAD' && document.getElementById('constDiasReposo').value
                ? parseInt(document.getElementById('constDiasReposo').value) : null,
            especialistaReferido: tipo === 'REFERENCIA'
                ? document.getElementById('constEspecialista').value.trim() || null : null
        };

        try {
            const res = await fetch(URLS.crearConstancia, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const json = await res.json();

            if (res.ok && json.success) {
                showToast('success', 'Constancia emitida exitosamente.');
                bootstrap.Modal.getInstance(document.getElementById('modalEmitirConstancia')).hide();

                // Abrir impresión en nueva pestaña
                const constanciaId = json.data?.id;
                if (constanciaId) {
                    window.open('/Expedientes/Constancias/ImprimirConstancia?id=' + constanciaId, '_blank');
                }
            } else {
                const errMsg = json.message || (json.errors && json.errors.join(', ')) || 'Error al emitir la constancia.';
                showToast('danger', errMsg);
            }
        } catch (err) {
            showToast('danger', 'Error de conexión al emitir constancia.');
        } finally {
            btn.disabled = false;
            spinner.classList.add('d-none');
            icon.classList.remove('d-none');
        }
    });

    // ========== UTILIDADES ==========
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function formatBytes(bytes) {
        if (!bytes) return '';
        const units = ['bytes', 'KB', 'MB', 'GB'];
        let i = 0;
        let size = bytes;
        while (size >= 1024 && i < units.length - 1) {
            size /= 1024;
            i++;
        }
        return size.toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
    }

    function showToast(type, message) {
        const container = document.getElementById('toastContainer') || createToastContainer();
        const icons = { success: 'bi-check-circle-fill', danger: 'bi-exclamation-triangle-fill', warning: 'bi-exclamation-circle-fill', info: 'bi-info-circle-fill' };
        const icon = icons[type] || 'bi-info-circle-fill';
        const toast = document.createElement('div');
        toast.className = `toast-vittal toast-${type} shadow`;
        toast.innerHTML = `
            <div class="toast-vittal-icon"><i class="bi ${icon}"></i></div>
            <div class="toast-vittal-body">${message}</div>
            <button type="button" class="toast-vittal-close" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>`;
        container.appendChild(toast);
        // Trigger entrance animation
        requestAnimationFrame(() => toast.classList.add('show'));
        setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 4000);
    }

    function createToastContainer() {
        const div = document.createElement('div');
        div.id = 'toastContainer';
        document.body.appendChild(div);
        return div;
    }
</script>

<style>
    #toastContainer {
        position: fixed; top: 1rem; right: 1rem; z-index: 9999;
        display: flex; flex-direction: column; gap: 0.5rem;
    }
    .toast-vittal {
        display: flex; align-items: center; gap: 0.65rem;
        padding: 0.75rem 1rem; border-radius: 0.5rem;
        min-width: 320px; max-width: 450px;
        font-size: 0.875rem; color: #fff;
        transform: translateX(120%); transition: transform 0.35s cubic-bezier(.4,0,.2,1), opacity 0.35s;
        opacity: 0; cursor: default;
    }
    .toast-vittal.show { transform: translateX(0); opacity: 1; }
    .toast-vittal-icon { font-size: 1.25rem; flex-shrink: 0; }
    .toast-vittal-body { flex: 1; line-height: 1.4; }
    .toast-vittal-close {
        background: none; border: none; color: rgba(255,255,255,0.7);
        font-size: 1.1rem; cursor: pointer; padding: 0; line-height: 1;
    }
    .toast-vittal-close:hover { color: #fff; }
    .toast-success { background: linear-gradient(135deg, #28a745, #218838); }
    .toast-danger  { background: linear-gradient(135deg, #dc3545, #c82333); }
    .toast-warning { background: linear-gradient(135deg, #ffc107, #e0a800); color: #333; }
    .toast-warning .toast-vittal-close { color: rgba(0,0,0,0.5); }
    .toast-warning .toast-vittal-close:hover { color: #000; }
    .toast-info    { background: linear-gradient(135deg, #17a2b8, #138496); }
</style>
}
