    // --- SUBIR ARCHIVO ---
    document.getElementById('btnSubirArchivo').addEventListener('click', async function() {
        const nombre = document.getElementById('archNombre').value.trim();
        const tipoMime = document.getElementById('archTipoMime').value;
        const storagePath = document.getElementById('archStoragePath').value.trim();

        if (!nombre) { showToast('danger', 'El nombre del archivo es obligatorio.'); return; }
        if (!tipoMime) { showToast('danger', 'Seleccione un tipo MIME.'); return; }
        if (!storagePath) { showToast('danger', 'La ruta de storage es obligatoria.'); return; }

        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Subiendo...';

        try {
            const res = await fetch('/api/expedientes-archivos', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    expedienteId: EXPEDIENTE_ID,
                    hojaCitaId: document.getElementById('archHojaCitaId').value || null,
                    nombreArchivo: nombre,
                    tipoMime: tipoMime,
                    storagePath: storagePath,
                    urlPublica: document.getElementById('archUrl').value.trim() || null,
                    tamanoBytes: parseInt(document.getElementById('archTamano').value) || null
                })
            });
            const json = await res.json();
            if (res.ok && json.success) {
                showToast('success', 'Archivo subido exitosamente.');
                bootstrap.Modal.getInstance(document.getElementById('modalSubirArchivo')).hide();
                await cargarArchivos();
                document.getElementById('formArchivo').reset();
            } else {
