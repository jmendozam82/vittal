                                <i class="bi bi-heart-pulse me-1"></i> + Diagnóstico
                            </button>
                            <button class="btn btn-outline-success btn-sm" onclick="abrirModalTratamiento('${h.id}')">
                                <i class="bi bi-capsule me-1"></i> + Tratamiento
                            </button>
                            <button class="btn btn-outline-warning btn-sm" onclick="abrirModalCirugia('${h.id}')">
                                <i class="bi bi-hospital me-1"></i> + Cirugía
                            </button>
                            <button class="btn btn-outline-info btn-sm" onclick="abrirModalExamen('${h.id}')">
                                <i class="bi bi-clipboard2-pulse me-1"></i> + Examen
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" onclick="abrirModalRecomendacion('${h.id}')">
                                <i class="bi bi-chat-quote me-1"></i> + Recomendación
                            </button>
                        </div>
