    document.getElementById('btnGuardarHojaCita').addEventListener('click', async function() {
        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';

        const data = {
            expedienteId: EXPEDIENTE_ID,
            citaId: document.getElementById('hcCitaId').value.trim() || '00000000-0000-0000-0000-000000000000',
            doctorId: document.getElementById('hcDoctorId').value,
