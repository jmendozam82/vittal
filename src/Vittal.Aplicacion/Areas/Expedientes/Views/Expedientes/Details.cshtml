    // --- AGREGAR DIAGNÓSTICO ---
    // Guard de integridad: bloquea abrir modales de edición de una hoja cuya consulta ya finalizó.
    function esHojaFinalizada(hojaCitaId) {
        const hoja = (hojasCita || []).find(x => x.id === hojaCitaId);
        return !!(hoja && (hoja.citaEstado || '').toLowerCase() === 'atendida');
    }
    function bloquearSiFinalizada(hojaCitaId) {
        if (!esHojaFinalizada(hojaCitaId)) return false;
        showToast('warning', 'La consulta ya fue finalizada y no se puede modificar.');
        return true;
    }

