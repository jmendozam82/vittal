@{
    ViewData["Title"] = "Detalle del Expediente";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/'>Inicio</a></li>" +
                             "<li class='breadcrumb-item'><a href='/Expedientes/Expedientes'>Expedientes</a></li>" +
                             "<li class='breadcrumb-item active'>Detalle del Expediente</li>";

    var expedienteId = ViewBag.ExpedienteId?.ToString() ?? "";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-folder2-open me-2 text-primary"></i>Expediente: <span id="headerPacienteNombre">Cargando...</span>
        </h5>
        <div>
            <!-- La hoja de cita se crea SOLO desde la Cola de Espera (botón "Atender"), no manualmente aquí -->
            <a href="/Expedientes/Expedientes" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>
    <div class="card-body">
        <!-- Info del expediente -->
        <div class="row mb-4" id="infoExpediente">
            <div class="col-md-4">
                <small class="text-muted d-block">Paciente</small>
                <strong id="detallePaciente">-</strong>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block">Doctor Asignado</small>
                <strong id="detalleDoctor">-</strong>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block">Fecha de Creación</small>
                <strong id="detalleFecha">-</strong>
            </div>
        </div>

        <!-- Notas generales -->
        <div id="notasGeneralesContainer" class="mb-4" style="display:none;">
            <h6 class="text-primary border-bottom pb-2 mb-2">
                <i class="bi bi-journal-text me-2"></i>Notas Generales
            </h6>
            <p id="detalleNotas" class="text-muted mb-0"></p>
        </div>

        <hr />

        <!-- Sección: Hojas de Cita (lista cronológica descendente) -->
        <h6 class="text-primary border-bottom pb-2 mb-3">
            <i class="bi bi-calendar-check me-2"></i>Hojas de Cita
            <span class="badge bg-primary rounded-pill ms-2" id="hojasCount">0</span>
        </h6>

        <div id="hojasCitaContainer">
            <div class="d-flex justify-content-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando hojas de cita...</span>
                </div>
            </div>
        </div>

        <hr class="mt-4" />
    </div>
</div>

<!-- ========== MODAL: Nueva Hoja de Cita ========== -->
<div class="modal fade" id="modalNuevaHojaCita" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2 text-success"></i>Nueva Hoja de Cita</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formHojaCita" novalidate>
                    <input type="hidden" id="hcExpedienteId" value="@expedienteId" />
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="hcCitaId" class="form-label fw-semibold">Cita Asociada</label>
                            <input type="text" class="form-control" id="hcCitaId" placeholder="Se asigna desde Cola de Espera" readonly />
                            <small class="text-muted" id="hcCitaInfo">Asignada automáticamente desde Cola de Espera (botón "Atender").</small>
                        </div>
                        <div class="col-md-6">
                            <label for="hcDoctorId" class="form-label fw-semibold">Doctor <span class="text-danger">*</span></label>
                            <select class="form-select" id="hcDoctorId" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                            <div class="invalid-feedback">Seleccione un doctor.</div>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="hcFechaConsulta" class="form-label fw-semibold">Fecha de Consulta</label>
                            <input type="date" class="form-control" id="hcFechaConsulta" />
                        </div>
                        <div class="col-md-6">
                            <label for="hcMotivoConsulta" class="form-label fw-semibold">Motivo de Consulta</label>
                            <input type="text" class="form-control" id="hcMotivoConsulta" maxlength="500" placeholder="Motivo de la consulta" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="hcNotasConsulta" class="form-label fw-semibold">Notas Clínicas</label>
                        <textarea class="form-control" id="hcNotasConsulta" rows="3" maxlength="2000" placeholder="Notas de la consulta"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success btn-sm" id="btnGuardarHojaCita">
                    <i class="bi bi-check-lg me-1"></i> Guardar Hoja de Cita
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Agregar Diagnóstico ========== -->
<div class="modal fade" id="modalAgregarDiagnostico" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-heart-pulse me-2 text-primary"></i>Agregar Diagnóstico</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formDiagnostico">
                    <input type="hidden" id="diagHojaCitaId" />
                    <div class="mb-3">
                        <label for="diagDiagnosticoId" class="form-label fw-semibold">Diagnóstico <span class="text-danger">*</span></label>
                        <select class="form-select" id="diagDiagnosticoId" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="diagObservaciones" class="form-label fw-semibold">Observaciones</label>
                        <textarea class="form-control" id="diagObservaciones" rows="2" maxlength="1000" placeholder="Observaciones adicionales"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnGuardarDiagnostico">
                    <i class="bi bi-check-lg me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Agregar Tratamiento ========== -->
<div class="modal fade" id="modalAgregarTratamiento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-capsule me-2 text-success"></i>Agregar Tratamiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formTratamiento">
                    <input type="hidden" id="tratHojaCitaId" />
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="tratMedicamentoId" class="form-label fw-semibold">Medicamento</label>
                            <select class="form-select" id="tratMedicamentoId">
                                <option value="">-- Seleccione (opcional) --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="tratTratamientoId" class="form-label fw-semibold">Tratamiento</label>
                            <select class="form-select" id="tratTratamientoId">
                                <option value="">-- Seleccione (opcional) --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label for="tratDosis" class="form-label fw-semibold">Dosis</label>
                            <input type="text" class="form-control" id="tratDosis" maxlength="100" placeholder="Ej: 500mg" />
                        </div>
                        <div class="col-md-4">
                            <label for="tratFrecuencia" class="form-label fw-semibold">Frecuencia</label>
                            <input type="text" class="form-control" id="tratFrecuencia" maxlength="100" placeholder="Ej: cada 8 horas" />
                        </div>
                        <div class="col-md-4">
                            <label for="tratDuracion" class="form-label fw-semibold">Duración</label>
                            <input type="text" class="form-control" id="tratDuracion" maxlength="100" placeholder="Ej: 7 días" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="tratInstrucciones" class="form-label fw-semibold">Instrucciones</label>
                        <textarea class="form-control" id="tratInstrucciones" rows="2" maxlength="1000" placeholder="Instrucciones adicionales"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success btn-sm" id="btnGuardarTratamiento">
                    <i class="bi bi-check-lg me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Agregar Cirugía ========== -->
<div class="modal fade" id="modalAgregarCirugia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-hospital me-2 text-warning"></i>Agregar Cirugía</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formCirugia">
                    <input type="hidden" id="cirHojaCitaId" />
                    <div class="mb-3">
                        <label for="cirCirugiaId" class="form-label fw-semibold">Cirugía <span class="text-danger">*</span></label>
                        <select class="form-select" id="cirCirugiaId" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="cirFechaCirugia" class="form-label fw-semibold">Fecha de Cirugía</label>
                        <input type="date" class="form-control" id="cirFechaCirugia" />
                    </div>
                    <div class="mb-3">
                        <label for="cirObservaciones" class="form-label fw-semibold">Observaciones</label>
                        <textarea class="form-control" id="cirObservaciones" rows="2" maxlength="1000" placeholder="Observaciones"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning btn-sm text-white" id="btnGuardarCirugia">
                    <i class="bi bi-check-lg me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Agregar Examen ========== -->
<div class="modal fade" id="modalAgregarExamen" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-clipboard2-pulse me-2 text-info"></i>Agregar Examen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formExamen">
                    <input type="hidden" id="exaHojaCitaId" />
                    <div class="mb-3">
                        <label for="exaExamenId" class="form-label fw-semibold">Examen <span class="text-danger">*</span></label>
                        <select class="form-select" id="exaExamenId" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="exaResultado" class="form-label fw-semibold">Resultado</label>
                        <textarea class="form-control" id="exaResultado" rows="3" maxlength="2000" placeholder="Resultado del examen"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="exaArchivoUrl" class="form-label fw-semibold">URL del Archivo</label>
                        <input type="text" class="form-control" id="exaArchivoUrl" maxlength="500" placeholder="URL del archivo asociado (opcional)" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-info btn-sm text-white" id="btnGuardarExamen">
                    <i class="bi bi-check-lg me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Subir Archivo ========== -->
<div class="modal fade" id="modalSubirArchivo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-upload me-2 text-primary"></i>Subir Archivo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="archExpedienteId" value="@expedienteId" />
                <input type="hidden" id="archHojaCitaIdHidden" value="" />

                <!-- Drop zone -->
                <div id="dropZone" class="border border-2 border-dashed rounded-3 p-4 text-center mb-3"
                     style="cursor:pointer; transition: border-color 0.2s, background 0.2s;">
                    <i class="bi bi-cloud-arrow-up fs-1 text-muted d-block mb-2"></i>
                    <p class="mb-1 fw-semibold text-muted">Arrastra un archivo aquí o haz clic para seleccionar</p>
                    <small class="text-muted">PDF, imágenes, Word, Excel — Máx. 50 MB</small>
                    <input type="file" id="archFileInput" class="d-none"
                           accept=".pdf,.jpg,.jpeg,.png,.webp,.gif,.doc,.docx,.xls,.xlsx,.txt" />
                </div>

                <!-- Preview del archivo seleccionado -->
                <div id="filePreview" class="d-none mb-3">
                    <div class="d-flex align-items-center gap-2 p-2 bg-light rounded">
                        <i id="filePreviewIcon" class="bi fs-4"></i>
                        <div class="flex-grow-1">
                            <div id="filePreviewName" class="fw-semibold small"></div>
                            <small id="filePreviewSize" class="text-muted"></small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="btnRemoveFile" title="Quitar archivo">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Progress bar -->
                <div id="uploadProgress" class="d-none mb-3">
                    <div class="progress" style="height: 8px;">
                        <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated"
                             role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <small id="uploadProgressText" class="text-muted mt-1 d-block text-center">Subiendo...</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSubirArchivo" disabled>
                    <i class="bi bi-upload me-1"></i> Subir Archivo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Emitir Constancia ========== -->
<div class="modal fade" id="modalEmitirConstancia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-clipboard2-plus me-2 text-success"></i>Emitir Constancia Médica</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formConstancia" novalidate>
                    <input type="hidden" id="constExpedienteId" />
                    <input type="hidden" id="constHojaCitaId" />
                    <input type="hidden" id="constDoctorId" />

                    <!-- Info automática (solo lectura) -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">Paciente</label>
                            <input type="text" class="form-control form-control-sm bg-light" id="constPaciente" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">Doctor</label>
                            <input type="text" class="form-control form-control-sm bg-light" id="constDoctor" readonly />
                        </div>
                    </div>

                    <!-- Tipo de Constancia -->
                    <div class="mb-3">
                        <label for="constTipo" class="form-label fw-semibold">Tipo de Constancia <span class="text-danger">*</span></label>
                        <select id="constTipo" class="form-select" required>
                            <option value="">Seleccione un tipo...</option>
                            <option value="ASISTENCIA">Asistencia</option>
                            <option value="INCAPACIDAD">Incapacidad</option>
                            <option value="REFERENCIA">Referencia</option>
                            <option value="JUSTIFICANTE">Justificante</option>
                        </select>
                        <div class="invalid-feedback">Debe seleccionar un tipo.</div>
                    </div>

                    <!-- Contenido -->
                    <div class="mb-3">
                        <label for="constContenido" class="form-label fw-semibold">Contenido de la Constancia <span class="text-danger">*</span></label>
                        <textarea id="constContenido" class="form-control" rows="6" maxlength="5000"
                                  placeholder="Redacte el contenido completo de la constancia médica..."
                                  required></textarea>
                        <div class="form-text">Máximo 5,000 caracteres.</div>
                        <div class="invalid-feedback">El contenido es obligatorio.</div>
                    </div>

                    <!-- Campos condicionales -->
                    <div class="row g-3">
                        <div class="col-md-6 d-none" id="constCampoDiasReposo">
                            <label for="constDiasReposo" class="form-label fw-semibold">Días de Reposo</label>
                            <input type="number" id="constDiasReposo" class="form-control" min="1" max="365" placeholder="Ej: 7" />
                            <div class="form-text">1–365 días.</div>
                        </div>
                        <div class="col-md-6 d-none" id="constCampoEspecialista">
                            <label for="constEspecialista" class="form-label fw-semibold">Especialista Referido</label>
                            <input type="text" id="constEspecialista" class="form-control" maxlength="255" placeholder="Ej: Dr. Juan Pérez - Cardiólogo" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success btn-sm" id="btnEmitirConstancia">
                    <span id="constSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                    <i class="bi bi-check-lg me-1" id="constIcon"></i>
                    Emitir e Imprimir
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Agregar Recomendación ========== -->
<div class="modal fade" id="modalAgregarRecomendacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-chat-quote me-2 text-secondary"></i>Agregar Recomendación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formRecomendacion">
                    <input type="hidden" id="recHojaCitaId" />
                    <div class="mb-3">
                        <label for="recRecomendacionId" class="form-label fw-semibold">Recomendación <span class="text-danger">*</span></label>
                        <select class="form-select" id="recRecomendacionId" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="recObservaciones" class="form-label fw-semibold">Observaciones</label>
                        <textarea class="form-control" id="recObservaciones" rows="2" maxlength="1000" placeholder="Observaciones adicionales"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-secondary btn-sm text-white" id="btnGuardarRecomendacion">
                    <i class="bi bi-check-lg me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Signos Vitales de la Consulta ========== -->
<div class="modal fade" id="modalSignosVitales" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-activity me-2 text-danger"></i>Signos Vitales de la Consulta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="svHojaCitaId" />
                <div id="svSalaInfo" class="alert alert-light border small py-2 mb-3"></div>
                <div id="svFormContainer" class="row g-3">
                    <div class="d-flex justify-content-center p-4">
                        <div class="spinner-border text-danger" role="status">
                            <span class="visually-hidden">Cargando tipos de signos vitales...</span>
                        </div>
                    </div>
                </div>
                <small class="text-muted">Los signos vitales quedan guardados como histórico de esta consulta (hoja de cita). El sistema marca automáticamente los valores fuera del rango normal.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnGuardarSignosVitales">
                    <i class="bi bi-check-lg me-1"></i> Guardar Signos Vitales
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Antecedentes del Paciente ========== -->
<div class="modal fade" id="modalAntecedentes" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-journal-medical me-2 text-info"></i>Antecedentes del Paciente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="antHojaCitaId" />
                <input type="hidden" id="antExpedienteId" />
                <input type="hidden" id="antSalaId" />
                <div id="antSalaInfo" class="alert alert-light border small py-2 mb-3"></div>
                <div id="antFormContainer" class="row g-3">
                    <div class="d-flex justify-content-center p-4">
                        <div class="spinner-border text-info" role="status">
                            <span class="visually-hidden">Cargando antecedentes...</span>
                        </div>
                    </div>
                </div>
                <small class="text-muted">Los antecedentes son datos estables del paciente por especialidad. Se guardan una sola vez y se actualizan cuando cambian (pre-cargados en las siguientes consultas).</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-info btn-sm text-white" id="btnGuardarAntecedentes">
                    <i class="bi bi-check-lg me-1"></i> Guardar Antecedentes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const EXPEDIENTE_ID = '@expedienteId';
    let hojasCita = [];

    // URLs seguras desde el servidor
    const URLS = {
        expediente: '@Url.Action("JsonExpediente")',
        hojasCita: '@Url.Action("JsonHojasCita")',
        diagnosticos: '@Url.Action("JsonDiagnosticos")',
        tratamientos: '@Url.Action("JsonTratamientos")',
        cirugias: '@Url.Action("JsonCirugias")',
        examenes: '@Url.Action("JsonExamenes")',
        recomendaciones: '@Url.Action("JsonRecomendaciones")',
        archivos: '@Url.Action("JsonArchivos")',
        subirArchivo: '@Url.Action("JsonSubirArchivo")',
        signedUrlArchivo: '@Url.Action("JsonSignedUrl")',
        eliminarArchivo: '@Url.Action("JsonEliminarArchivo")',
        crearHojaCita: '@Url.Action("JsonCrearHojaCita")',
        crearDiagnostico: '@Url.Action("JsonCrearDiagnostico")',
        crearTratamiento: '@Url.Action("JsonCrearTratamiento")',
        crearCirugia: '@Url.Action("JsonCrearCirugia")',
        crearExamen: '@Url.Action("JsonCrearExamen")',
        crearRecomendacion: '@Url.Action("JsonCrearRecomendacion")',
        doctores: '@Url.Action("JsonDoctores")',
        cita: '@Url.Action("JsonCita")',
        // Catálogos para dropdowns (proxy MVC con JWT)
        diagnosticosCatalogo: '@Url.Action("JsonDiagnosticosCatalogo")',
        medicamentosCatalogo: '@Url.Action("JsonMedicamentosCatalogo")',
        tratamientosCatalogo: '@Url.Action("JsonTratamientosCatalogo")',
        cirugiasCatalogo: '@Url.Action("JsonCirugiasCatalogo")',
        examenesCatalogo: '@Url.Action("JsonExamenesCatalogo")',
        recomendacionesCatalogo: '@Url.Action("JsonRecomendacionesCatalogo")',
        // Signos vitales y antecedentes (HU-E05 / HU-E06)
        salaDeHoja: '@Url.Action("JsonSalaDeHoja")',
        tiposSignoVital: '@Url.Action("JsonTiposSignoVital")',
        signosVitalesHoja: '@Url.Action("JsonSignosVitalesHoja")',
        guardarSignosVitales: '@Url.Action("JsonGuardarSignosVitales")',
        tiposAntecedente: '@Url.Action("JsonTiposAntecedente")',
        antecedentes: '@Url.Action("JsonAntecedentes")',
        guardarAntecedentes: '@Url.Action("JsonGuardarAntecedentes")',
        // Constancias
        crearConstancia: '@Url.Action("JsonCrear", "Constancias")'
    };

    document.addEventListener('DOMContentLoaded', async function() {
        await cargarExpediente();
        await Promise.all([
            cargarHojasCita(),
            cargarDoctoresDropdown()
        ]);

        // Cargar catálogos para dropdowns de los modales
        await Promise.all([
            cargarCatalogo(URLS.diagnosticosCatalogo, 'diagDiagnosticoId', 'nombre', 'id'),
            cargarCatalogo(URLS.medicamentosCatalogo, 'tratMedicamentoId', 'nombre', 'id'),
            cargarCatalogo(URLS.tratamientosCatalogo, 'tratTratamientoId', 'nombre', 'id'),
            cargarCatalogo(URLS.cirugiasCatalogo, 'cirCirugiaId', 'nombre', 'id'),
            cargarCatalogo(URLS.examenesCatalogo, 'exaExamenId', 'nombre', 'id'),
            cargarCatalogo(URLS.recomendacionesCatalogo, 'recRecomendacionId', 'nombre', 'id')
        ]);

        // Detectar citaId desde query params y auto-poblar modal
        const params = new URLSearchParams(window.location.search);
        const citaIdParam = params.get('citaId');
        if (citaIdParam) {
            await prefillCitaFromCola(citaIdParam);
            // Auto-mostrar el modal para que el doctor cree la hoja de cita inmediatamente
            const modalEl = document.getElementById('modalNuevaHojaCita');
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        }
    });

    // ========== CARGAR DATOS DEL EXPEDIENTE ==========
    async function cargarExpediente() {
        try {
            const res = await fetch(`${URLS.expediente}?id=${EXPEDIENTE_ID}`, {
                headers: { 'Content-Type': 'application/json' }
            });
            if (!res.ok) return;
            const json = await res.json();
            if (!json.success || !json.data) return;

            const e = json.data;
            const pacienteNombre = e.pacienteNombre || 'Sin nombre';
            const doctorNombre = e.doctorNombre || 'Sin asignar';
            const fecha = e.fechaCreacion ? new Date(e.fechaCreacion).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }) : '-';

            document.getElementById('headerPacienteNombre').textContent = pacienteNombre;
            document.getElementById('detallePaciente').textContent = pacienteNombre;
            document.getElementById('detalleDoctor').textContent = doctorNombre;
            document.getElementById('detalleFecha').textContent = fecha;

            if (e.notasGenerales) {
                document.getElementById('detalleNotas').textContent = e.notasGenerales;
                document.getElementById('notasGeneralesContainer').style.display = 'block';
            }

            // Actualizar título
            document.title = 'Expediente: ' + pacienteNombre + ' - Vittal';
        } catch (err) {
            console.error('Error al cargar expediente:', err);
        }
    }

    // ========== CARGAR DOCTORES DROPDOWN ==========
    let doctores = [];
    async function cargarDoctoresDropdown() {
        try {
            const res = await fetch(URLS.doctores, {
                headers: { 'Content-Type': 'application/json' }
            });
            if (!res.ok) return;
            const json = await res.json();
            if (json.success && json.data) {
                doctores = json.data;
                const selects = ['hcDoctorId'];
                selects.forEach(id => {
                    const sel = document.getElementById(id);
                    if (!sel) return;
                    sel.innerHTML = '<option value="">-- Seleccione --</option>';
                    json.data.forEach(d => {
                        const op = document.createElement('option');
                        op.value = d.id || d.usuarioId || '';
                        op.textContent = d.nombreCompleto || 'Sin nombre';
                        sel.appendChild(op);
                    });
                });
            }
        } catch (err) {
            console.error('Error al cargar doctores:', err);
        }
    }

    // ========== CITA DESDE COLA DE ESPERA ==========
    async function prefillCitaFromCola(citaId) {
        try {
            // Poblar el campo de citaId
            const hcCitaId = document.getElementById('hcCitaId');
            if (hcCitaId) {
                hcCitaId.value = citaId;
            }

            // Fetch cita data para auto-poblar doctor, fecha y motivo (vía proxy MVC con JWT)
            const res = await fetch(`${URLS.cita}?id=${encodeURIComponent(citaId)}`, {
                headers: { 'Content-Type': 'application/json' }
            });
            if (!res.ok) return;
            const json = await res.json();
            const cita = json.success && json.data ? (Array.isArray(json.data) ? json.data[0] : json.data) : null;
            if (!cita) return;

            // Auto-poblar doctor (viene en la cita). Se añade la opción directamente porque
            // el médico puede NO tener permiso sobre /api/Usuarios (403) y el dropdown quedar vacío.
            const doctorId = cita.doctorId || cita.usuarioId || '';
            const doctorNombre = cita.doctorNombre || cita.doctor_nombre || '';
            const hcDoctorId = document.getElementById('hcDoctorId');
            if (hcDoctorId && doctorId) {
                let option = hcDoctorId.querySelector('option[value="' + doctorId + '"]');
                if (!option) {
                    option = document.createElement('option');
                    option.value = doctorId;
                    option.textContent = doctorNombre || 'Doctor asignado';
                    hcDoctorId.appendChild(option);
                }
                hcDoctorId.value = doctorId;
                // Bloquear el campo: el doctor lo define la cita (no editable desde Cola de Espera)
                hcDoctorId.disabled = true;
            }

            // Auto-poblar fecha de consulta: usar HOY (consulta actual) no la fecha programada de la cita
            const hoy = new Date();
            const yyyy = hoy.getFullYear();
            const mm = String(hoy.getMonth() + 1).padStart(2, '0');
            const dd = String(hoy.getDate()).padStart(2, '0');
            const hoyStr = `${yyyy}-${mm}-${dd}`;
            const hcFechaConsulta = document.getElementById('hcFechaConsulta');
            if (hcFechaConsulta) {
                hcFechaConsulta.value = hoyStr;
                // Bloquear el campo: la fecha es la actual (no editable desde Cola de Espera)
                hcFechaConsulta.disabled = true;
            }

            // Auto-poblar motivo de consulta
            const motivo = cita.motivo || cita.motivoConsulta || '';
            if (motivo) {
                document.getElementById('hcMotivoConsulta').value = motivo;
            }

            // Actualizar info del campo: cita + doctor precargados desde Cola de Espera
            const infoLabel = document.getElementById('hcCitaInfo');
            if (infoLabel) {
                const doctorPre = cita.doctorNombre || cita.doctor_nombre || '';
                infoLabel.textContent = '✓ Cita #' + citaId.substring(0, 8) + '... pre-seleccionada' +
                    (doctorPre ? ' · Dr(a). ' + doctorPre : '');
                infoLabel.className = 'text-success fw-semibold';
            }

        } catch (err) {
            console.error('Error al pre-fill cita:', err);
        }
    }

    // ========== CARGAR CATÁLOGO GENÉRICO ==========
    async function cargarCatalogo(url, selectId, labelField, valueField) {
        try {
            const res = await fetch(url, {
                headers: { 'Content-Type': 'application/json' }
            });
            if (!res.ok) {
                console.warn(`Error al cargar catálogo ${url}: ${res.status}`);
                return;
            }
            const json = await res.json();
            // Puede venir como { success: true, data: [...] } o como array directo
            let items = json.data || json;
            if (!Array.isArray(items)) items = [];
            const sel = document.getElementById(selectId);
            if (!sel) return;
            // Limpiar opciones existentes (excepto la primera "placeholder")
            while (sel.options.length > 1) {
                sel.remove(1);
            }
            items.forEach(item => {
                const op = document.createElement('option');
                op.value = item[valueField] || '';
                op.textContent = item[labelField] || 'Sin nombre';
                sel.appendChild(op);
            });
        } catch (err) {
            console.error(`Error al cargar catálogo ${url}:`, err);
        }
    }

    // ========== CARGAR HOJAS DE CITA ==========
    async function cargarHojasCita() {
        try {
            const res = await fetch(`${URLS.hojasCita}?expedienteId=${EXPEDIENTE_ID}`, {
                headers: { 'Content-Type': 'application/json' }
            });
            if (!res.ok) {
                document.getElementById('hojasCitaContainer').innerHTML = '<div class="alert alert-warning">Error al cargar hojas de cita.</div>';
                return;
            }
            const json = await res.json();
            if (!json.success) {
                document.getElementById('hojasCitaContainer').innerHTML = '<div class="alert alert-warning">' + (json.message || 'Error al cargar.') + '</div>';
                return;
            }

            hojasCita = json.data || [];
            document.getElementById('hojasCount').textContent = hojasCita.length;
            renderHojasCita(hojasCita);
        } catch (err) {
            document.getElementById('hojasCitaContainer').innerHTML = '<div class="alert alert-danger">Error de conexión.</div>';
        }
    }

    async function renderHojasCita(hojas) {
        if (hojas.length === 0) {
            document.getElementById('hojasCitaContainer').innerHTML = `
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                    No hay hojas de cita registradas.
                    <br><small>La hoja de cita se genera desde la Cola de Espera al dar "Atender" al paciente.</small>
                </div>`;
            return;
        }

        // Ordenar descendente por fecha
        hojas.sort((a, b) => new Date(b.fechaConsulta) - new Date(a.fechaConsulta));

        let html = '<div class="accordion" id="accordionHojas">';
        for (let i = 0; i < hojas.length; i++) {
            const h = hojas[i];
            const fecha = h.fechaConsulta ? new Date(h.fechaConsulta).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Sin fecha';
            const doctor = h.doctorNombre || 'Sin doctor';
            const motivo = h.motivoConsulta || 'Sin motivo';
            const idx = i;
            // Integridad clínica: una hoja cuya cita está 'atendida' es una consulta FINALIZADA.
            const finalizada = (h.citaEstado || '').toLowerCase() === 'atendida';
            const bloqueoTitle = finalizada ? 'Consulta finalizada — no se puede modificar' : '';

            html += `
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="#hoja${h.id}"
                            onclick="cargarDetallesHoja('${h.id}', ${idx})">
                        <div class="d-flex w-100 justify-content-between align-items-center me-3">
                            <span><i class="bi bi-calendar-event me-2 text-primary"></i><strong>${fecha}</strong></span>
                            <span class="badge bg-light text-dark ms-3">${escapeHtml(doctor)}</span>
                            ${finalizada ? '<span class="badge bg-secondary ms-2" title="Esta consulta ya fue finalizada. Su contenido está protegido contra edición."><i class="bi bi-lock-fill me-1"></i>Consulta finalizada</span>' : ''}
                        </div>
                    </button>
                </h2>
                <div id="hoja${h.id}" class="accordion-collapse collapse" data-bs-parent="#accordionHojas">
                    <div class="accordion-body">
                        ${finalizada ? '<div class="alert alert-secondary py-2 px-3 mb-2 d-flex align-items-center"><i class="bi bi-shield-lock-fill me-2"></i><small><strong>Consulta finalizada.</strong> El contenido clínico de esta hoja está protegido. Solo puede imprimir Receta, Epicrisis o emitir Constancia.</small></div>' : ''}
                        <div class="mb-2">
                            <small class="text-muted">Motivo:</small>
                            <p class="mb-2">${escapeHtml(motivo)}</p>
                            ${h.notasConsulta ? '<small class="text-muted">Notas:</small><p class="mb-2">' + escapeHtml(h.notasConsulta) + '</p>' : ''}
                        </div>
                        <hr class="my-2">
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-outline-primary btn-sm" onclick="abrirModalDiagnostico('${h.id}')" ${finalizada ? 'disabled title="' + bloqueoTitle + '"' : ''}>
                                <i class="bi bi-heart-pulse me-1"></i> + Diagnóstico
                            </button>
                            <button class="btn btn-outline-success btn-sm" onclick="abrirModalTratamiento('${h.id}')" ${finalizada ? 'disabled title="' + bloqueoTitle + '"' : ''}>
                                <i class="bi bi-capsule me-1"></i> + Tratamiento
                            </button>
                            <button class="btn btn-outline-warning btn-sm" onclick="abrirModalCirugia('${h.id}')" ${finalizada ? 'disabled title="' + bloqueoTitle + '"' : ''}>
                                <i class="bi bi-hospital me-1"></i> + Cirugía
                            </button>
                            <button class="btn btn-outline-info btn-sm" onclick="abrirModalExamen('${h.id}')" ${finalizada ? 'disabled title="' + bloqueoTitle + '"' : ''}>
                                <i class="bi bi-clipboard2-pulse me-1"></i> + Examen
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" onclick="abrirModalRecomendacion('${h.id}')" ${finalizada ? 'disabled title="' + bloqueoTitle + '"' : ''}>
                                <i class="bi bi-chat-quote me-1"></i> + Recomendación
                            </button>
                            <button class="btn btn-outline-dark btn-sm" onclick="abrirModalArchivo('${h.id}')" ${finalizada ? 'disabled title="' + bloqueoTitle + '"' : ''}>
                                <i class="bi bi-paperclip me-1"></i> + Archivo
                            </button>
                            <a href="/Expedientes/Expedientes/ImprimirReceta?hojaCitaId=${h.id}" target="_blank" class="btn btn-outline-dark btn-sm" title="Imprimir receta médica">
                                <i class="bi bi-printer me-1"></i> Receta
                            </a>
                            <a href="/Expedientes/Expedientes/ImprimirEpicrisis?hojaCitaId=${h.id}" target="_blank" class="btn btn-outline-primary btn-sm" title="Imprimir epicrisis">
                                <i class="bi bi-file-medical me-1"></i> Epicrisis
                            </a>
                            <button class="btn btn-outline-success btn-sm" onclick="abrirModalConstancia('${h.id}', '${h.doctorId || ''}', '${h.doctorNombre || ''}')" title="Emitir constancia para esta consulta">
                                <i class="bi bi-clipboard2-plus me-1"></i> + Constancia
                            </button>
                            <button class="btn btn-outline-danger btn-sm" onclick="abrirModalSignosVitales('${h.id}')" title="Registrar signos vitales de esta consulta" ${finalizada ? 'disabled title="' + bloqueoTitle + '"' : ''}>
                                <i class="bi bi-activity me-1"></i> + Signos Vitales
                            </button>
                            <button class="btn btn-outline-info btn-sm" onclick="abrirModalAntecedentes('${h.id}')" title="Registrar antecedentes del paciente para esta especialidad" ${finalizada ? 'disabled title="' + bloqueoTitle + '"' : ''}>
                                <i class="bi bi-journal-medical me-1"></i> + Antecedentes
                            </button>
                        </div>
                        <hr class="my-2">
                        <!-- Sub-contenedores de detalles -->
                        <div id="signosVitales_${h.id}">
                            <div class="d-flex justify-content-center p-2"><div class="spinner-border spinner-border-sm text-danger"></div></div>
                        </div>
                        <div id="antecedentes_${h.id}">
                            <div class="d-flex justify-content-center p-2"><div class="spinner-border spinner-border-sm text-info"></div></div>
                        </div>
                        <div id="diagnosticos_${h.id}">
                            <div class="d-flex justify-content-center p-2"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                        </div>
                        <div id="tratamientos_${h.id}">
                            <div class="d-flex justify-content-center p-2"><div class="spinner-border spinner-border-sm text-success"></div></div>
                        </div>
                        <div id="cirugias_${h.id}">
                            <div class="d-flex justify-content-center p-2"><div class="spinner-border spinner-border-sm text-warning"></div></div>
                        </div>
                        <div id="examenes_${h.id}">
                            <div class="d-flex justify-content-center p-2"><div class="spinner-border spinner-border-sm text-info"></div></div>
                        </div>
                        <div id="recomendaciones_${h.id}">
                            <div class="d-flex justify-content-center p-2"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
                        </div>
                        <div id="archivos_${h.id}">
                            <div class="d-flex justify-content-center p-2"><div class="spinner-border spinner-border-sm text-dark"></div></div>
                        </div>
                    </div>
                </div>
            </div>`;
        }
        html += '</div>';
        document.getElementById('hojasCitaContainer').innerHTML = html;
    }

    // ========== CARGAR DETALLES DE HOJA (diagnósticos, tratamientos, etc.) ==========
    async function cargarDetallesHoja(hojaCitaId, idx) {
        // Cargar signos vitales, antecedentes, diagnósticos, tratamientos, etc.
        await Promise.all([
            cargarSignosVitales(hojaCitaId),
            cargarAntecedentes(hojaCitaId),
            cargarDiagnosticos(hojaCitaId),
            cargarTratamientos(hojaCitaId),
            cargarCirugias(hojaCitaId),
            cargarExamenes(hojaCitaId),
            cargarRecomendaciones(hojaCitaId),
            cargarArchivosHoja(hojaCitaId)
        ]);
    }

    // ========== SIGNOS VITALES (HU-E06) ==========
    async function cargarSignosVitales(hojaCitaId) {
        try {
            const res = await fetch(`${URLS.signosVitalesHoja}?hojaCitaId=${hojaCitaId}`);
            const json = await res.json();
            const data = json.success ? (json.data || []) : [];
            const container = document.getElementById('signosVitales_' + hojaCitaId);
            if (data.length === 0) {
                container.innerHTML = '<div class="text-muted small"><i class="bi bi-info-circle me-1"></i>Sin signos vitales registrados en esta consulta.</div>';
            } else {
                const badges = data.map(s => {
                    const fuera = s.fueraDeRango
                        ? ' <span class="badge bg-warning text-dark">fuera de rango</span>'
                        : '';
                    return `<span class="badge bg-light text-dark border me-2 mb-1">${escapeHtml(s.tipoSignoVitalNombre || '')}: <strong>${escapeHtml(s.valor)} ${escapeHtml(s.unidad || '')}</strong>${fuera}</span>`;
                }).join('');
                container.innerHTML = '<strong class="small text-danger">Signos Vitales:</strong><div class="ms-2 mt-1">' + badges + '</div>';
            }
        } catch (err) {
            document.getElementById('signosVitales_' + hojaCitaId).innerHTML = '<div class="text-danger small">Error al cargar signos vitales.</div>';
        }
    }

    // ========== ANTECEDENTES (HU-E05) ==========
    async function cargarAntecedentes(hojaCitaId) {
        try {
            // Resolver la sala de la hoja para cargar antecedentes por especialidad
            const salaRes = await fetch(`${URLS.salaDeHoja}?hojaCitaId=${hojaCitaId}`);
            const salaJson = await salaRes.json();
            if (!salaJson.success || !salaJson.salaId) {
                document.getElementById('antecedentes_' + hojaCitaId).innerHTML = '<div class="text-muted small"><i class="bi bi-info-circle me-1"></i>Sin sala asociada — no se pueden mostrar antecedentes.</div>';
                return;
            }
            const res = await fetch(`${URLS.antecedentes}?expedienteId=${EXPEDIENTE_ID}&salaId=${salaJson.salaId}`);
            const json = await res.json();
            const data = json.success ? (json.data || []) : [];
            const container = document.getElementById('antecedentes_' + hojaCitaId);
            if (data.length === 0) {
                container.innerHTML = '<div class="text-muted small"><i class="bi bi-info-circle me-1"></i>Sin antecedentes registrados para esta especialidad.</div>';
            } else {
                const items = data.map(a => {
                    let valorTxt = a.valor;
                    if (a.tipoAntecedenteTipoDato === 'boolean') {
                        valorTxt = (a.valor === 'true' || a.valor === 'True') ? 'Sí' : 'No';
                    }
                    return `<div class="small ms-2"><i class="bi bi-dot me-1"></i><strong>${escapeHtml(a.tipoAntecedenteNombre || '')}:</strong> ${escapeHtml(valorTxt)}</div>`;
                }).join('');
                container.innerHTML = '<strong class="small text-info">Antecedentes:</strong>' + items;
            }
        } catch (err) {
            document.getElementById('antecedentes_' + hojaCitaId).innerHTML = '<div class="text-danger small">Error al cargar antecedentes.</div>';
        }
    }

    async function cargarDiagnosticos(hojaCitaId) {
        try {
            const res = await fetch(`${URLS.diagnosticos}?hojaCitaId=${hojaCitaId}`);
            const json = await res.json();
            const data = json.success ? (json.data || []) : [];
            const container = document.getElementById('diagnosticos_' + hojaCitaId);
            if (data.length === 0) {
                container.innerHTML = '<div class="text-muted small"><i class="bi bi-info-circle me-1"></i>Sin diagnósticos registrados.</div>';
            } else {
                container.innerHTML = '<strong class="small text-primary">Diagnósticos:</strong>' +
                    data.map(d => `<div class="small ms-2"><i class="bi bi-dot me-1"></i>${escapeHtml(d.diagnosticoNombre || '')} ${d.observaciones ? '- ' + escapeHtml(d.observaciones) : ''}</div>`).join('');
            }
        } catch (err) {
            document.getElementById('diagnosticos_' + hojaCitaId).innerHTML = '<div class="text-danger small">Error al cargar diagnósticos.</div>';
        }
    }

    async function cargarTratamientos(hojaCitaId) {
        try {
            const res = await fetch(`${URLS.tratamientos}?hojaCitaId=${hojaCitaId}`);
            const json = await res.json();
            const data = json.success ? (json.data || []) : [];
