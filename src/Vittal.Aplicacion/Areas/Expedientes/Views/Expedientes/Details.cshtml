                        const dosis = t.dosis ? '- ' + t.dosis : '';
                        const freq = t.frecuencia ? ', ' + t.frecuencia : '';
                        const dur = t.duracion ? ', ' + t.duracion : '';
                        return `<div class="small ms-2"><i class="bi bi-dot me-1"></i>${escapeHtml(nombre)} ${escapeHtml(dosis)}${escapeHtml(freq)}${escapeHtml(dur)}</div>`;
