    function renderArchivos(archivos) {
        if (archivos.length === 0) {
            document.getElementById('archivosContainer').innerHTML = `
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-file-earmark-x fs-1 d-block mb-2"></i>
                    No hay archivos adjuntos.
                    <br><button class="btn btn-sm btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#modalSubirArchivo">
                        <i class="bi bi-upload me-1"></i>Subir archivo
                    </button>
                </div>`;
            return;
        }

        const items = archivos.map(a => {
            const icono = a.tipoMime?.includes('pdf') ? 'bi-filetype-pdf text-danger' :
                          a.tipoMime?.includes('image') ? 'bi-filetype-jpg text-info' :
                          'bi-file-earmark text-muted';
            const tamanoStr = a.tamanoBytes ? formatBytes(a.tamanoBytes) : '';
            return `
            <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                <div>
                    <i class="bi ${icono} me-2 fs-5"></i>
                    <strong>${escapeHtml(a.nombreArchivo || '')}</strong>
                    ${tamanoStr ? '<br><small class="text-muted">' + tamanoStr + '</small>' : ''}
                </div>
                <div>
                    ${a.urlPublica ? `<a href="${escapeHtml(a.urlPublica)}" target="_blank" class="btn btn-sm btn-outline-primary me-1" title="Ver archivo"><i class="bi bi-eye"></i></a>` : ''}
                </div>
            </div>`;
        }).join('');

        document.getElementById('archivosContainer').innerHTML = `
            <div class="d-flex justify-content-between mb-2">
                <span></span>
                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalSubirArchivo">
                    <i class="bi bi-upload me-1"></i> Subir Archivo
                </button>
            </div>
            <div class="list-group">${items}</div>`;
    }

