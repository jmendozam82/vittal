    // ========== CARGAR ARCHIVOS POR HOJA DE CITA ==========
    async function cargarArchivosHoja(hojaCitaId) {
        const container = document.getElementById('archivos_' + hojaCitaId);
        if (!container) return;
        try {
            const res = await fetch(`${URLS.archivos}?hojaCitaId=${hojaCitaId}`, {
                headers: { 'Content-Type': 'application/json' }
            });
            if (!res.ok) {
                container.innerHTML = '<div class="text-danger small">Error al cargar archivos.</div>';
                return;
            }
            const json = await res.json();
            const data = json.success ? (json.data || []) : [];
            if (data.length === 0) {
                container.innerHTML = '<div class="text-muted small"><i class="bi bi-info-circle me-1"></i>Sin archivos adjuntos.</div>';
            } else {
                container.innerHTML = '<strong class="small text-dark"><i class="bi bi-paperclip me-1"></i>Archivos:</strong>' +
                    data.map(a => {
                        const icono = a.tipoMime?.includes('pdf') ? 'bi-filetype-pdf text-danger' :
                                      a.tipoMime?.includes('image') ? 'bi-filetype-jpg text-info' :
                                      'bi-file-earmark text-muted';
                        const tamanoStr = a.tamanoBytes ? formatBytes(a.tamanoBytes) : '';
                        return `<div class="d-flex justify-content-between align-items-center small ms-2 py-1 border-bottom">
                            <div>
                                <i class="bi ${icono} me-1"></i>
                                <span>${escapeHtml(a.nombreArchivo || '')}</span>
                                ${tamanoStr ? '<small class="text-muted ms-1">(' + tamanoStr + ')</small>' : ''}
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-primary py-0 px-1" onclick="descargarArchivo('${a.id}')" title="Descargar">
                                    <i class="bi bi-download"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger py-0 px-1" onclick="eliminarArchivo('${a.id}', '${hojaCitaId}')" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>`;
                    }).join('');
            }
        } catch (err) {
            container.innerHTML = '<div class="text-danger small">Error de conexión.</div>';
        }
    }

