@{
    ViewData["Title"] = "Gestión de Expedientes";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/'>Inicio</a></li>" +
                             "<li class='breadcrumb-item active'>Expedientes</li>";

    var jsonExpedientesUrl = Url.Action("JsonExpedientes");
    var crearExpedienteUrl = Url.Action("Create");
}

@section HeaderActions {
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Expediente
    </a>
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <!-- Buscador -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           id="buscarExpediente"
                           class="form-control"
                           placeholder="Buscar por paciente o doctor..."
                           autocomplete="off" />
                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="btnLimpiarBusqueda"
                            style="display: none;"
                            title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-6 d-flex align-items-center justify-content-end mt-2 mt-md-0">
                <small class="text-muted" id="contadorResultados"></small>
            </div>
        </div>

        <!-- Tabla de datos -->
        <div id="tablaContainer">
            <div class="d-flex justify-content-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación de desactivar -->
<div class="modal fade" id="modalDesactivar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                    Confirmar desactivación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    ¿Está seguro que desea desactivar el expediente de
                    <strong id="nombrePacienteDesactivar"></strong>?
                    <br><small class="text-muted">
                        El registro no será eliminado, solo quedará inactivo.
                    </small>
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn btn-warning btn-sm text-white" id="btnConfirmarDesactivar">
                    <i class="bi bi-slash-circle me-1"></i> Desactivar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const URLS = {
        listar: '@jsonExpedientesUrl',
        crear: '@crearExpedienteUrl',
        desactivar: '@Url.Action("JsonDesactivar")'
    };

    let expedientes = [];
    let idSeleccionado = null;
    let terminoBusqueda = '';
    let debounceTimer = null;
    const modalDesactivar = new bootstrap.Modal(document.getElementById('modalDesactivar'));

    document.addEventListener('DOMContentLoaded', function() {
        cargarExpedientes();
        inicializarBuscador();
    });

    function inicializarBuscador() {
        const input = document.getElementById('buscarExpediente');
        const btnLimpiar = document.getElementById('btnLimpiarBusqueda');
        if (!input) return;

        input.addEventListener('input', function() {
            const valor = this.value.trim();
            btnLimpiar.style.display = valor ? 'inline-block' : 'none';

            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function() {
                terminoBusqueda = valor.toLowerCase();
                renderTabla(expedientes);
            }, 300);
        });

        btnLimpiar.addEventListener('click', function() {
            input.value = '';
            this.style.display = 'none';
            terminoBusqueda = '';
            renderTabla(expedientes);
            input.focus();
        });
    }

    async function cargarExpedientes() {
        try {
            const res = await fetch(URLS.listar, {
                headers: { 'Content-Type': 'application/json' }
            });

            if (!res.ok) {
                mostrarError('No se pudo conectar con el servidor.');
                return;
            }

            const json = await res.json();

            if (!json.success) {
                mostrarError(json.message || 'Error al cargar los expedientes.');
                return;
            }

            expedientes = json.data || [];
            renderTabla(expedientes);
        } catch (err) {
            mostrarError('Error de conexión. Verifique su red e intente nuevamente.');
        }
    }

    function mostrarError(mensaje) {
        document.getElementById('tablaContainer').innerHTML = `
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>${escapeHtml(mensaje)}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <div class="text-center mt-3">
                <button class="btn btn-outline-primary btn-sm" onclick="cargarExpedientes()">
                    <i class="bi bi-arrow-clockwise me-1"></i> Reintentar
                </button>
            </div>`;
    }

    function renderTabla(items) {
        const filtrados = terminoBusqueda
            ? items.filter(e => {
                const nombre = (e.pacienteNombre || '').toLowerCase();
                const doctor = (e.doctorNombre || '').toLowerCase();
                return nombre.includes(terminoBusqueda) || doctor.includes(terminoBusqueda);
              })
            : items;

        actualizarContador(filtrados.length, items.length);

        if (filtrados.length === 0) {
            const hayDatos = items.length > 0;
            const mensaje = hayDatos
                ? '<i class="bi bi-search fs-1 d-block mb-2"></i>No se encontraron resultados para la búsqueda.'
                : '<i class="bi bi-inbox fs-1 d-block mb-2"></i>No se encontraron expedientes registrados.';
            const accion = hayDatos
                ? ''
                : '<br><a href="' + URLS.crear + '" class="btn btn-sm btn-primary mt-3"><i class="bi bi-plus-lg me-1"></i>Crear primer expediente</a>';

            document.getElementById('tablaContainer').innerHTML = `
                <div class="text-center py-5 text-muted">
                    ${mensaje}
                    ${accion}
                </div>`;
            return;
        }

        const filas = filtrados.map(e => {
            const pacienteNombre = e.pacienteNombre || 'Sin nombre';
            const doctorNombre = e.doctorNombre || 'Sin asignar';
            const fechaCreacion = e.fechaCreacion ? new Date(e.fechaCreacion).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
            const estadoBadge = e.activo
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Inactivo</span>';

            const rowClass = e.activo ? '' : 'opacity-75';

            return `
            <tr class="${rowClass}">
                <td>
                    <strong>${escapeHtml(pacienteNombre)}</strong>
                </td>
                <td class="text-muted">${escapeHtml(doctorNombre)}</td>
                <td class="text-muted">${fechaCreacion}</td>
                <td class="text-center">${estadoBadge}</td>
                <td class="text-end">
                    <a href="/Expedientes/Expedientes/Details/${e.id}"
                       class="btn btn-outline-info btn-sm me-1" title="Ver detalle">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a href="/Expedientes/Expedientes/Edit/${e.id}"
                       class="btn btn-outline-primary btn-sm me-1" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </a>
                    ${e.activo ? `
                    <button class="btn btn-outline-warning btn-sm"
                            onclick="confirmarDesactivar('${e.id}', '${escapeHtml(pacienteNombre)}')"
                            title="Desactivar">
                        <i class="bi bi-slash-circle"></i>
                    </button>` : ''}
                </td>
            </tr>`;
        }).join('');

        document.getElementById('tablaContainer').innerHTML = `
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Paciente</th>
                            <th>Doctor Asignado</th>
                            <th>Fecha Creación</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>${filas}</tbody>
                </table>
            </div>`;
    }

    function actualizarContador(mostrados, total) {
        const el = document.getElementById('contadorResultados');
        if (!el) return;
        if (terminoBusqueda) {
            el.textContent = mostrados + ' de ' + total + ' expedientes encontrados';
        } else {
            el.textContent = total > 0 ? total + ' expedientes' : '';
        }
    }

    function confirmarDesactivar(id, nombre) {
        idSeleccionado = id;
        document.getElementById('nombrePacienteDesactivar').textContent = nombre;
        modalDesactivar.show();
    }

    document.getElementById('btnConfirmarDesactivar').addEventListener('click', async () => {
        if (!idSeleccionado) return;

        const btn = document.getElementById('btnConfirmarDesactivar');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Desactivando...';

        try {
            const res = await fetch(`${URLS.desactivar}?id=${idSeleccionado}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' }
            });

            const json = await res.json();

            if (res.ok && json.success) {
                showToast(json.message || 'Expediente desactivado exitosamente.', 'success');
                await cargarExpedientes();
            } else {
                showToast(json.message || 'Error al desactivar el expediente.', 'danger');
            }
        } catch (err) {
            showToast('Error de conexión al desactivar.', 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-slash-circle me-1"></i> Desactivar';
            modalDesactivar.hide();
            idSeleccionado = null;
        }
    });

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function showToast(message, type) {
        const container = document.getElementById('toastContainer') || createToastContainer();
        const toast = document.createElement('div');
        toast.className = `alert alert-${type} alert-dismissible fade show shadow-sm`;
        toast.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;min-width:320px;max-width:450px;';
        toast.innerHTML = `${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 5000);
    }

    function createToastContainer() {
        const div = document.createElement('div');
        div.id = 'toastContainer';
        document.body.appendChild(div);
        return div;
    }
</script>
}
