@{
    ViewData["Title"] = "Nuevo Expediente";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/'>Inicio</a></li>" +
                             "<li class='breadcrumb-item'><a href='/Expedientes/Expedientes'>Expedientes</a></li>" +
                             "<li class='breadcrumb-item active'>Nuevo Expediente</li>";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-folder-plus me-2 text-primary"></i>Crear Nuevo Expediente
        </h5>
    </div>
    <div class="card-body">
        <form id="formExpediente" novalidate>
            <!-- Datos del expediente -->
            <h6 class="text-primary border-bottom pb-2 mb-3">
                <i class="bi bi-person-vcard me-2"></i>Seleccionar Paciente
            </h6>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="busquedaPaciente" class="form-label fw-semibold">Buscar Paciente <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="busquedaPaciente"
                           placeholder="Escriba para buscar paciente..."
                           autocomplete="off" />
                    <div class="invalid-feedback">Debe seleccionar un paciente.</div>
                    <input type="hidden" id="pacienteId" name="pacienteId" />
                    <div id="pacienteSeleccionado" class="mt-2" style="display:none;">
                        <div class="alert alert-info py-2 px-3 mb-0">
                            <i class="bi bi-person-check me-1"></i>
                            <span id="nombrePacienteSeleccionado"></span>
                            <button type="button" class="btn-close float-end" id="btnLimpiarPaciente" aria-label="Limpiar"></button>
                        </div>
                    </div>
                    <div id="resultadosBusqueda" class="list-group mt-1" style="display:none; position:absolute; z-index:1000; max-height:200px; overflow-y:auto;"></div>
                </div>
                <div class="col-md-6">
                    <label for="doctorId" class="form-label fw-semibold">Doctor Asignado <span class="text-danger">*</span></label>
                    <select class="form-select" id="doctorId" name="doctorId" required>
                        <option value="">-- Seleccione un doctor --</option>
                    </select>
                    <div class="invalid-feedback">Debe asignar un doctor.</div>
                </div>
            </div>

            <!-- Notas generales -->
            <h6 class="text-primary border-bottom pb-2 mb-3 mt-4">
                <i class="bi bi-journal-text me-2"></i>Notas del Expediente
            </h6>

            <div class="row g-3 mb-3">
                <div class="col-md-12">
                    <textarea class="form-control" id="notasGenerales" name="notasGenerales"
                              rows="3" placeholder="Notas generales del expediente (opcional)"></textarea>
                </div>
            </div>

            <!-- Botones -->
            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a href="/Expedientes/Expedientes" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-primary" id="btnGuardar">
                    <i class="bi bi-floppy me-1"></i> Crear Expediente
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    let pacientes = [];
    let debounceTimer = null;

    document.addEventListener('DOMContentLoaded', function() {
        cargarDoctores();
        inicializarBuscadorPacientes();
    });

    async function cargarDoctores() {
        try {
            const res = await fetch('@Url.Action("JsonDoctores")', {
                headers: { 'Content-Type': 'application/json' }
            });
            if (!res.ok) return;
            const json = await res.json();
            if (json.success && json.data) {
                const select = document.getElementById('doctorId');
                json.data.forEach(d => {
                    const op = document.createElement('option');
                    op.value = d.id || d.usuarioId || '';
                    op.textContent = d.nombreCompleto || d.nombres + ' ' + d.apellidos || 'Sin nombre';
                    select.appendChild(op);
                });
            }
        } catch (err) {
            console.error('Error al cargar doctores:', err);
        }
    }

    function inicializarBuscadorPacientes() {
        const input = document.getElementById('busquedaPaciente');
        const resultados = document.getElementById('resultadosBusqueda');

        input.addEventListener('input', function() {
            const valor = this.value.trim();
            clearTimeout(debounceTimer);

            if (valor.length < 2) {
                resultados.style.display = 'none';
                return;
            }

            debounceTimer = setTimeout(async () => {
                try {
                    const res = await fetch('@Url.Action("JsonBuscarPacientes")?q=' + encodeURIComponent(valor), {
                        headers: { 'Content-Type': 'application/json' }
                    });
                    if (!res.ok) return;
                    const json = await res.json();
                    if (json.success && json.data) {
                        pacientes = json.data;
                        mostrarResultados(pacientes);
                    }
                } catch (err) {
                    console.error('Error al buscar pacientes:', err);
                }
            }, 300);
        });

        // Cerrar resultados al hacer clic fuera
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#busquedaPaciente') && !e.target.closest('#resultadosBusqueda')) {
                resultados.style.display = 'none';
            }
        });
    }

    function mostrarResultados(items) {
        const resultados = document.getElementById('resultadosBusqueda');
        resultados.innerHTML = '';
        resultados.style.display = 'block';

        if (items.length === 0) {
            resultados.innerHTML = '<div class="list-group-item text-muted small">No se encontraron pacientes</div>';
            return;
        }

        items.forEach(p => {
            const nombre = p.nombreCompleto || (p.primerNombre || '') + ' ' + (p.primerApellido || '');
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action py-2';
            item.innerHTML = `<strong>${escapeHtml(nombre)}</strong><br><small class="text-muted">${p.email || ''} ${p.celular ? '| ' + p.celular : ''}</small>`;
            item.addEventListener('click', function() {
                seleccionarPaciente(p.id, nombre);
            });
            resultados.appendChild(item);
        });
    }

    function seleccionarPaciente(id, nombre) {
        document.getElementById('pacienteId').value = id;
        document.getElementById('nombrePacienteSeleccionado').textContent = nombre;
        document.getElementById('pacienteSeleccionado').style.display = 'block';
        document.getElementById('busquedaPaciente').style.display = 'none';
        document.getElementById('resultadosBusqueda').style.display = 'none';
    }

    document.getElementById('btnLimpiarPaciente').addEventListener('click', function() {
        document.getElementById('pacienteId').value = '';
        document.getElementById('pacienteSeleccionado').style.display = 'none';
        document.getElementById('busquedaPaciente').style.display = 'block';
        document.getElementById('busquedaPaciente').value = '';
        document.getElementById('busquedaPaciente').focus();
    });

    // Submit del formulario
    document.getElementById('formExpediente').addEventListener('submit', async function(e) {
        e.preventDefault();

        const form = this;
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return;
        }

        const pacienteId = document.getElementById('pacienteId').value;
        if (!pacienteId) {
            showToast('danger', 'Debe seleccionar un paciente.');
            return;
        }

        const btn = document.getElementById('btnGuardar');
        const textoOriginal = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';

        const data = {
            pacienteId: pacienteId,
            doctorId: document.getElementById('doctorId').value,
            notasGenerales: document.getElementById('notasGenerales').value.trim() || null
        };

        try {
            const res = await fetch('@Url.Action("JsonCrear")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const json = await res.json();

            if (res.ok && json.success) {
                showToast(json.message || 'Expediente creado exitosamente.', 'success');
                setTimeout(() => {
                    window.location.href = '/Expedientes/Expedientes';
                }, 1000);
            } else {
                showToast(json.message || 'Error al crear el expediente.', 'danger');
                btn.disabled = false;
                btn.innerHTML = textoOriginal;
            }
        } catch (err) {
            showToast('Error de conexión al guardar.', 'danger');
            btn.disabled = false;
            btn.innerHTML = textoOriginal;
        }
    });

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function showToast(type, message) {
        const container = document.getElementById('toastContainer') || createToastContainer();
        const toast = document.createElement('div');
        toast.className = `alert alert-${type} alert-dismissible fade show shadow-sm`;
        toast.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;min-width:320px;max-width:450px;';
        toast.innerHTML = `${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 5000);
    }

    function createToastContainer() {
        const div = document.createElement('div');
        div.id = 'toastContainer';
        document.body.appendChild(div);
        return div;
    }
</script>
}
