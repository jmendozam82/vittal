@{
    ViewData["Title"] = "Panel Principal";

    // Helper para verificar si el usuario puede ver un módulo
    bool PuedeVer(string clave)
    {
        if (ViewBag.EsAdmin == true) return true;
        var modulos = ViewBag.ModulosPermitidos as System.Collections.Generic.HashSet<string>;
        return modulos?.Contains(clave) == true;
    }

    // Contar módulos visibles por sección para decidir si mostrar el card
    var adminModulos = new[] { "perfiles", "usuarios", "permisos", "salas" };
    var catalogosModulos = new[] { "pacientes", "medicamentos", "clinicas", "tipos_cirugia", "cirugias",
                                   "tipos_dx", "diagnosticos", "tratamientos", "recomendaciones", "examenes" };
    bool hayAdmin = adminModulos.Any(PuedeVer);
    bool hayCatalogos = catalogosModulos.Any(PuedeVer);
}

@section HeaderActions {
    <small class="text-muted">
        <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
    </small>
}

<!-- Bienvenida -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card bg-primary text-white border-0 shadow-sm">
            <div class="card-body py-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <i class="bi bi-heart-pulse" style="font-size: 2.5rem;"></i>
                        </div>
                        <div>
                            <h4 class="mb-1">Bienvenido al Sistema Vittal</h4>
                            <p class="mb-0 opacity-75">Sistema de gestion de citas y expedientes medicos</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modulos disponibles -->
<h5 class="mb-3">
    <i class="bi bi-grid-3x3-gap-fill me-2"></i>Modulos del Sistema
</h5>

<div class="row g-3 mb-4">
    @if (hayAdmin)
    {
    <!-- Administracion -->
    <div class="col-12">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0">
                    <i class="bi bi-gear-wide-connected text-primary me-2"></i>Administracion
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="row g-0">
                    @if (PuedeVer("perfiles"))
                    {
                    <!-- Perfiles -->
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/Administracion/Perfil" class="module-card d-block p-3 text-decoration-none text-dark">
                            <div class="d-flex align-items-center mb-2">
                                <div class="module-icon bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-2">
                                    <i class="bi bi-person-badge"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold small">Perfiles</div>
                                    <span class="badge bg-success" style="font-size: 0.65rem;">Activo</span>
                                </div>
                            </div>
                            <div class="text-muted small">Gestion de perfiles y roles del sistema</div>
                        </a>
                    </div>
                    }

                    @if (PuedeVer("usuarios"))
                    {
                    <!-- Usuarios -->
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/Administracion/Usuario" class="module-card d-block p-3 text-decoration-none text-dark">
                            <div class="d-flex align-items-center mb-2">
                                <div class="module-icon bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-2">
                                    <i class="bi bi-people"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold small">Usuarios</div>
                                    <span class="badge bg-success" style="font-size: 0.65rem;">Activo</span>
                                </div>
                            </div>
                            <div class="text-muted small">Gestion de usuarios del sistema</div>
                        </a>
                    </div>
                    }

                    @if (PuedeVer("permisos"))
                    {
                    <!-- Permisos -->
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/Administracion/Permiso" class="module-card d-block p-3 text-decoration-none text-dark">
                            <div class="d-flex align-items-center mb-2">
                                <div class="module-icon bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-2">
                                    <i class="bi bi-key"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold small">Permisos</div>
                                    <span class="badge bg-success" style="font-size: 0.65rem;">Activo</span>
                                </div>
                            </div>
                            <div class="text-muted small">Configuracion de permisos por modulo</div>
                        </a>
                    </div>
                    }

                    @if (PuedeVer("salas"))
                    {
                    <!-- Asignar Salas -->
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/Administracion/Sala" class="module-card d-block p-3 text-decoration-none text-dark">
                            <div class="d-flex align-items-center mb-2">
                                <div class="module-icon bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-2">
                                    <i class="bi bi-door-open"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold small">Asignar Salas</div>
                                    <span class="badge bg-success" style="font-size: 0.65rem;">Activo</span>
                                </div>
                            </div>
                            <div class="text-muted small">Asignacion de salas y areas medicas</div>
                        </a>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
    }
</div>

