@{
    ViewData["Title"] = "Panel Principal";
}

@section HeaderActions {
    <small class="text-muted">
        <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
    </small>
}

<!-- Bienvenida -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card bg-primary text-white border-0 shadow-sm">
            <div class="card-body py-5">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-4">
                            <i class="bi bi-heart-pulse" style="font-size: 3rem;"></i>
                        </div>
                        <div>
                            <h3 class="mb-1 fw-bold">Bienvenido al Sistema Vittal</h3>
                            <p class="mb-0 opacity-75 fs-6">Sistema de gestión de citas y expedientes médicos</p>
                            <p class="mb-0 mt-2 small opacity-50">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                                &nbsp;·&nbsp;
                                <i class="bi bi-layers me-1"></i>Utilice el menú lateral para navegar entre los módulos
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick stats row -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-4">
                <div class="display-6 text-primary mb-2"><i class="bi bi-people"></i></div>
                <div class="small text-muted">Pacientes</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-4">
                <div class="display-6 text-success mb-2"><i class="bi bi-calendar-check"></i></div>
                <div class="small text-muted">Citas</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-4">
                <div class="display-6 text-warning mb-2"><i class="bi bi-clock-history"></i></div>
                <div class="small text-muted">Cola de Espera</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-4">
                <div class="display-6 text-info mb-2"><i class="bi bi-folder-medical"></i></div>
                <div class="small text-muted">Expedientes</div>
            </div>
        </div>
    </div>
</div>

<!-- Footer hint -->
<div class="row">
    <div class="col-12 text-center">
        <p class="text-muted small mb-0">
            <i class="bi bi-arrow-left me-1"></i>
            Seleccione un módulo en el menú lateral para comenzar
        </p>
    </div>
</div>
