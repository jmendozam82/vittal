@if (ViewBag.EsAdmin == true)
{
<!-- Proximamente: modulos avanzados (solo visible para admin) -->
<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-4">
                <div class="row g-2">
                    <div class="col-md-8">
                        <h6 class="text-muted mb-2">
                            <i class="bi bi-cone-striped me-2"></i>Modulos en construccion
                        </h6>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">Agenda</span>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">Cola de Espera</span>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">Expedientes</span>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">Linea de Tiempo</span>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">Dashboard</span>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">Reportes</span>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">Alertas</span>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end text-muted small align-self-center">
                        <i class="bi bi-info-circle me-1"></i>BD lista, codigo en desarrollo
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<style>
    /* Module card hover effects */
    .module-card {
        transition: all 0.2s ease-in-out;
        border-radius: 0.5rem;
    }

    .module-card:hover {
        background-color: #f8f9fa;
        transform: translateY(-2px);
        box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.08);
    }

    .module-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    /* Disabled module card */
    .text-muted .module-card {
        cursor: not-allowed;
        opacity: 0.7;
    }

    .text-muted .module-card:hover {
        transform: none;
        box-shadow: none;
        background-color: transparent;
    }

    /* Banner logo watermark */
    .banner-logo {
        max-width: 45px;
        height: auto;
        opacity: 0.15;
        filter: brightness(0) invert(1);
    }
</style>
}
