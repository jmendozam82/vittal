<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>@ViewData["Title"] - Vittal</title>
    <meta name="description" content="@ViewData["MetaDescription"] ?? "Vittal - Software de Gestión Clínica Inteligente"" />
    <meta name="keywords" content="@ViewData["MetaKeywords"] ?? "gestión clínica, software médico, expedientes electrónicos, agenda médica"" />
    <meta name="author" content="Vittal Software" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:title" content="@ViewData["Title"] - Vittal" />
    <meta property="og:description" content="@ViewData["MetaDescription"] ?? "Vittal centraliza la gestión de tu clínica médica en un solo lugar."" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}")" />
    <meta property="og:image" content="~/images/landing/og-vittal.svg" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - Vittal" />
    <meta name="twitter:description" content="@ViewData["MetaDescription"] ?? "Vittal - Gestión Clínica Inteligente"" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/images/favicon-96x96.png" />
    <link rel="shortcut icon" href="~/images/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/apple-touch-icon.png" />
    <link rel="manifest" href="~/images/site.webmanifest" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Vittal Variables + Landing Styles -->
    <link rel="stylesheet" href="~/css/vittal-variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ════════════════════════════════════════════════════════════
         NAVBAR — Fija, con scroll effect
         ════════════════════════════════════════════════════════════ -->
    <nav class="navbar navbar-expand-lg navbar-dark landing-navbar fixed-top" id="landingNavbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/Landing/Landing">
                <img src="~/images/vittal-logo.png"
                     alt="Vittal"
                     class="me-2 landing-logo"
                     height="36"
                     loading="lazy" />
                <span class="fw-bold fs-5">Vittal</span>
            </a>

            <button class="navbar-toggler border-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#landingNav"
                    aria-controls="landingNav" aria-expanded="false"
                    aria-label="Abrir menú de navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="landingNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="/Landing/Landing">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Landing/Landing/Funcionalidades">Funcionalidades</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Landing/Landing/Beneficios">Beneficios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Landing/Landing/Contacto">Contacto</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <a href="/Login/Auth/Login" class="btn btn-outline-light btn-sm px-4 rounded-pill">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- ════════════════════════════════════════════════════════════
         MAIN CONTENT
         ════════════════════════════════════════════════════════════ -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ════════════════════════════════════════════════════════════
         FOOTER
         ════════════════════════════════════════════════════════════ -->
    <footer class="landing-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <img src="~/images/vittal-logo.png"
                             alt="Vittal"
                             height="32"
                             class="me-2"
                             loading="lazy" />
                        <span class="fw-bold fs-5 text-white">Vittal</span>
                    </div>
                    <p class="text-white-50 small mb-3">
                        Software de gestión clínica inteligente. Centraliza citas,
                        expedientes, diagnósticos y más en un solo lugar.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-white-50" aria-label="Facebook"><i class="bi bi-facebook fs-5"></i></a>
                        <a href="#" class="text-white-50" aria-label="Twitter / X"><i class="bi bi-twitter-x fs-5"></i></a>
                        <a href="#" class="text-white-50" aria-label="LinkedIn"><i class="bi bi-linkedin fs-5"></i></a>
                        <a href="#" class="text-white-50" aria-label="Instagram"><i class="bi bi-instagram fs-5"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-semibold mb-3">Enlaces</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="/Landing/Landing" class="footer-link">Inicio</a></li>
                        <li class="mb-2"><a href="/Landing/Landing/Funcionalidades" class="footer-link">Funcionalidades</a></li>
                        <li class="mb-2"><a href="/Landing/Landing/Beneficios" class="footer-link">Beneficios</a></li>
                        <li class="mb-2"><a href="/Landing/Landing/Contacto" class="footer-link">Contacto</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-semibold mb-3">Contacto</h6>
                    <ul class="list-unstyled mb-0 text-white-50 small">
                        <li class="mb-2">
                            <i class="bi bi-envelope me-2"></i>jorgemendozamartinez@gmail.com
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-telephone me-2"></i>+(505) 8920 4755
                        </li>
                        <li>
                            <i class="bi bi-geo-alt me-2"></i>Managua, Nicaragua
                        </li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-semibold mb-3">Legal</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="footer-link">Aviso de Privacidad</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Términos y Condiciones</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-white-10 my-4" />
            <div class="row">
                <div class="col text-center">
                    <small class="text-white-50">
                        &copy; @DateTime.Now.Year - Vittal Software. Todos los derechos reservados.
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <!-- ════════════════════════════════════════════════════════════
         SCRIPTS
         ════════════════════════════════════════════════════════════ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- Landing JS -->
    <script>
        // ── Navbar scroll effect ──────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            const navbar = document.getElementById('landingNavbar');

            window.addEventListener('scroll', function () {
                if (window.scrollY > 50) {
                    navbar.classList.add('navbar-scrolled');
                } else {
                    navbar.classList.remove('navbar-scrolled');
                }
            });

            // ── Smooth scroll for anchor links ────────────────────
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    const href = this.getAttribute('href');
                    if (href === '#') return;
                    e.preventDefault();
                    const target = document.querySelector(href);
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

            // ── Close mobile navbar on link click ─────────────────
            const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
            const navbarCollapse = document.getElementById('landingNav');
            navLinks.forEach(link => {
                link.addEventListener('click', function () {
                    const bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse);
                    if (bsCollapse) bsCollapse.hide();
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
