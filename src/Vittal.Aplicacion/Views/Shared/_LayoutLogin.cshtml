<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vittal</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/vittal-variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vittal.css" asp-append-version="true" />
    
    <style>
        body {
            background: linear-gradient(135deg, var(--vittal-bg) 0%, #e9ecef 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 15px;
        }
        .login-logo {
            text-align: center;
            margin-bottom: 2rem;
        }
        .login-logo h1 {
            color: var(--vittal-primary);
            font-weight: 700;
            letter-spacing: -1px;
        }
        .vittal-card {
            border: none;
            box-shadow: var(--vittal-shadow-lg);
            padding: 2.5rem;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-logo">
            <h1>VITTAL</h1>
            <p class="text-muted">Gestión Clínica Inteligente</p>
        </div>
        
        <main role="main">
            @RenderBody()
        </main>
        
        <div class="text-center mt-4">
            <small class="text-muted">&copy; @DateTime.Now.Year - Vittal Software</small>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
