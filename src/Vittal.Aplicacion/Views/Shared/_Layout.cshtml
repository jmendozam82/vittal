<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="vittal-token" content="@Context.Session?.GetString("AccessToken")" />
    <title>@ViewData["Title"] - Software Vittal</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/images/favicon-96x96.png" />
    <link rel="shortcut icon" href="~/images/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/apple-touch-icon.png" />
    <link rel="manifest" href="~/images/site.webmanifest" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/vittal-variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vittal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vittal-alerts.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        body {
            font-family: var(--vittal-font);
            background: var(--vittal-bg);
            overflow-x: hidden;
        }
        .wrapper {
            display: flex;
            min-height: 100vh;
        }
        .vittal-content {
            flex: 1;
            margin-left: 260px;
            padding: 1.5rem 2rem;
            transition: margin-left 0.3s ease;
        }
        @@media (max-width: 992px) {
            .vittal-content {
                margin-left: 0;
                padding: 1rem;
            }
        }
        .page-header {
            margin-bottom: 1.5rem;
        }
        .page-header h4 {
            font-weight: 700;
            color: var(--vittal-text);
        }
        .breadcrumb {
            background: transparent;
            padding: 0;
            margin: 0;
            font-size: 0.82rem;
        }
        .breadcrumb-item a {
            color: var(--vittal-primary);
            text-decoration: none;
        }
        .breadcrumb-item.active {
            color: var(--vittal-text-muted);
        }
        .btn-vittal-primary {
            background: var(--vittal-primary);
            color: #fff;
            border: none;
        }
        .btn-vittal-primary:hover {
            background: var(--vittal-primary-dark);
            color: #fff;
        }
        .btn-vittal-deactivate {
            background: var(--vittal-warning);
            color: #fff;
            border: none;
        }
        .btn-vittal-deactivate:hover {
            background: #D68910;
            color: #fff;
        }
    </style>
</head>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<body>
    <script>
        @{
            var vittalApiBase = Configuration["VittalApi:BaseUrl"]?.TrimEnd('/') ?? "";
            var vittalApiUrl = string.IsNullOrEmpty(vittalApiBase)
                ? $"{Context.Request.Scheme}://{Context.Request.Host}/api"
                : $"{vittalApiBase}/api";
        }
        window.VITTAL_API_URL = '@vittalApiUrl';
        window.VITTAL_API_HUB_URL = '@vittalApiBase';
        window.VITTAL_CLINICA_ID = '@(Context.Session?.GetString("ClinicaId") ?? "")';
        window.VITTAL_SUPABASE_URL = '@(Configuration["Supabase:Url"] ?? "")';
        window.VITTAL_SUPABASE_ANON_KEY = '@(Configuration["Supabase:AnonKey"] ?? "")';
    </script>

    <div class="wrapper">
        <!-- ── Sidebar (inteligente: filtrado por permisos) ─────────── -->
        @await Component.InvokeAsync("Sidebar")

        <!-- ── Main Content ────────────────────────────────────────── -->
        <main class="vittal-content" id="mainContent">
            <!-- Top Bar -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    @if (ViewData["Title"] != null)
                    {
                        <h4 class="mb-0">@ViewData["Title"]</h4>
                    }
                    @if (ViewData["Breadcrumb"] != null)
                    {
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                @Html.Raw(ViewData["Breadcrumb"])
                            </ol>
                        </nav>
                    }
                </div>
                <div class="d-flex align-items-center gap-3">
                    @await RenderSectionAsync("HeaderActions", required: false)

                    <!-- Notification Bell -->
                    <div class="dropdown">
                        <button class="btn btn-light border position-relative rounded-circle d-flex align-items-center justify-content-center"
                                style="width:40px;height:40px;" type="button"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                aria-expanded="false" title="Notificaciones">
                            <i class="bi bi-bell-fill" style="color:var(--vittal-text-muted);"></i>
                            <span class="navbar-badge d-none" id="notifBadge">0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow notificaciones-dropdown" aria-labelledby="notifDropdown">
                            <div class="dropdown-header-custom">
                                <span class="fw-semibold"><i class="bi bi-bell-fill me-2 text-warning"></i>Notificaciones</span>
                                <span class="d-flex align-items-center gap-2">
                                    <span class="badge bg-danger rounded-pill d-none" id="notifDropdownBadge">0</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" id="btnMarcarTodasLeidas">
                                        <i class="bi bi-check2-all me-1"></i>Todas leídas
                                    </button>
                                </span>
                            </div>
                            <div id="notificacionesLista">
                                <div class="text-center py-4 text-muted small">
                                    <i class="bi bi-bell-slash d-block fs-4 mb-2 opacity-50"></i>
                                    Sin notificaciones
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Toast Container -->
            <div id="vittal-toast-container" class="vittal-toast-container"></div>

            <!-- Alerts from TempData -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Warning"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/vittal-api.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/vittal-alerts.js" asp-append-version="true"></script>
    <script src="~/js/vittal-session.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Notifications dropdown loader
        document.addEventListener('DOMContentLoaded', function () {
            const notifBtn = document.querySelector('[data-bs-toggle="dropdown"][title="Notificaciones"]');
            if (notifBtn) {
                notifBtn.addEventListener('shown.bs.dropdown', function () {
                    cargarNotificacionesDropdown();
                });
            }
        });

        async function cargarNotificacionesDropdown() {
            const lista = document.getElementById('notificacionesLista');
            const badge = document.getElementById('notifDropdownBadge');
            if (!lista) return;

            try {
                const res = await fetch('/Dashboard/Dashboard/JsonUltimasNotificaciones', {
                    method: 'GET',
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });

                // Si la sesión expiró, no intentar parsear
                if (res.redirected || !res.ok) return;

                const json = await res.json();

                if (!json.success || !json.data || json.data.length === 0) {
                    lista.innerHTML =
                        '<div class="text-center py-4 text-muted small"><i class="bi bi-bell-slash d-block fs-4 mb-2 opacity-50"></i>Sin notificaciones</div>';
                    if (badge) badge.classList.add('d-none');
                    return;
                }

                if (badge) {
                    badge.textContent = json.data.length;
                    badge.classList.remove('d-none');
                }

                lista.innerHTML = json.data.map(function (n) {
                    const noLeida = n.leida ? '' : 'no-leida';
                    const icono = n.icono || 'bi-bell';
                    const titulo = n.titulo || 'Notificación';
                    const mensaje = n.mensaje || '';
                    const tiempo = n.tiempoRelativo || '';
                    return '<div class="notif-item ' + noLeida + '" data-id="' + n.id + '" title="Haz clic para marcar como leída">' +
                        '<div class="d-flex align-items-start gap-2">' +
                        '<i class="bi ' + icono + ' text-warning mt-1"></i>' +
                        '<div>' +
                        '<div class="notif-titulo">' + escapeHtml(titulo) + '</div>' +
                        (mensaje ? '<div class="notif-mensaje">' + escapeHtml(mensaje) + '</div>' : '') +
                        (tiempo ? '<div class="notif-tiempo"><i class="bi bi-clock me-1"></i>' + escapeHtml(tiempo) + '</div>' : '') +
                        '</div></div></div>';
                }).join('');

            } catch (err) {
                console.warn('Error cargando notificaciones:', err);
            }
        }

        // ── Marcar una notificación como leída ───────────────────────────
        document.addEventListener('click', function (e) {
            const item = e.target.closest('.notif-item[data-id]');
            if (item) marcarNotificacionLeida(item);

            const btnTodas = e.target.closest('#btnMarcarTodasLeidas');
            if (btnTodas) {
                e.preventDefault();
                marcarTodasLeidas();
            }
        });

        async function marcarNotificacionLeida(item) {
            const id = item.getAttribute('data-id');
            if (!id || item.classList.contains('marcando')) return;

            item.classList.add('marcando-leida');
            try {
                const res = await fetch('/Dashboard/Dashboard/JsonMarcarLeida?id=' + encodeURIComponent(id), {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });
                const json = await res.json();

                if (json.success) {
                    item.classList.remove('no-leida');
                    item.style.transition = 'opacity 0.2s ease';
                    item.style.opacity = '0';
                    setTimeout(function () {
                        item.remove();
                        refrescarBadgeDropdown();
                    }, 200);
                    if (window.VittalAlertas) window.VittalAlertas.actualizarBadge();
                }
            } catch (err) {
                console.warn('Error marcando notificación como leída:', err);
            } finally {
                item.classList.remove('marcando-leida');
            }
        }

        async function marcarTodasLeidas() {
            const lista = document.getElementById('notificacionesLista');
            try {
                const res = await fetch('/Dashboard/Dashboard/JsonMarcarTodasLeidas', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });
                const json = await res.json();

                if (json.success) {
                    if (lista) {
                        lista.innerHTML =
                            '<div class="text-center py-4 text-muted small"><i class="bi bi-bell-slash d-block fs-4 mb-2 opacity-50"></i>Sin notificaciones</div>';
                    }
                    const badge = document.getElementById('notifDropdownBadge');
                    if (badge) badge.classList.add('d-none');
                    if (window.VittalAlertas) window.VittalAlertas.actualizarBadge();
                    VittalAPI.showToast('Todas las notificaciones fueron marcadas como leídas', 'success', 3000);
                }
            } catch (err) {
                console.warn('Error marcando todas como leídas:', err);
            }
        }

        function refrescarBadgeDropdown() {
            const badge = document.getElementById('notifDropdownBadge');
            const items = document.querySelectorAll('#notificacionesLista .notif-item');
            const lista = document.getElementById('notificacionesLista');
            if (!items.length && lista) {
                lista.innerHTML =
                    '<div class="text-center py-4 text-muted small"><i class="bi bi-bell-slash d-block fs-4 mb-2 opacity-50"></i>Sin notificaciones</div>';
            }
            if (badge) {
                const count = items.length || 0;
                if (count > 0) {
                    badge.textContent = count;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
</body>
</html>
