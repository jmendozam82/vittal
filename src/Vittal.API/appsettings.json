// =============================================================================
// Vittal.API — appsettings.json
// IMPORTANTE: Los valores sensibles deben ir en appsettings.Development.json
//             que está en .gitignore y NUNCA se sube al repositorio.
// =============================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Mover a appsettings.Development.json con los valores reales de Supabase
    "Supabase": "REEMPLAZAR_EN_APPSETTINGS_DEVELOPMENT"
  },
  "Supabase": {
    // URL del proyecto Supabase: https://{project-ref}.supabase.co
    "Url": "REEMPLAZAR_EN_APPSETTINGS_DEVELOPMENT",
    // Anon Key (pública): visible en Settings → API → Project API keys
    "AnonKey": "REEMPLAZAR_EN_APPSETTINGS_DEVELOPMENT",
    // Service Role Key (privada — NUNCA exponer en frontend)
    "ServiceRoleKey": "REEMPLAZAR_EN_APPSETTINGS_DEVELOPMENT",
    // JWT Secret: Settings → API → JWT Settings → JWT Secret
    "JwtSecret": "REEMPLAZAR_EN_APPSETTINGS_DEVELOPMENT"
  },
  "Jwt": {
    "Issuer": "https://vajpdvalavyhwxrusmwx.supabase.co/auth/v1",
    "Audience": "authenticated",
    "ValidateLifetime": true
  }
}
